#!/system/bin/sh
# scanap — list nearby APs with channel/freq (uses normal wlan0, not monitor)
iw dev wlan0 scan 2>/dev/null | awk '
/^BSS/ {mac=$2; gsub(/\(.*/, "", mac)}
/freq:/ {freq=$NF}
/signal:/ {sig=$NF" "$2}
/SSID:/ {
  ssid=$0; sub(/.*SSID: /, "", ssid);
  if(ssid=="") ssid="(hidden)";
  ch="?"
  if(freq==2412)ch=1; if(freq==2417)ch=2; if(freq==2422)ch=3;
  if(freq==2427)ch=4; if(freq==2432)ch=5; if(freq==2437)ch=6;
  if(freq==2442)ch=7; if(freq==2447)ch=8; if(freq==2452)ch=9;
  if(freq==2457)ch=10; if(freq==2462)ch=11; if(freq==2467)ch=12;
  if(freq==2472)ch=13; if(freq==2484)ch=14;
  if(freq==5180)ch=36; if(freq==5200)ch=40; if(freq==5220)ch=44;
  if(freq==5240)ch=48; if(freq==5260)ch=52; if(freq==5280)ch=56;
  if(freq==5300)ch=60; if(freq==5320)ch=64; if(freq==5500)ch=100;
  if(freq==5520)ch=104; if(freq==5540)ch=108; if(freq==5560)ch=112;
  if(freq==5580)ch=116; if(freq==5660)ch=132; if(freq==5680)ch=136;
  if(freq==5700)ch=140; if(freq==5745)ch=149; if(freq==5765)ch=153;
  if(freq==5785)ch=157; if(freq==5805)ch=161; if(freq==5825)ch=165;
  printf "%-32s  ch%-3s %4s MHz  %s  %s\n", ssid, ch, freq, sig, mac
}
' | sort -k2 -t'h' -n
echo
echo "用法: monstart <ch> 锁定目标信道后注入"
