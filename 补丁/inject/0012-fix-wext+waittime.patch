@@ -1277,4 +1277,17 @@ void wlan_hdd_save_sta_keep_alive_interval(struct hdd_adapter *adapter,
 enum nl80211_chan_width
 hdd_convert_phy_bw_to_nl_bw(enum phy_ch_width bw);
 
+/**
+ * wlan_hdd_mon_wext_set_freq() - set monitor channel from a wext SIOCSIWFREQ
+ * @wiphy: wiphy handle
+ * @freq_mhz: target channel center frequency in MHz
+ *
+ * NETHUNTER: routes `iwconfig wlan0mon channel/freq` to the monitor
+ * channel-set path. Always defined; returns -EOPNOTSUPP if monitor support
+ * is compiled out.
+ *
+ * Return: 0 on success or negative errno.
+ */
+int wlan_hdd_mon_wext_set_freq(struct wiphy *wiphy, int freq_mhz);
+
 #endif
