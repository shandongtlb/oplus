+/*
+ * NETHUNTER: wext SIOCSIWFREQ entry for wlan0mon. Lets `iwconfig wlan0mon
+ * channel N` / `freq X` set the monitor channel via the SAME path nl80211
+ * (`iw set freq`) uses - wlan_hdd_cfg80211_set_mon_ch() (osif_psoc_sync
+ * protected, sleepable; called here from the wext SET ioctl process context).
+ * Defined unconditionally so the handler in wlan_hdd_main.c links even when
+ * FEATURE_MONITOR_MODE_SUPPORT is off; body is feature-guarded.
+ */
+int wlan_hdd_mon_wext_set_freq(struct wiphy *wiphy, int freq_mhz)
+{
+#ifdef FEATURE_MONITOR_MODE_SUPPORT
+	struct cfg80211_chan_def chandef = {
+		.width = NL80211_CHAN_WIDTH_20_NOHT,
+	};
+
+	chandef.center_freq1 = freq_mhz;
+	chandef.chan = ieee80211_get_channel(wiphy, freq_mhz);
+	if (!chandef.chan)
+		return -EINVAL;
+
+	return wlan_hdd_cfg80211_set_mon_ch(wiphy, &chandef);
+#else
+	return -EOPNOTSUPP;
+#endif
+}
+
 #define CNT_DIFF(cur, prev) \
 	((cur >= prev) ? (cur - prev) : (cur + (MAX_COUNT - (prev) + 1)))
 #define MAX_COUNT 0xffffffff
