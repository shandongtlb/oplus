@@ -7308,10 +7321,89 @@ static const struct net_device_ops wlan_drv_ops = {
 };
 
 #ifdef FEATURE_MONITOR_MODE_SUPPORT
-/* Monitor mode net_device_ops, does not Tx and most of operations. */
+/**
+ * hdd_mon_hard_start_xmit() - TX entry for the monitor interface (wlan0mon)
+ * @skb: socket buffer from userspace (radiotap header + 802.11 frame)
+ * @dev: monitor net_device
+ *
+ * NETHUNTER Phase 2 packet injection. Tools like aireplay-ng/airodump-ng send
+ * radiotap-prefixed 802.11 frames out the monitor netdev. We strip the
+ * radiotap header and hand the raw 802.11 frame to the firmware via the WMI
+ * mgmt-TX path on the monitor vdev (wma_inject_mon_frame()).
+ *
+ * Return: NETDEV_TX_OK always (the skb is always consumed).
+ */
+static netdev_tx_t hdd_mon_hard_start_xmit(struct sk_buff *skb,
+					   struct net_device *dev)
+{
+	struct hdd_adapter *adapter = WLAN_HDD_GET_PRIV_PTR(dev);
+	struct ieee80211_radiotap_header *rthdr;
+	static bool xmit_banner;
+	uint8_t *frame;
+	uint32_t frame_len;
+	uint16_t rtap_len = 0;
+	bool has_rtap = false;
+	QDF_STATUS status;
+
+	if (!adapter || adapter->magic != WLAN_HDD_ADAPTER_MAGIC || !skb) {
+		hdd_err_rl("NETHUNTER-INJ: [xmit] drop - bad adapter/skb");
+		goto drop;
+	}
+
+	/* Need at least a minimal radiotap header or a short 802.11 control frame. */
+	if (skb->len < 10) {
+		hdd_err_rl("NETHUNTER-INJ: [xmit] drop - skb too short %u",
+			   skb->len);
+		goto drop;
+	}
+
+	/*
+	 * Monitor TX is normally radiotap + 802.11, but accept a raw 802.11
+	 * frame too (some tools omit radiotap).
+	 */
+	if (skb->len >= sizeof(*rthdr)) {
+		rthdr = (struct ieee80211_radiotap_header *)skb->data;
+		if (rthdr->it_version == 0) {
+			rtap_len = ieee80211_get_radiotap_len(
+					(const char *)skb->data);
+			if (rtap_len >= sizeof(*rthdr) && rtap_len < skb->len)
+				has_rtap = true;
+		}
+	}
+
+	if (has_rtap) {
+		frame = skb->data + rtap_len;
+		frame_len = skb->len - rtap_len;
+	} else {
+		frame = skb->data;
+		frame_len = skb->len;
+	}
+
+	/* One-shot: confirms ndo_start_xmit is wired and userspace TX arrives. */
+	if (!xmit_banner) {
+		hdd_info("NETHUNTER-INJ: [xmit] path active dev=%s vdev=%u skb_len=%u radiotap=%u rtap_len=%u frame_len=%u",
+			 dev->name, adapter->deflink->vdev_id, skb->len, has_rtap,
+			 rtap_len, frame_len);
+		xmit_banner = true;
+	}
+
+	status = wma_inject_mon_frame(adapter->deflink->vdev_id, frame, frame_len);
+	if (QDF_IS_STATUS_ERROR(status))
+		hdd_debug_rl("NETHUNTER-INJ: [xmit] inject failed %d (len %u) - see wma reject log",
+			     status, frame_len);
+
+drop:
+	dev_kfree_skb_any(skb);
+	return NETDEV_TX_OK;
+}
+
+/* Monitor mode net_device_ops. RX is the primary path; ndo_start_xmit feeds
+ * the NetHunter packet-injection path (wma_inject_mon_frame).
+ */
 static const struct net_device_ops wlan_mon_drv_ops = {
 	.ndo_open = hdd_mon_open,
 	.ndo_stop = hdd_stop,
+	.ndo_start_xmit = hdd_mon_hard_start_xmit,
 	.ndo_get_stats = hdd_get_stats,
 };
 
