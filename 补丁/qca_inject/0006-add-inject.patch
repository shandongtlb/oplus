+/**
+ * wma_inject_mon_frame() - inject a raw 802.11 frame on a monitor vdev
+ * @vdev_id: monitor vdev id (wlan0mon)
+ * @frame: raw 802.11 frame bytes (radiotap already stripped by caller)
+ * @frame_len: frame length in bytes
+ *
+ * NETHUNTER Phase 2 monitor-mode packet injection. A dynamically-created
+ * monitor vdev has no peer, so the normal mgmt path (which needs a peer to
+ * allocate a tracking descriptor) cannot be used. This submits the frame
+ * straight to the WMI mgmt-TX command on the monitor vdev using a private
+ * desc_id range above MGMT_DESC_POOL_MAX, owning the nbuf lifecycle itself.
+ *
+ * Return: QDF_STATUS_SUCCESS if the frame was handed to firmware.
+ */
+QDF_STATUS wma_inject_mon_frame(uint8_t vdev_id, const uint8_t *frame,
+				uint32_t frame_len);
 #endif /* WMA_API_H */
diff --git a/vendor/qcom/opensource/wlan/qcacld-3.0/core/wma/src/wma_mgmt.c b/vendor/qcom/opensource/wlan/qcacld-3.0/core/wma/src/wma_mgmt.c
index 2cd2f6608..29365e800 100644
--- a/vendor/qcom/opensource/wlan/qcacld-3.0/core/wma/src/wma_mgmt.c
+++ b/vendor/qcom/opensource/wlan/qcacld-3.0/core/wma/src/wma_mgmt.c
@@ -3144,6 +3144,256 @@ static inline void wma_mgmt_pktdump_rx_handler(
 }
 #endif
 
+/*
+ * NETHUNTER monitor-mode packet injection (Phase 2).
+ *
+ * A dynamically-created monitor vdev (wlan0mon) has no peer, so the normal
+ * mgmt path wlan_mgmt_txrx_mgmt_frame_tx() - which needs a peer to allocate a
+ * tracking descriptor - cannot be used. We instead submit the raw 802.11
+ * frame straight to the WMI mgmt-TX command on the monitor vdev, using a
+ * private desc_id range ABOVE MGMT_DESC_POOL_MAX (64). The stock completion
+ * handler (tgt_mgmt_txrx_tx_completion_handler) cleanly rejects desc_ids in
+ * that range, so it never touches our nbuf - we own the unmap/free in
+ * wma_inject_handle_completion(), intercepted from wma_mgmt_tx_completion_handler().
+ *
+ * This doubles as the firmware-capability probe: if peach_v2 firmware accepts
+ * mgmt TX on a monitor vdev the completion status reads OK (and aireplay-ng -9
+ * sees ACKs); if firmware DISCARDs it (as older QCA firmware does for monitor
+ * vdevs), the completion status shows DISCARD and a helper TX vdev is needed.
+ */
+#define WMA_INJ_DESC_BASE  0x8000
+#define WMA_INJ_SLOTS      64
+#define WMA_INJ_MAX_FRAME  2048
+
+static struct wma_inject_ctx {
+	qdf_spinlock_t lock;
+	struct {
+		qdf_nbuf_t nbuf;
+		bool valid;
+	} slots[WMA_INJ_SLOTS];
+	uint32_t next;
+	uint32_t submitted;	/* frames handed to WMI ok */
+	uint32_t completed;	/* tx-completion events seen */
+	uint32_t reclaimed;	/* slots wrapped before completing */
+	bool inited;
+	bool banner;
+} g_wma_inj;
+
+/* Verbose first-N detail then a periodic heartbeat - bounded so a fast
+ * aireplay run cannot flood dmesg while still showing it is alive.
+ */
+#define WMA_INJ_LOG_FIRST   8
+#define WMA_INJ_LOG_EVERY   256
+#define wma_inj_should_log(n) \
+	((n) <= WMA_INJ_LOG_FIRST || ((n) % WMA_INJ_LOG_EVERY) == 0)
+
+static inline bool wma_inject_is_inj_desc(uint32_t desc_id)
+{
+	return desc_id >= WMA_INJ_DESC_BASE &&
+	       desc_id < (WMA_INJ_DESC_BASE + WMA_INJ_SLOTS);
+}
+
+static void wma_inject_init_once(void)
+{
+	/*
+	 * The first injection happens long after module load, and
+	 * ndo_start_xmit is serialised per-netdev by the qdisc while tx
+	 * completions strictly follow submits - so this one-time init cannot
+	 * race a completion path.
+	 */
+	if (!g_wma_inj.inited) {
+		qdf_spinlock_create(&g_wma_inj.lock);
+		g_wma_inj.inited = true;
+	}
+}
+
+static void wma_inject_handle_completion(tp_wma_handle wma, uint32_t desc_id,
+					 uint32_t status)
+{
+	uint32_t slot = desc_id - WMA_INJ_DESC_BASE;
+	qdf_nbuf_t nbuf = NULL;
+
+	if (slot >= WMA_INJ_SLOTS || !g_wma_inj.inited)
+		return;
+
+	qdf_spin_lock_bh(&g_wma_inj.lock);
+	if (g_wma_inj.slots[slot].valid) {
+		nbuf = g_wma_inj.slots[slot].nbuf;
+		g_wma_inj.slots[slot].nbuf = NULL;
+		g_wma_inj.slots[slot].valid = false;
+	}
+	qdf_spin_unlock_bh(&g_wma_inj.lock);
+
+	if (nbuf) {
+		qdf_nbuf_unmap_single(wma->qdf_dev, nbuf, QDF_DMA_TO_DEVICE);
+		qdf_nbuf_free(nbuf);
+	} else {
+		/* completion for a slot we already freed/reclaimed - desc reuse */
+		wma_err_rl("NETHUNTER-INJ: [completion] desc=%u status=%u(%s) but slot %u empty (late/reclaimed)",
+			   desc_id, status, wma_get_status_str(status), slot);
+	}
+
+	g_wma_inj.completed++;
+
+	/*
+	 * status==0 (WMI_MGMT_TX_COMP_TYPE_COMPLETE_OK) means firmware
+	 * transmitted; any DISCARD/NO_ACK here is the firmware telling us it
+	 * rejected the monitor-vdev TX. submitted-vs-completed exposes the
+	 * "firmware never completes" failure mode (counts diverge).
+	 */
+	if (wma_inj_should_log(g_wma_inj.completed))
+		wma_info("NETHUNTER-INJ: [completion] #%u desc=%u status=%u(%s) [submitted=%u completed=%u reclaimed=%u]",
+			 g_wma_inj.completed, desc_id, status,
+			 wma_get_status_str(status), g_wma_inj.submitted,
+			 g_wma_inj.completed, g_wma_inj.reclaimed);
+}
+
+QDF_STATUS wma_inject_mon_frame(uint8_t vdev_id, const uint8_t *frame,
+				uint32_t frame_len)
+{
+	tp_wma_handle wma = cds_get_context(QDF_MODULE_ID_WMA);
+	void *qdf_ctx = cds_get_context(QDF_MODULE_ID_QDF_DEVICE);
+	struct wmi_mgmt_params mgmt_params = {0};
+	struct wma_txrx_node *iface;
+	qdf_nbuf_t nbuf, old = NULL;
+	uint8_t *data;
+	uint16_t chanfreq;
+	uint32_t slot, desc_id;
+	QDF_STATUS status;
+
+	if (wma_validate_handle(wma) || !frame || !qdf_ctx) {
+		wma_err_rl("NETHUNTER-INJ: [reject] bad ctx (wma=%pK frame=%pK qdf=%pK)",
+			   wma, frame, qdf_ctx);
+		return QDF_STATUS_E_INVAL;
+	}
+
+	if (!frame_len || frame_len > WMA_INJ_MAX_FRAME) {
+		wma_err_rl("NETHUNTER-INJ: [reject] bad frame_len %u (max %u)",
+			   frame_len, WMA_INJ_MAX_FRAME);
+		return QDF_STATUS_E_INVAL;
+	}
+
+	if (vdev_id >= wma->max_bssid) {
+		wma_err_rl("NETHUNTER-INJ: [reject] vdev_id %u >= max %u",
+			   vdev_id, wma->max_bssid);
+		return QDF_STATUS_E_INVAL;
+	}
+
+	iface = &wma->interfaces[vdev_id];
+	if (!iface->vdev || !iface->vdev_active) {
+		wma_err_rl("NETHUNTER-INJ: [reject] vdev %u not active (vdev=%pK active=%u type=%u)",
+			   vdev_id, iface->vdev, iface->vdev_active, iface->type);
+		return QDF_STATUS_E_AGAIN;
+	}
+
+	chanfreq = (uint16_t)iface->ch_freq;
+	if (iface->type == WMI_VDEV_TYPE_MONITOR && !chanfreq) {
+		wma_err_rl("NETHUNTER-INJ: [reject] monitor vdev %u has no channel (set 'iw dev wlan0mon set freq' first)",
+			   vdev_id);
+		return QDF_STATUS_E_INVAL;
+	}
+
+	wma_inject_init_once();
+
+	nbuf = qdf_nbuf_alloc(NULL, frame_len, 0, 4, false);
+	if (!nbuf) {
+		wma_err_rl("NETHUNTER-INJ: [reject] nbuf alloc failed len %u",
+			   frame_len);
+		return QDF_STATUS_E_NOMEM;
+	}
+
+	data = qdf_nbuf_put_tail(nbuf, frame_len);
+	if (!data) {
+		qdf_nbuf_free(nbuf);
+		wma_err_rl("NETHUNTER-INJ: [reject] nbuf put_tail failed len %u",
+			   frame_len);
+		return QDF_STATUS_E_NOMEM;
+	}
+	qdf_mem_copy(data, frame, frame_len);
+
+	qdf_spin_lock_bh(&g_wma_inj.lock);
+	slot = g_wma_inj.next++ % WMA_INJ_SLOTS;
+	desc_id = WMA_INJ_DESC_BASE + slot;
+	if (g_wma_inj.slots[slot].valid) {
+		old = g_wma_inj.slots[slot].nbuf;   /* never completed - reclaim */
+		g_wma_inj.reclaimed++;
+	}
+	g_wma_inj.slots[slot].nbuf = nbuf;
+	g_wma_inj.slots[slot].valid = true;
+	qdf_spin_unlock_bh(&g_wma_inj.lock);
+
+	if (old) {
+		qdf_nbuf_unmap_single(wma->qdf_dev, old, QDF_DMA_TO_DEVICE);
+		qdf_nbuf_free(old);
+		/* All 64 slots in flight without a single completion => firmware
+		 * is silently dropping injected frames (no tx-completion event).
+		 */
+		wma_err_rl("NETHUNTER-INJ: [warn] reclaimed uncompleted slot %u (submitted=%u completed=%u reclaimed=%u) - firmware may not be sending tx completions",
+			   slot, g_wma_inj.submitted, g_wma_inj.completed,
+			   g_wma_inj.reclaimed);
+	}
+
+	mgmt_params.tx_frame = nbuf;
+	mgmt_params.frm_len = frame_len;
+	mgmt_params.vdev_id = vdev_id;
+	mgmt_params.chanfreq = chanfreq;
+	mgmt_params.desc_id = desc_id;
+	mgmt_params.pdata = data;
+	mgmt_params.qdf_ctx = qdf_ctx;
+
+	if (!g_wma_inj.banner) {
+		wma_info("NETHUNTER-INJ: monitor injection active build=mon-inject-probe-r6 vdev=%u chan=%u iface_type=%u",
+			 vdev_id, chanfreq, iface->type);
+		g_wma_inj.banner = true;
+	}
+
+	status = wmi_mgmt_unified_cmd_send(wma->wmi_handle, &mgmt_params);
+	if (QDF_IS_STATUS_ERROR(status)) {
+		wma_err_rl("NETHUNTER-INJ: wmi mgmt tx failed %d (vdev %u len %u)",
+			   status, vdev_id, frame_len);
+		/*
+		 * send_mgmt_cmd_tlv unmaps tx_frame on its own failure path but
+		 * never frees it - reclaim our slot and free the nbuf here.
+		 */
+		qdf_spin_lock_bh(&g_wma_inj.lock);
+		if (g_wma_inj.slots[slot].valid &&
+		    g_wma_inj.slots[slot].nbuf == nbuf) {
+			g_wma_inj.slots[slot].nbuf = NULL;
+			g_wma_inj.slots[slot].valid = false;
+		} else {
+			nbuf = NULL;   /* already reclaimed elsewhere */
+		}
+		qdf_spin_unlock_bh(&g_wma_inj.lock);
+		if (nbuf)
+			qdf_nbuf_free(nbuf);
+		return status;
+	}
+
+	g_wma_inj.submitted++;
+
+	/* Per-frame detail for the first few + a periodic heartbeat. fc fields
+	 * and the three addresses let us confirm aireplay's frame reached the
+	 * firmware intact (type/subtype, BSSID, source MAC).
+	 */
+	if (wma_inj_should_log(g_wma_inj.submitted)) {
+		uint8_t fc0 = frame[0];
+
+		if (frame_len >= 24)
+			wma_info("NETHUNTER-INJ: [submit] #%u vdev=%u desc=%u chan=%u len=%u fc=0x%02x(type=%u sub=%u) a1=%pM a2=%pM a3=%pM",
+				 g_wma_inj.submitted, vdev_id, desc_id, chanfreq,
+				 frame_len, fc0, (fc0 >> 2) & 0x3,
+				 (fc0 >> 4) & 0xf, frame + 4, frame + 10,
+				 frame + 16);
+		else
+			wma_info("NETHUNTER-INJ: [submit] #%u vdev=%u desc=%u chan=%u len=%u fc=0x%02x(type=%u sub=%u) (short frame)",
+				 g_wma_inj.submitted, vdev_id, desc_id, chanfreq,
+				 frame_len, fc0, (fc0 >> 2) & 0x3,
+				 (fc0 >> 4) & 0xf);
+	}
+
+	return QDF_STATUS_SUCCESS;
+}
+
 /**
  * wma_process_mgmt_tx_completion() - process mgmt completion
  * @wma_handle: wma handle
@@ -3245,6 +3495,18 @@ int wma_mgmt_tx_completion_handler(void *handle, uint8_t *cmpl_event_params,
 	}
 	cmpl_params = param_buf->fixed_param;
 
+	/*
+	 * NETHUNTER monitor injection frames carry a private desc_id range and
+	 * are not tracked by the mgmt_txrx desc pool. Handle their nbuf cleanup
+	 * and status logging here, then stop - the stock path would only spam
+	 * "desc_id out of bounds".
+	 */
+	if (wma_inject_is_inj_desc(cmpl_params->desc_id)) {
+		wma_inject_handle_completion(wma_handle, cmpl_params->desc_id,
+					     cmpl_params->status);
+		return 0;
+	}
+
 	if ((ucfg_pkt_capture_get_pktcap_mode(wma_handle->psoc) &
 	    PKT_CAPTURE_MODE_MGMT_ONLY) && param_buf->mgmt_hdr) {
 		struct mgmt_offload_event_params params = {0};
-- 
