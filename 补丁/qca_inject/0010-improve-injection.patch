From 13950524635db6354e647ce128f0ed83e266cb21 Mon Sep 17 00:00:00 2001
From: shandongtlb <40312509+shandongtlb@users.noreply.github.com>
Date: Sun, 7 Jun 2026 08:38:48 +0000
Subject: [PATCH 10/12] qcacld: improve injection debugging - reset counters
 per session

1. Reset g_wma_inj.{submitted,completed} to 0 each time helper vdev
   is rebuilt (on channel change), so dmesg heartbeat logs start from
   frame #0 in each new monitor session instead of carrying over from
   previous sessions.

2. Increase log verbosity: first 32 frames (was 8), then every 64
   frames (was 256) for more responsive debugging feedback.

Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
---
 .../wlan/qcacld-3.0/core/wma/src/wma_mgmt.c          | 12 ++++++++++--
 1 file changed, 10 insertions(+), 2 deletions(-)

diff --git a/vendor/qcom/opensource/wlan/qcacld-3.0/core/wma/src/wma_mgmt.c b/vendor/qcom/opensource/wlan/qcacld-3.0/core/wma/src/wma_mgmt.c
index de78ab954..5d17e622a 100644
--- a/vendor/qcom/opensource/wlan/qcacld-3.0/core/wma/src/wma_mgmt.c
+++ b/vendor/qcom/opensource/wlan/qcacld-3.0/core/wma/src/wma_mgmt.c
@@ -3186,8 +3186,8 @@ static struct wma_inject_ctx {
 /* Verbose first-N detail then a periodic heartbeat - bounded so a fast
  * aireplay run cannot flood dmesg while still showing it is alive.
  */
-#define WMA_INJ_LOG_FIRST   8
-#define WMA_INJ_LOG_EVERY   256
+#define WMA_INJ_LOG_FIRST   32
+#define WMA_INJ_LOG_EVERY   64
 #define wma_inj_should_log(n) \
 	((n) <= WMA_INJ_LOG_FIRST || ((n) % WMA_INJ_LOG_EVERY) == 0)
 
@@ -3338,6 +3338,14 @@ QDF_STATUS wma_inject_ensure_tx_vdev(uint8_t mon_vdev_id, uint32_t chanfreq)
 		wma_inject_destroy_tx_vdev();	/* channel changed -> recreate */
 	}
 
+	/*
+	 * Reset injection counters each time we rebuild the helper vdev so
+	 * that dmesg heartbeat logs (every 256 frames) start from 0 in each
+	 * new monitor session, making per-session debugging clearer.
+	 */
+	g_wma_inj.submitted = 0;
+	g_wma_inj.completed = 0;
+
 	/*
 	 * Find an unused vdev slot, skipping the monitor vdev. Ceiling is
 	 * CFG_TGT_NUM_VDEV-2 so we never exceed the FW vdev array.
-- 
