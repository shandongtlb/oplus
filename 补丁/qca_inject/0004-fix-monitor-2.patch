@@ -248,8 +248,11 @@ static void rtl8187_tx(struct ieee80211_hw *dev,
 	flags |= RTL818X_TX_DESC_FLAG_NO_ENC;
 
 	flags |= ieee80211_get_tx_rate(dev, info)->hw_value << 24;
-	if (ieee80211_has_morefrags(tx_hdr->frame_control))
-		flags |= RTL818X_TX_DESC_FLAG_MOREFRAG;
+	if (ieee80211_has_morefrags(tx_hdr->frame_control)) {
+		if (likely(info->control.vif != NULL &&
+			   info->control.vif->type != NL80211_IFTYPE_MONITOR))
+			flags |= RTL818X_TX_DESC_FLAG_MOREFRAG;
+	}
 
 	/* HW will perform RTS-CTS when only RTS flags is set.
 	 * HW will perform CTS-to-self when both RTS and CTS flags are set.
diff --git a/kernel_platform/msm-kernel/drivers/net/wireless/zydas/zd1211rw/zd_mac.c b/kernel_platform/msm-kernel/drivers/net/wireless/zydas/zd1211rw/zd_mac.c
index 5d534e15a..a84fbfa27 100644
--- a/kernel_platform/msm-kernel/drivers/net/wireless/zydas/zd1211rw/zd_mac.c
+++ b/kernel_platform/msm-kernel/drivers/net/wireless/zydas/zd1211rw/zd_mac.c
@@ -229,14 +229,19 @@ void zd_mac_clear(struct zd_mac *mac)
 static int set_rx_filter(struct zd_mac *mac)
 {
 	unsigned long flags;
-	u32 filter = STA_RX_FILTER;
+	struct zd_ioreq32 ioreqs[] = {
+		{ CR_RX_FILTER, STA_RX_FILTER },
+		{ CR_SNIFFER_ON, 0U },
+	};
 
 	spin_lock_irqsave(&mac->lock, flags);
-	if (mac->pass_ctrl)
-		filter |= RX_FILTER_CTRL;
+	if (mac->pass_ctrl) {
+		ioreqs[0].value |= 0xFFFFFFFF;
+		ioreqs[1].value = 0x1;
+	}
 	spin_unlock_irqrestore(&mac->lock, flags);
 
-	return zd_iowrite32(&mac->chip, CR_RX_FILTER, filter);
+	return zd_iowrite32a(&mac->chip, ioreqs, ARRAY_SIZE(ioreqs));
 }
 
 static int set_mac_and_bssid(struct zd_mac *mac)
@@ -1042,7 +1047,8 @@ int zd_mac_rx(struct ieee80211_hw *hw, const u8 *buffer, unsigned int length)
 	/* Caller has to ensure that length >= sizeof(struct rx_status). */
 	status = (struct rx_status *)
 		(buffer + (length - sizeof(struct rx_status)));
-	if (status->frame_status & ZD_RX_ERROR) {
+	if ((status->frame_status & ZD_RX_ERROR) ||
+		(status->frame_status & ~0x21)) {
 		if (mac->pass_failed_fcs &&
 				(status->frame_status & ZD_RX_CRC32_ERROR)) {
 			stats.flag |= RX_FLAG_FAILED_FCS_CRC;
@@ -1387,7 +1393,7 @@ struct ieee80211_hw *zd_mac_alloc_hw(struct usb_interface *intf)
 	ieee80211_hw_set(hw, MFP_CAPABLE);
 	ieee80211_hw_set(hw, HOST_BROADCAST_PS_BUFFERING);
 	ieee80211_hw_set(hw, RX_INCLUDES_FCS);
-	ieee80211_hw_set(hw, SIGNAL_UNSPEC);
+	ieee80211_hw_set(hw, SIGNAL_DBM);
 
 	hw->wiphy->interface_modes =
 		BIT(NL80211_IFTYPE_MESH_POINT) |
diff --git a/kernel_platform/msm-kernel/net/mac80211/cfg.c b/kernel_platform/msm-kernel/net/mac80211/cfg.c
index a3c5d4d99..5f3bab598 100644
--- a/kernel_platform/msm-kernel/net/mac80211/cfg.c
+++ b/kernel_platform/msm-kernel/net/mac80211/cfg.c
@@ -931,10 +931,9 @@ static int ieee80211_set_monitor_channel(struct wiphy *wiphy,
 		}
 	} else {
 		mutex_lock(&local->mtx);
-		if (local->open_count == local->monitors) {
-			local->_oper_chandef = *chandef;
-			ieee80211_hw_config(local, 0);
-		}
+		/* Allow monitor channel changes even when normal virtual interfaces exist. */
+		local->_oper_chandef = *chandef;
+		ieee80211_hw_config(local, 0);
 		mutex_unlock(&local->mtx);
 	}
 
diff --git a/kernel_platform/msm-kernel/net/mac80211/tx.c b/kernel_platform/msm-kernel/net/mac80211/tx.c
index 45a093d3f..f827933b7 100644
--- a/kernel_platform/msm-kernel/net/mac80211/tx.c
+++ b/kernel_platform/msm-kernel/net/mac80211/tx.c
@@ -831,11 +831,16 @@ ieee80211_tx_h_sequence(struct ieee80211_tx_data *tx)
 
 	/*
 	 * Packet injection may want to control the sequence
-	 * number, if we have no matching interface then we
-	 * neither assign one ourselves nor ask the driver to.
+	 * number, so if an injected frame is found, do not
+	 * renumber it here. Also mark it NO_ACK when appropriate
+	 * to avoid monitor-mode retry behaviour.
 	 */
-	if (unlikely(info->control.vif->type == NL80211_IFTYPE_MONITOR))
+	if (unlikely((info->flags & IEEE80211_TX_CTL_INJECTED) &&
+		     !(tx->sdata->u.mntr.flags & MONITOR_FLAG_COOK_FRAMES))) {
+		if (!ieee80211_has_morefrags(hdr->frame_control))
+			info->flags |= IEEE80211_TX_CTL_NO_ACK;
 		return TX_CONTINUE;
+	}
 
 	if (unlikely(ieee80211_is_ctl(hdr->frame_control)))
 		return TX_CONTINUE;
@@ -2065,7 +2070,8 @@ void ieee80211_xmit(struct ieee80211_sub_if_data *sdata,
 		}
 	}
 
-	ieee80211_set_qos_hdr(sdata, skb);
+	if (likely(info->control.vif->type != NL80211_IFTYPE_MONITOR))
+		ieee80211_set_qos_hdr(sdata, skb);
 	ieee80211_tx(sdata, sta, skb, false);
 }
 
diff --git a/kernel_platform/msm-kernel/net/wireless/chan.c b/kernel_platform/msm-kernel/net/wireless/chan.c
index 99be6f802..f3a231c58 100644
--- a/kernel_platform/msm-kernel/net/wireless/chan.c
+++ b/kernel_platform/msm-kernel/net/wireless/chan.c
@@ -1473,8 +1473,7 @@ int cfg80211_set_monitor_channel(struct cfg80211_registered_device *rdev,
 {
 	if (!rdev->ops->set_monitor_channel)
 		return -EOPNOTSUPP;
-	if (!cfg80211_has_monitors_only(rdev))
-		return -EBUSY;
+	/* Allow monitor channel changes even if another virtual interface is active. */
 
 	return rdev_set_monitor_channel(rdev, chandef);
 }
diff --git a/vendor/qcom/opensource/wlan/qca-wifi-host-cmn/wlan_cfg/wlan_cfg.c b/vendor/qcom/opensource/wlan/qca-wifi-host-cmn/wlan_cfg/wlan_cfg.c
index 8a6b3d9ab..d535c2f35 100644
--- a/vendor/qcom/opensource/wlan/qca-wifi-host-cmn/wlan_cfg/wlan_cfg.c
+++ b/vendor/qcom/opensource/wlan/qca-wifi-host-cmn/wlan_cfg/wlan_cfg.c
@@ -4009,16 +4009,8 @@ static void
 wlan_soc_local_pkt_capture_cfg_attach(struct cdp_ctrl_objmgr_psoc *psoc,
 				      struct wlan_cfg_dp_soc_ctxt *wlan_cfg_ctx)
 {
-	/*
-	 * NetHunter: force-enable Local Packet Capture regardless of the
-	 * device .ini value. The OEM .ini lives on a write-protected /vendor
-	 * partition and disables LPC, which breaks the standard iw/airmon-ng
-	 * monitor path (no capture filter is ever programmed, so airodump-ng
-	 * sees no frames). Forcing it here, at cfg attach (driver load), also
-	 * guarantees the LPC monitor rings are allocated before any monitor
-	 * interface is opened.
-	 */
-	wlan_cfg_ctx->local_pkt_capture = 1;
+	wlan_cfg_ctx->local_pkt_capture =
+		cfg_get(psoc, CFG_DP_LOCAL_PKT_CAPTURE);
 }
 #else
 static void
diff --git a/vendor/qcom/opensource/wlan/qcacld-3.0/core/hdd/src/wlan_hdd_cfg80211.c b/vendor/qcom/opensource/wlan/qcacld-3.0/core/hdd/src/wlan_hdd_cfg80211.c
index 8ebf88103..0cc6cf5aa 100755
--- a/vendor/qcom/opensource/wlan/qcacld-3.0/core/hdd/src/wlan_hdd_cfg80211.c
+++ b/vendor/qcom/opensource/wlan/qcacld-3.0/core/hdd/src/wlan_hdd_cfg80211.c
@@ -26308,6 +26308,23 @@ static int hdd_change_adapter_mode(struct hdd_adapter *adapter,
 	adapter->device_mode = new_mode;
 	hdd_set_station_ops(netdev);
 
+	/*
+	 * NetHunter: when dynamically switching to monitor mode (iw set type
+	 * monitor), the adapter was originally allocated as a station, so the
+	 * monitor vdev up/stop completion events were never created (that only
+	 * happens in hdd_open_adapter for session_type == QDF_MONITOR_MODE).
+	 * Without them, __wlan_hdd_cfg80211_set_mon_ch()'s qdf_event_reset()
+	 * fails with "failed to reinit monitor mode vdev up event" (-EINVAL),
+	 * so 'iw set freq' can never tune the monitor channel. Create them here
+	 * to mirror the global-monitor path. Safe to re-create on repeat
+	 * switches (qdf_event_create just re-initialises the event).
+	 */
+	if (new_mode == QDF_MONITOR_MODE) {
+		status = hdd_monitor_mode_qdf_create_event(adapter, new_mode);
+		if (QDF_IS_STATUS_ERROR(status))
+			hdd_err("Failed to create monitor mode vdev events");
+	}
+
 	hdd_exit();
 
 	return qdf_status_to_os_return(status);
diff --git a/vendor/qcom/opensource/wlan/qcacld-3.0/core/hdd/src/wlan_hdd_main.c b/vendor/qcom/opensource/wlan/qcacld-3.0/core/hdd/src/wlan_hdd_main.c
