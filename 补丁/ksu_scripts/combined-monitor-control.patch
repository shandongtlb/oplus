++static void hdd_debugfs_exit(struct hdd_adapter *a) { assert(a==&adapter); }
++static void clear_bit(unsigned b, unsigned long *v) { *v &= ~(1UL << b); }
++static bool test_bit(unsigned b, unsigned long *v) { return *v & (1UL << b); }
++static void unregister_netdev(struct net_device *d);
++static void hdd_unregister_netdevice(struct hdd_adapter *a, struct net_device *d);
++static void reset(void) {
