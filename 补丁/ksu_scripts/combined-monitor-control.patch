++#define hdd_debug(...) ((void)0)
++enum { DEVICE_IFACE_OPENED, NET_DEVICE_REGISTERED };
++struct wiphy { int unused; } phy;
++struct hdd_context { int unused; } ctx;
++struct osif_vdev_sync { int unused; } sync_ctx;
++struct hdd_adapter;
++struct net_device { struct hdd_adapter *priv; } dev;
++struct hdd_adapter {
++ struct net_device *dev;
++ bool netdev_unregistering;
++ unsigned long event_flags;
