++def get(key, default=''):
++    f = p / key
++    return f.read_text().strip() if f.exists() else default
++def end(code=0):
++    sys.exit(code)
++if name == 'log' or name == 'sleep': end()
++if name == 'id': print('0'); end()
++if name == 'dumpsys':
++    print(get('p2p', 'curState=InactiveState'))
