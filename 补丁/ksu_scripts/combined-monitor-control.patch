++#!/usr/bin/env python3
++"""Exercise production peer confirmation, ownership and teardown with WMI stubs."""
++from pathlib import Path
++import subprocess
++import tempfile
++
++ROOT = Path(__file__).resolve().parents[1]
++source = (ROOT / 'core/wma/src/wma_inject.c').read_text()
++
++def function(signature):
++    start = source.index(signature)
++    end = source.index('{', start) + 1
++    depth = 1
++    while depth:
++        depth += (source[end] == '{') - (source[end] == '}')
++        end += 1
++    return source[start:end]
++
++ensure = function('static QDF_STATUS inj_ensure_locked(')
++assert 'inj_create_self_peer(wma)' in ensure
++assert 'inj.self_peer = true' not in ensure
++
++pre = r'''
++#include <assert.h>
++#include <stdbool.h>
++#include <stdint.h>
++#include <stdio.h>
++#include <string.h>
++typedef int QDF_STATUS;
++struct wma { void *wmi_handle; } context;
++typedef struct wma *tp_wma_handle;
++enum inj_response { INJ_RSP_NONE, INJ_RSP_SELF, INJ_RSP_PEER, INJ_RSP_PEER_DELETE };
++enum { INJ_RUNNING, INJ_STOPPED, INJ_RESET_REQUIRED };
++enum { QDF_STATUS_SUCCESS, QDF_STATUS_E_FAILURE, QDF_STATUS_E_AGAIN };
++#define QDF_IS_STATUS_ERROR(x) ((x) != 0)
++#define QDF_IS_STATUS_SUCCESS(x) ((x) == 0)
++#define WMI_PEER_EXISTS 1
++#define WMI_PEER_TYPE_DEFAULT 0
++#define INJ_CONFIRM_MS 2000
++#define QDF_MODULE_ID_WMA 1
++#define msecs_to_jiffies(x) (x)
++#define wma_err(...) ((void)0)
++static int inj_lock, inj_response_done, locked;
++static struct {
++ bool reserved, started, self_peer, unicast_peer;
++ int state, helper_id;
++ enum inj_response response, response_received;
++ uint32_t response_status;
++ uint8_t mac[6], target[6], response_addr[6];
++ unsigned timeouts;
++} inj;
++struct peer_create_params { int vdev_id, peer_type; uint8_t *peer_addr; };
++struct peer_delete_cmd_params { int vdev_id; };
++static uint32_t create_status;
++static int send_error, deletes, stops, vdev_deletes, faults, releases;
++static bool ready, complete, right_kind, tx_drained;
++static void spin_lock_bh(int *p) { assert(p==&inj_lock && !locked); locked=1; }
++static void spin_unlock_bh(int *p) { assert(p==&inj_lock && locked); locked=0; }
++static void reinit_completion(int *p) { assert(p==&inj_response_done); }
++static void ether_addr_copy(uint8_t *d, const uint8_t *s) { memcpy(d,s,6); }
++static bool inj_fw_ready(tp_wma_handle w) { assert(w==&context); return ready; }
++static unsigned long wait_for_completion_timeout(int *p, unsigned long ms) {
++ assert(p==&inj_response_done && ms==INJ_CONFIRM_MS && !locked);
++ if (!complete) return 0;
++ inj.response_received=right_kind ? inj.response : INJ_RSP_NONE;
++ inj.response_status=inj.response==INJ_RSP_PEER_DELETE ? 0 : create_status;
++ return 1;
++}
++static int wmi_unified_peer_create_send(void *w, struct peer_create_params *p) {
++ assert(w==context.wmi_handle && p->vdev_id==4 && p->peer_type==0);
++ assert(!memcmp(p->peer_addr,inj.mac,6)); return send_error;
++}
++static int wmi_unified_peer_delete_send(void *w, uint8_t *mac, struct peer_delete_cmd_params *p) {
++ assert(w==context.wmi_handle && p->vdev_id==4 && !stops);
++ assert(mac==inj.mac || mac==inj.target); deletes++; return send_error;
++}
++static tp_wma_handle cds_get_context(int id) { assert(id==1); return &context; }
++static void inj_quiesce(void) {}
++static bool inj_wait_tx(void) { return tx_drained; }
++static QDF_STATUS inj_stop(tp_wma_handle w) { assert(w==&context); stops++; return 0; }
++static QDF_STATUS inj_delete(tp_wma_handle w) { assert(w==&context && stops==1); vdev_deletes++; return 0; }
++static void inj_release_owner(void) { releases++; }
++static void inj_fault(const char *why) { assert(why); faults++; }
++static void reset(void) {
++ memset(&inj,0,sizeof(inj)); inj.helper_id=4; inj.reserved=inj.started=true;
++ inj.mac[0]=2; inj.mac[5]=7; context.wmi_handle=&context;
++ ready=complete=right_kind=tx_drained=true;
++ create_status=send_error=deletes=stops=vdev_deletes=faults=releases=0;
++}
++'''
++post = r'''
++int main(void) {
++ reset(); assert(!inj_create_self_peer(&context) && inj.self_peer);
++ inj_destroy_locked(); assert(deletes==1 && stops==1 && vdev_deletes==1);
++ assert(!inj.self_peer && !inj.reserved && inj.state==INJ_STOPPED && !faults);
++ reset(); create_status=WMI_PEER_EXISTS;
++ assert(!inj_create_self_peer(&context) && !inj.self_peer);
++ inj_destroy_locked(); assert(!deletes && stops==1 && vdev_deletes==1 && !faults);
++ /* A unicast peer is still explicitly deleted with a firmware-owned self. */
++ reset(); create_status=WMI_PEER_EXISTS; inj.unicast_peer=true;
++ assert(!inj_create_self_peer(&context)); inj_destroy_locked();
++ assert(deletes==1 && !inj.unicast_peer && stops==1 && vdev_deletes==1);
++ /* EXISTS is allowed only for the self-peer, never for a target peer. */
++ reset(); create_status=WMI_PEER_EXISTS;
