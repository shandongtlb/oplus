+++wlan_flock() {
+++  if command -v flock >/dev/null 2>&1; then
+++    flock "$@"
+++  elif [ -x /data/adb/ksu/bin/busybox ]; then
+++    /data/adb/ksu/bin/busybox flock "$@"
+++  elif [ -x /data/adb/magisk/busybox ]; then
+++    /data/adb/magisk/busybox flock "$@"
+++  else
+++    wlan_error '缺少 flock，无法安全串行启停和热切。'
+++    return 1
+++  fi
+++}
