++"""Run actual final adapter cleanup and both cfg80211 PNO stop callback variants."""
++from pathlib import Path
++import subprocess
++import tempfile
++
++ROOT = Path(__file__).resolve().parents[1]
++main = (ROOT/'core/hdd/src/wlan_hdd_main.c').read_text()
++scan = (ROOT/'core/hdd/src/wlan_hdd_scan.c').read_text()
++
++def function(source, signature, start_at=0):
++    start = source.index(signature, start_at)
++    end = source.index('{', start) + 1
++    depth = 1
++    while depth:
++        depth += (source[end] == '{') - (source[end] == '}')
++        end += 1
++    return source[start:end], end
++
++old, end = function(scan, 'int wlan_hdd_cfg80211_sched_scan_stop(')
++new, _ = function(scan, 'int wlan_hdd_cfg80211_sched_scan_stop(', end)
++cleanup, _ = function(main, 'static void hdd_cleanup_adapter(')
++pre = r'''
++#include <assert.h>
++#include <errno.h>
++#include <stdbool.h>
++#include <stdint.h>
++#include <stdio.h>
++#include <string.h>
++#define READ_ONCE(x) (x)
++#define WRITE_ONCE(x,y) ((x)=(y))
++#define WLAN_HDD_GET_PRIV_PTR(d) ((d)->priv)
++#define hdd_err(...) ((void)0)
++#define hdd_debug(...) ((void)0)
++enum { DEVICE_IFACE_OPENED, NET_DEVICE_REGISTERED };
++struct wiphy { int unused; } phy;
++struct hdd_context { int unused; } ctx;
++struct osif_vdev_sync { int unused; } sync_ctx;
++struct hdd_adapter;
++struct net_device { struct hdd_adapter *priv; } dev;
++struct hdd_adapter {
++ struct net_device *dev;
++ bool netdev_unregistering;
++ unsigned long event_flags;
++ int mc_list_lock, sta_info_list, cache_sta_info_list;
++} adapter;
++static int sync_error, firmware_error, starts, stops, fw_calls, unregisters;
++static int osif_vdev_sync_op_start(struct net_device *d, struct osif_vdev_sync **out) {
++ assert(d==&dev && !adapter.netdev_unregistering); starts++;
++ *out=&sync_ctx; return sync_error;
++}
++static void osif_vdev_sync_op_stop(struct osif_vdev_sync *s) { assert(s==&sync_ctx); stops++; }
++static int __wlan_hdd_cfg80211_sched_scan_stop(struct net_device *d) {
++ assert(d==&dev && !adapter.netdev_unregistering); fw_calls++; return firmware_error;
++}
++static void hdd_apf_context_destroy(struct hdd_adapter *a) { assert(a==&adapter && a->netdev_unregistering); }
++static void qdf_spinlock_destroy(int *p) { assert(p==&adapter.mc_list_lock); }
++static void hdd_adapter_destroy_vdev_info(struct hdd_adapter *a) { assert(a==&adapter); }
