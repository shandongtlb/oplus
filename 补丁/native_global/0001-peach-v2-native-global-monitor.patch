+/* Native monitor management TX. Firmware acceptance is experimental.
+ * A completion is the only per-frame DMA ownership fence. Missing events
+ * must never cause a timer to unmap memory still owned by firmware.
+ */
+#define WMA_INJ_DESC_BASE  0x8000
+#define WMA_INJ_SLOTS      64
+#define WMA_INJ_MAX_FRAME  2048
+
+/* Force the PMF test flag on other management frames for A/B diagnosis.
