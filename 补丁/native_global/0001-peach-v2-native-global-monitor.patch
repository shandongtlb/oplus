+#!/usr/bin/env python3
+"""Execute the production HDD entry functions against transaction stubs.
+The critical assertion is that failed TX quiescence never queues a driver
+transaction or tears down a monitor adapter; an SSR may then own the psoc.
+"""
+from pathlib import Path
+import subprocess,tempfile
+ROOT=Path(__file__).resolve().parents[1]
+s=(ROOT/'core/hdd/src/wlan_hdd_main.c').read_text()
+def func(name):
+ start=s.index('static int '+name+'(')
+ begin=s.index('{',start);n=1;end=begin+1
+ while n:
+  n+=(s[end]=='{')-(s[end]=='}');end+=1
+ return s[start:end]
+pre=r'''
+#include <assert.h>
+#include <errno.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <string.h>
+enum QDF_GLOBAL_MODE { QDF_GLOBAL_MISSION_MODE=0, QDF_GLOBAL_MONITOR_MODE=4 };
+enum { QDF_MODULE_ID_HDD, DRIVER_MODULES_CLOSED=2 };
+struct osif_psoc_sync { int unused; } psoc;
+struct osif_driver_sync { int unused; } driver;
+struct hdd_context { void *parent_dev; int driver_status; } ctx;
+static int current, invalid_ctx, psoc_error, tx_error, driver_error;
+static int psoc_active, driver_active, waits, prepares, parents, switches;
+#define hdd_err(...) ((void)0)
+#define hdd_enter() ((void)0)
+#define hdd_exit() ((void)0)
+static int hdd_get_conparam(void) { return current; }
+static bool is_con_mode_valid(int m) { return m==0 || m==4; }
+static struct hdd_context *cds_get_context(int id) { (void)id; return &ctx; }
+static int wlan_hdd_validate_context(void *p) { assert(p==&ctx); return invalid_ctx; }
+static int osif_psoc_sync_trans_start(void *dev, struct osif_psoc_sync **out) {
+ (void)dev; assert(!driver_active); if(psoc_error) return psoc_error;
+ assert(!psoc_active); psoc_active=1; *out=&psoc; return 0;
+}
+static void osif_psoc_sync_wait_for_ops(void *p) { assert(p==&psoc && psoc_active); waits++; }
+static void osif_psoc_sync_trans_stop(void *p) { assert(p==&psoc && psoc_active); psoc_active=0; }
+static int wma_inject_prepare_mode_stop(void) { assert(psoc_active && waits && !parents); prepares++; return tx_error; }
+static int qdf_status_to_os_return(int q) { return q ? -EAGAIN : 0; }
+static void hdd_pre_mode_change(int m) { (void)m; }
+static int osif_driver_sync_trans_start_wait(struct osif_driver_sync **out) {
+ assert(!psoc_active); parents++; if(driver_error) return driver_error;
+ driver_active=1; *out=&driver; return 0;
+}
+static void osif_driver_sync_wait_for_ops(void *p) { assert(p==&driver && driver_active); }
+static void osif_driver_sync_trans_stop(void *p) { assert(p==&driver && driver_active); driver_active=0; }
+static int __hdd_driver_mode_change(void *p, int m) { assert(p==&ctx && driver_active); (void)m; switches++; return 0; }
+static void reset(void) {
+ memset(&ctx,0,sizeof(ctx)); current=4;
+ invalid_ctx=psoc_error=tx_error=driver_error=0;
+ psoc_active=driver_active=waits=prepares=parents=switches=0;
+}
+'''
+post=r'''
+int main(void) {
+ reset(); tx_error=1;
+ assert(hdd_driver_mode_change(0)==-EAGAIN);
+ assert(prepares==1 && parents==0 && switches==0 && !psoc_active);
+ reset(); psoc_error=-EBUSY;
+ assert(hdd_driver_mode_change(0)==-EBUSY);
+ assert(!prepares && !parents && !switches);
+ reset(); invalid_ctx=-ESHUTDOWN;
+ assert(hdd_driver_mode_change(0)==-ESHUTDOWN);
+ assert(!prepares && !parents && !switches);
+ reset();
+ assert(hdd_driver_mode_change(0)==0);
+ assert(prepares==1 && parents==1 && switches==1 && !psoc_active && !driver_active);
+ reset(); driver_error=-ENOMEM;
+ assert(hdd_driver_mode_change(0)==-ENOMEM);
+ assert(prepares==1 && parents==1 && !switches && !psoc_active);
+ reset(); assert(hdd_driver_mode_change(99)==-EINVAL);
+ assert(!prepares && !parents && !switches);
+ reset(); assert(hdd_driver_mode_change(4)==0); assert(!prepares && switches==1);
+ reset(); current=0; assert(hdd_driver_mode_change(4)==0); assert(!prepares && switches==1);
+ reset(); ctx.driver_status=DRIVER_MODULES_CLOSED;
+ assert(hdd_driver_mode_change(0)==0); assert(!prepares && switches==1);
+ puts("9 production HDD mode handoff cases passed");
+}
+'''
+with tempfile.TemporaryDirectory() as d:
+ c=Path(d)/'test.c';exe=Path(d)/'test'
+ c.write_text(pre+func('hdd_prepare_monitor_mode_stop')+'\n'+func('hdd_driver_mode_change')+post)
+ subprocess.run(['cc','-std=c11','-Wall','-Wextra','-Werror','-fsanitize=undefined,address',str(c),'-o',str(exe)],check=True)
+ subprocess.run([str(exe)],check=True)
