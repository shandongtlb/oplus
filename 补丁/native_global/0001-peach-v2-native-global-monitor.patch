+struct wlan_channel { unsigned ch_freq, ch_width; } channel;
+struct vdev { bool active; } vdev;
+struct wlan_hdd_link_info { struct vdev *vdev; unsigned vdev_id; struct hdd_monitor_ctx monitor; } link;
+struct hdd_adapter { bool up, monitor_mode_vdev_up_in_progress; struct wlan_hdd_link_info *deflink; } adapter;
+struct hdd_context { int unused; } ctx;
+struct wlan_lmac_if_mlme_rx_ops {
