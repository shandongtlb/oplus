+	 * occupied by a frame whose firmware completion has not arrived. */
+	if (status == QDF_STATUS_E_BUSY)
+		return NETDEV_TX_BUSY;
+	if (QDF_IS_STATUS_ERROR(status))
+		hdd_debug_rl("NETHUNTER-INJ: [xmit] inject failed %d (len %u) - see wma reject log",
+			     status, frame_len);
