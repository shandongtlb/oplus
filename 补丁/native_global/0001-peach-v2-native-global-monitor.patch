+++ b/vendor/qcom/opensource/wlan/qcacld-3.0/core/wma/inc/wma_inject_queue.h
@@ -0,0 +1,145 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef WMA_INJECT_QUEUE_H
+#define WMA_INJECT_QUEUE_H
+
+/* All operations require the caller's queue lock. No operation here unmaps
+ * DMA. A forced host drain quarantines a slot until a platform reset fence. */
+#define WMA_INJ_SLOTS 64
+#define WMA_INJ_MAX_INFLIGHT 32
+#define WMA_INJ_GEN_MASK 0x1ffu
+
+enum wma_inj_slot_state {
+	WMA_INJ_FREE,
+	WMA_INJ_QUEUED,
+	WMA_INJ_TX,
+	WMA_INJ_QUARANTINED,
+};
+
+struct wma_inj_slot {
+	enum wma_inj_slot_state state;
+	unsigned short gen;
+	unsigned long long token;
+	bool submitting;
+	bool done;
+};
+
+struct wma_inj_queue {
+	struct wma_inj_slot slots[WMA_INJ_SLOTS];
+	unsigned int fifo[WMA_INJ_SLOTS];
+	unsigned int head, queued, used, inflight, next;
+	unsigned long long serial;
+};
+
+/* Only for a new platform lease: never use reset to recycle uncertain DMA. */
+static inline void wma_inj_queue_reset(struct wma_inj_queue *q)
+{
+	unsigned int i;
+
+	q->head = q->queued = q->used = q->inflight = q->next = 0;
+	for (i = 0; i < WMA_INJ_SLOTS; i++) {
+		q->slots[i].state = WMA_INJ_FREE;
+		q->slots[i].submitting = false;
+		q->slots[i].done = false;
+	}
+}
+
+static inline int wma_inj_queue_claim(struct wma_inj_queue *q)
+{
+	unsigned int n, i;
+	struct wma_inj_slot *s;
+
+	for (n = 0; n < WMA_INJ_SLOTS; n++) {
+		i = (q->next + n) % WMA_INJ_SLOTS;
+		s = &q->slots[i];
+		if (s->state != WMA_INJ_FREE)
+			continue;
+		s->token = ++q->serial;
+		s->state = WMA_INJ_QUEUED;
+		s->done = false;
+		q->fifo[(q->head + q->queued++) % WMA_INJ_SLOTS] = i;
+		q->used++;
+		q->next = (i + 1) % WMA_INJ_SLOTS;
+		return i;
+	}
+	return -1;
+}
+
+static inline int wma_inj_queue_begin(struct wma_inj_queue *q)
+{
+	struct wma_inj_slot *s;
+	unsigned int i;
+
+	if (!q->queued || q->inflight >= WMA_INJ_MAX_INFLIGHT)
+		return -1;
+	i = q->fifo[q->head];
+	q->head = (q->head + 1) % WMA_INJ_SLOTS;
+	q->queued--;
+	q->inflight++;
+	s = &q->slots[i];
+	s->state = WMA_INJ_TX;
+	s->gen = (s->gen + 1) & WMA_INJ_GEN_MASK;
+	s->submitting = true;
+	s->done = false;
+	return i;
+}
+
+static inline bool wma_inj_queue_complete(struct wma_inj_queue *q,
+		unsigned int i, unsigned long long token, bool quarantined)
+{
+	struct wma_inj_slot *s = &q->slots[i];
+
+	if (s->state != WMA_INJ_TX || s->token != token || s->done)
+		return false;
+	s->done = true;
+	q->inflight--;
+	if (quarantined)
+		s->state = WMA_INJ_QUARANTINED;
+	else if (!s->submitting) {
+		s->state = WMA_INJ_FREE;
+		q->used--;
+	}
+	return true;
+}
+
+/* A completion may arrive inside send(). Do not expose the slot to a new
+ * xmit until send has returned and stopped accessing the frame/metadata.
+ * Retry is allowed only after a synchronous failure to submit to firmware. */
+static inline void wma_inj_queue_finish_send(struct wma_inj_queue *q,
+		unsigned int i, bool retry)
+{
+	struct wma_inj_slot *s = &q->slots[i];
+
+	s->submitting = false;
+	if (s->state != WMA_INJ_TX || !s->done)
+		return;
+	if (retry) {
+		q->head = (q->head + WMA_INJ_SLOTS - 1) % WMA_INJ_SLOTS;
+		q->fifo[q->head] = i;
+		q->queued++;
+		s->state = WMA_INJ_QUEUED;
+		s->done = false;
+	} else {
+		s->state = WMA_INJ_FREE;
+		q->used--;
+	}
+}
+
+static inline void wma_inj_queue_drop_head(struct wma_inj_queue *q)
+{
+	unsigned int i = q->fifo[q->head];
+
+	q->head = (q->head + 1) % WMA_INJ_SLOTS;
+	q->queued--;
+	q->used--;
+	q->slots[i].state = WMA_INJ_FREE;
+}
+
+static inline unsigned int wma_inj_queue_drop_pending(struct wma_inj_queue *q)
+{
+	unsigned int count = q->queued;
+
+	while (q->queued)
+		wma_inj_queue_drop_head(q);
+	return count;
+}
+#endif
