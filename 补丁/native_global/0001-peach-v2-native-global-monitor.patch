+static netdev_tx_t hdd_mon_hard_start_xmit(struct sk_buff *skb,
+					   struct net_device *dev)
+{
+	struct hdd_adapter *adapter = WLAN_HDD_GET_PRIV_PTR(dev);
+	struct osif_vdev_sync *vdev_sync;
+	uint8_t *frame;
+	uint32_t frame_len;
+	QDF_STATUS status;
+
+	if (!skb || !adapter || adapter->magic != WLAN_HDD_ADAPTER_MAGIC)
+		goto drop;
+	if (osif_vdev_sync_op_start(dev, &vdev_sync))
+		goto drop;
+	if (cds_get_conparam() != QDF_GLOBAL_MONITOR_MODE ||
+	    !adapter->deflink || skb_linearize(skb))
+		goto stop;
+	if (!hdd_mon_tx_frame(skb, &frame, &frame_len)) {
+		hdd_err_rl("NETHUNTER-INJ: malformed Radiotap or unsupported DATAPAD");
+		goto stop;
+	}
+
+	status = wma_inject_mon_frame(adapter->deflink->vdev_id, dev,
+				      frame, frame_len);
+	osif_vdev_sync_op_stop(vdev_sync);
+	if (status == QDF_STATUS_E_BUSY)
+		return NETDEV_TX_BUSY;
+	goto drop;
+stop:
+	osif_vdev_sync_op_stop(vdev_sync);
+drop:
+	dev_kfree_skb_any(skb);
+	return NETDEV_TX_OK;
+}
