+ reset(); adapter.monitor_mode_vdev_up_in_progress=true; hdd_restore_monitor_injection(&ctx); assert(!ensure_count);
+ reset(); adapter.deflink=NULL; hdd_restore_monitor_injection(&ctx); assert(!ensure_count);
+ reset(); link.vdev=NULL; hdd_restore_monitor_injection(&ctx); assert(!ensure_count);
+ reset(); vdev.active=false; hdd_restore_monitor_injection(&ctx); assert(!ensure_count);
+ reset(); channel_present=false; hdd_restore_monitor_injection(&ctx); assert(!ensure_count);
+ reset(); link.monitor.freq=0; hdd_restore_monitor_injection(&ctx); assert(!ensure_count);
+ reset(); channel.ch_freq=5180; hdd_restore_monitor_injection(&ctx); assert(!ensure_count);
