+ a.monitor_mode_vdev_up_in_progress=true;assert(hdd_mon_get_chandef(&w,&a,&c)==-ENODATA && !refs);a.monitor_mode_vdev_up_in_progress=false;
+ down=true;assert(hdd_mon_get_chandef(&w,&a,&c)==-ENODATA && !refs);down=false;
+ missing=true;assert(hdd_mon_get_chandef(&w,&a,&c)==-ENODATA && !refs);missing=false;
+ absent=true;assert(hdd_mon_get_chandef(&w,&a,&c)==-ENODATA && !refs);absent=false;
