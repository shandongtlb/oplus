+static void mgmt_txrx_external_leave(struct mgmt_txrx_priv_pdev_context *ctx)
+{
+	qdf_spin_lock_bh(&ctx->mgmt_desc_pool.desc_pool_lock);
+	if (!--ctx->external_busy)
+		wake_up_all(&ctx->external_idle);
+	qdf_spin_unlock_bh(&ctx->mgmt_desc_pool.desc_pool_lock);
+}
+
+/* Claim under the pool lock so a firmware completion racing a host drain
+ * cannot release the same descriptor, peer reference or caller context twice.
+ * The caller token also prevents an old completion claiming a reused index. */
+static QDF_STATUS mgmt_txrx_external_finish(
+		struct mgmt_txrx_priv_pdev_context *ctx, uint32_t desc_id,
+		uint64_t cookie, bool check_cookie,
+		enum mgmt_txrx_external_reason reason, uint32_t status)
+{
+	struct mgmt_txrx_desc_elem_t *desc;
+	struct wlan_objmgr_peer *peer;
+	mgmt_txrx_external_cb complete;
+	void *context;
+
+	if (desc_id >= MGMT_DESC_POOL_MAX)
+		return QDF_STATUS_E_INVAL;
+
+	qdf_spin_lock_bh(&ctx->mgmt_desc_pool.desc_pool_lock);
+	desc = &ctx->mgmt_desc_pool.pool[desc_id];
+	if (!desc->in_use || !desc->external_cb ||
+	    desc->external_finishing ||
+	    (check_cookie && desc->external_cookie != cookie)) {
+		qdf_spin_unlock_bh(&ctx->mgmt_desc_pool.desc_pool_lock);
+		return QDF_STATUS_E_INVAL;
+	}
+	desc->external_finishing = true;
+	ctx->external_busy++;
+	complete = desc->external_cb;
+	context = desc->context;
+	cookie = desc->external_cookie;
+	peer = desc->peer;
+	qdf_spin_unlock_bh(&ctx->mgmt_desc_pool.desc_pool_lock);
+
+	/* Give back native ownership before returning the caller's TX credit.
+	 * pdev close joins external_busy before destroying descriptor storage. */
+	wlan_objmgr_peer_release_ref(peer, WLAN_MGMT_NB_ID);
+	wlan_mgmt_txrx_desc_put(ctx, desc_id);
+	complete(context, cookie, reason, status);
+	mgmt_txrx_external_leave(ctx);
+	return QDF_STATUS_SUCCESS;
+}
+
+QDF_STATUS wlan_mgmt_txrx_external_complete(struct wlan_objmgr_pdev *pdev,
+		uint32_t desc_id, uint64_t cookie, uint32_t status)
+{
+	struct mgmt_txrx_priv_pdev_context *ctx;
+
+	if (!pdev)
+		return QDF_STATUS_E_INVAL;
+	ctx = wlan_objmgr_pdev_get_comp_private_obj(pdev,
+						 WLAN_UMAC_COMP_MGMT_TXRX);
+	if (!ctx)
+		return QDF_STATUS_E_INVAL;
+	return mgmt_txrx_external_finish(ctx, desc_id, cookie, true,
+					MGMT_TXRX_EXTERNAL_COMPLETE, status);
+}
+
+QDF_STATUS wlan_mgmt_txrx_external_tx(struct wlan_objmgr_peer *peer,
+		uint64_t cookie, void *context, mgmt_txrx_external_send send,
+		mgmt_txrx_external_cb complete)
+{
+	struct mgmt_txrx_priv_pdev_context *ctx;
+	struct mgmt_txrx_desc_elem_t *desc;
+	struct wlan_objmgr_vdev *vdev;
+	struct wlan_objmgr_pdev *pdev;
+	uint32_t desc_id;
+	QDF_STATUS status;
+
+	if (!peer || !send || !complete)
+		return QDF_STATUS_E_INVAL;
+	status = wlan_objmgr_peer_try_get_ref(peer, WLAN_MGMT_NB_ID);
+	if (QDF_IS_STATUS_ERROR(status))
+		return status;
+	vdev = wlan_peer_get_vdev(peer);
+	pdev = vdev ? wlan_vdev_get_pdev(vdev) : NULL;
+	if (!pdev) {
+		status = QDF_STATUS_E_INVAL;
+		goto release_peer;
+	}
+	ctx = wlan_objmgr_pdev_get_comp_private_obj(pdev,
+						 WLAN_UMAC_COMP_MGMT_TXRX);
+	if (!ctx) {
+		status = QDF_STATUS_E_INVAL;
+		goto release_peer;
+	}
+	qdf_spin_lock_bh(&ctx->mgmt_desc_pool.desc_pool_lock);
+	if (ctx->external_closing) {
+		qdf_spin_unlock_bh(&ctx->mgmt_desc_pool.desc_pool_lock);
+		status = QDF_STATUS_E_AGAIN;
+		goto release_peer;
+	}
+	ctx->external_busy++;
+	qdf_spin_unlock_bh(&ctx->mgmt_desc_pool.desc_pool_lock);
+	desc = wlan_mgmt_txrx_desc_get(ctx);
+	if (!desc) {
+		status = QDF_STATUS_E_RESOURCES;
+		mgmt_txrx_external_leave(ctx);
+		goto release_peer;
+	}
+	desc_id = desc->desc_id;
+	qdf_spin_lock_bh(&ctx->mgmt_desc_pool.desc_pool_lock);
+	desc->nbuf = NULL;
+	desc->peer = peer;
+	desc->vdev_id = wlan_vdev_get_id(vdev);
+	desc->context = context;
+	desc->external_cookie = cookie;
+	desc->external_finishing = false;
+	desc->external_cb = complete;
+	qdf_spin_unlock_bh(&ctx->mgmt_desc_pool.desc_pool_lock);
+
+	/* The sender binds desc_id to its wire cookie before publishing to WMI.
+	 * Firmware may complete before send returns; use saved locals only. */
+	status = send(vdev, desc_id, context);
+	if (QDF_IS_STATUS_ERROR(status))
+		mgmt_txrx_external_finish(ctx, desc_id, cookie, true,
+					 MGMT_TXRX_EXTERNAL_SEND_FAILED, status);
+	mgmt_txrx_external_leave(ctx);
+	return QDF_STATUS_SUCCESS;
+
+release_peer:
+	wlan_objmgr_peer_release_ref(peer, WLAN_MGMT_NB_ID);
+	return status;
+}
+
+static void mgmt_txrx_external_drain_owner(
+		struct mgmt_txrx_priv_pdev_context *ctx, int vdev_id)
+{
+	struct mgmt_txrx_desc_elem_t *desc;
+	uint64_t cookie;
+	uint32_t i;
+	bool match;
+
+	/* Submissions have been joined by the owner. Finish any CPU callback
+	 * already in progress before inspecting descriptor ownership. */
+	wait_event(ctx->external_idle, !READ_ONCE(ctx->external_busy));
+	for (i = 0; i < MGMT_DESC_POOL_MAX; i++) {
+		qdf_spin_lock_bh(&ctx->mgmt_desc_pool.desc_pool_lock);
+		desc = &ctx->mgmt_desc_pool.pool[i];
+		match = desc->in_use && desc->external_cb &&
+			(vdev_id < 0 || desc->vdev_id == vdev_id);
+		cookie = desc->external_cookie;
+		qdf_spin_unlock_bh(&ctx->mgmt_desc_pool.desc_pool_lock);
+		if (match)
+			mgmt_txrx_external_finish(ctx, i, cookie, true,
+						 MGMT_TXRX_EXTERNAL_DRAINED, 0);
+	}
+	wait_event(ctx->external_idle, !READ_ONCE(ctx->external_busy));
+	qdf_spin_lock_bh(&ctx->mgmt_desc_pool.desc_pool_lock);
+	qdf_spin_unlock_bh(&ctx->mgmt_desc_pool.desc_pool_lock);
+}
+
+void wlan_mgmt_txrx_external_drain(struct wlan_objmgr_pdev *pdev,
