+	    frame_len < 24 || frame_len > WMA_INJ_MAX_FRAME ||
+	    (frame[0] & 0x0f) || vdev_id >= wma->max_bssid ||
+	    cds_get_conparam() != QDF_GLOBAL_MONITOR_MODE)
