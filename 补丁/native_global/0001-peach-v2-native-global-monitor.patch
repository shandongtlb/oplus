+#include <linux/moduleparam.h>
+#include <linux/netdevice.h>
+#include <linux/pci.h>
+#include <linux/workqueue.h>
+
+#define INJ_FRAME_SIZE 2048
+#define INJ_CONFIRM_MS 1000
+#define INJ_TX_TIMEOUT_MS 2000
+#define INJ_QUEUE_TIMEOUT_MS 5000
+#define INJ_RETRY_MS 10
+#define INJ_WATCHDOG_MS 50
+#define INJ_WAKE_FREE 8
+#define INJ_STOP_FREE 2
+#define INJ_GEN_SHIFT 6
+#define INJ_SLOT_MASK (WMA_INJ_SLOTS - 1)
+static_assert(MGMT_DESC_POOL_MAX >= WMA_INJ_MAX_INFLIGHT);
+static_assert(MGMT_DESC_POOL_MAX <= 0x8000);
+
+enum inj_state { INJ_STOPPED, INJ_STARTING, INJ_RUNNING,
+		 INJ_QUIESCING, INJ_RESET_REQUIRED };
+enum inj_response { INJ_RSP_NONE, INJ_RSP_START, INJ_RSP_SELF,
+	INJ_RSP_PEER, INJ_RSP_PEER_DELETE, INJ_RSP_STOP, INJ_RSP_DELETE };
+
+static DEFINE_SPINLOCK(inj_lock);
+static DEFINE_MUTEX(inj_lifecycle);
+static DECLARE_COMPLETION(inj_response_done);
+static DECLARE_WAIT_QUEUE_HEAD(inj_idle);
+static struct {
+	enum inj_state state;
+	struct wma_inj_queue q;
+	struct {
+		unsigned long queued_at, submitted_at;
+		uint32_t native_desc;
+		uint16_t len;
+		unsigned int retries;
+		QDF_STATUS send_status;
+	} meta[WMA_INJ_SLOTS];
+	struct workqueue_struct *wq;
+	struct delayed_work work;
+	void *pool;
+	dma_addr_t dma;
+	struct device *dma_dev;
+	bool pool_retired;
+	uint64_t pool_allocs, pool_frees, reset_reclaims;
+	struct wlan_objmgr_vdev *owner;
+	struct wlan_objmgr_peer *peer;
+	struct net_device *netdev;
+	bool queue_stopped;
+	bool reserved, started, self_peer, unicast_peer;
+	uint8_t helper_id, monitor_id;
+	uint8_t mac[QDF_MAC_ADDR_SIZE], target[QDF_MAC_ADDR_SIZE];
+	uint32_t freq;
+	enum inj_response response, response_received;
+	uint32_t response_status, request_id, response_type;
+	uint8_t response_addr[QDF_MAC_ADDR_SIZE];
+	bool recovery_requested;
+	/* Latched across the psoc-to-driver mode-change transaction handoff
+	 * and any intervening SSR. Normal mode teardown clears it. */
+	bool mode_stop;
+	uint64_t accepted, submitted, completed, failed, dropped;
+	uint64_t tx_status[WMI_MGMT_TX_COMP_TYPE_MAX], tx_status_unknown;
+	uint32_t last_tx_status, last_tx_error;
+	uint64_t backpressure, stale, retries, timeouts, drained;
+	uint32_t peak_used, max_completion_ms;
+} inj;
+
+/* Preserve peach flags: probe/auth use ordinary TX, deauth/disassoc use
+ * the previously required flag. This switch is diagnostic, not a TX fix. */
+static bool mon_tx_wrong_key;
+module_param_named(mon_tx_wrong_key, mon_tx_wrong_key, bool, 0600);
+MODULE_PARM_DESC(mon_tx_wrong_key, "Force wrong-key on other management frames");
+
+static bool inject_peer_setup_only;
+module_param(inject_peer_setup_only, bool, 0600);
+MODULE_PARM_DESC(inject_peer_setup_only, "Create injection peers but suppress TX");
+
+/* inj_lifecycle held. One bounded pool pins qcacld until all DMA is complete
+ * or the existing PCI platform has booted fresh firmware. WMA/QDF teardown
+ * alone is not a device fence, and a timeout never frees this memory. */
+static QDF_STATUS inj_pool_alloc(struct device *dev)
+{
+	void *pool;
+	dma_addr_t dma;
+
+	if (inj.pool)
+		return inj.pool_retired ? QDF_STATUS_E_AGAIN : QDF_STATUS_SUCCESS;
+	if (!dev_is_pci(dev) || !try_module_get(THIS_MODULE))
+		return QDF_STATUS_E_NOSUPPORT;
+	get_device(dev);
+	pool = dma_alloc_coherent(dev, WMA_INJ_SLOTS * INJ_FRAME_SIZE,
+				  &dma, GFP_KERNEL);
+	if (!pool) {
+		put_device(dev);
+		module_put(THIS_MODULE);
+		return QDF_STATUS_E_NOMEM;
+	}
+	spin_lock_bh(&inj_lock);
+	inj.pool = pool;
+	inj.dma = dma;
+	inj.dma_dev = dev;
+	inj.pool_retired = false;
+	inj.pool_allocs++;
+	wma_inj_queue_reset(&inj.q);
+	spin_unlock_bh(&inj_lock);
+	return QDF_STATUS_SUCCESS;
+}
+
+/* The sender and callbacks have been joined before a pool is retired. */
+static void inj_pool_retire(bool firmware_restarted)
+{
+	void *pool;
+	struct device *dev;
+	dma_addr_t dma;
+
+	spin_lock_bh(&inj_lock);
+	if (!inj.pool) {
+		spin_unlock_bh(&inj_lock);
+		return;
+	}
+	inj.pool_retired = true;
+	if (inj.q.used && !firmware_restarted) {
+		inj.state = INJ_RESET_REQUIRED;
+		spin_unlock_bh(&inj_lock);
+		return;
+	}
+	if (inj.q.used)
+		inj.reset_reclaims++;
+	pool = inj.pool;
+	dev = inj.dma_dev;
+	dma = inj.dma;
+	inj.pool = NULL;
+	inj.dma_dev = NULL;
+	inj.pool_retired = false;
+	inj.pool_frees++;
+	wma_inj_queue_reset(&inj.q);
+	spin_unlock_bh(&inj_lock);
+	dma_free_coherent(dev, WMA_INJ_SLOTS * INJ_FRAME_SIZE, pool, dma);
+	put_device(dev);
+	/* Caller holds the HDD lifecycle transaction as well as inj_lifecycle;
+	 * module removal must join that transaction before driver teardown. */
+	module_put(THIS_MODULE);
+}
+
+void wma_inject_fw_restarted(struct device *dev)
+{
+	/* Called only from PCI PLD reinit/idle_restart, after the existing CNSS
+	 * MHI boot + firmware-ready handshake, before new WMA work is admitted.
+	 * Never call this on fw_down, host shutdown, or a recovery request. */
+	mutex_lock(&inj_lifecycle);
+	if (inj.pool_retired && inj.dma_dev == dev && !inj.owner && !inj.wq) {
+		inj_pool_retire(true);
+		spin_lock_bh(&inj_lock);
+		inj.state = INJ_STOPPED;
+		inj.recovery_requested = false;
+		spin_unlock_bh(&inj_lock);
+		wma_info("NETHUNTER-INJ: retired pool released after fresh firmware boot");
+	}
+	mutex_unlock(&inj_lifecycle);
+}
+
+static bool inj_fw_ready(tp_wma_handle wma)
+{
+	return wma && wma->wmi_handle && cds_is_target_ready() &&
+		!cds_is_driver_recovering() && !cds_is_fw_down() &&
+		!cds_is_driver_state_module_stop() && !cds_is_target_asserting() &&
+		!wmi_is_blocked(wma->wmi_handle);
+}
+
+/* Must hold inj_lock. Stop and wake use the same lock as admission, so a
+ * completion cannot be lost between checking capacity and stopping queues. */
+static void inj_flow_update(void)
+{
+	if (!inj.netdev)
+		return;
+	if (!netif_running(inj.netdev) || inj.state != INJ_RUNNING ||
+	    inj.q.used >= WMA_INJ_SLOTS - INJ_STOP_FREE) {
+		netif_tx_stop_all_queues(inj.netdev);
+		inj.queue_stopped = true;
+	} else if (inj.queue_stopped &&
+		   inj.q.used <= WMA_INJ_SLOTS - INJ_WAKE_FREE) {
+		inj.queue_stopped = false;
+		netif_tx_wake_all_queues(inj.netdev);
+	}
+}
+
+/* Serialize admin-up / channel resume with admission and completion. */
+void wma_inject_resume(struct net_device *dev)
+{
+	spin_lock_bh(&inj_lock);
+	if (inj.state == INJ_RUNNING && netif_running(dev) &&
+	    cds_get_conparam() == QDF_GLOBAL_MONITOR_MODE &&
+	    (!inj.netdev || inj.netdev == dev)) {
+		if (!inj.netdev) {
+			dev_hold(dev);
+			inj.netdev = dev;
+		}
+		netif_carrier_on(dev);
+		inj.queue_stopped = true;
+		inj_flow_update();
+	}
+	spin_unlock_bh(&inj_lock);
+}
+
+static void inj_kick(unsigned int delay_ms)
+{
+	if (inj.state == INJ_RUNNING && inj.wq)
+		mod_delayed_work(inj.wq, &inj.work, msecs_to_jiffies(delay_ms));
+}
+
+static void inj_fault(const char *why)
+{
+	bool recover = false;
+
+	spin_lock_bh(&inj_lock);
+	inj.state = INJ_RESET_REQUIRED;
+	inj.dropped += wma_inj_queue_drop_pending(&inj.q);
+	inj_flow_update();
+	if (!inj.recovery_requested) {
+		inj.recovery_requested = true;
+		recover = true;
+	}
+	spin_unlock_bh(&inj_lock);
+	if (recover && !cds_is_driver_unloading() &&
+	    !cds_is_driver_state_module_stop() && !cds_is_driver_recovering() &&
+	    !cds_is_fw_down()) {
+		wma_err("NETHUNTER-INJ: %s; DMA retained, requesting WLAN recovery", why);
+		/* This only queues recovery. Never wait for a recovery transaction
+		 * while holding the monitor/lifecycle transaction or joining work. */
+		cds_trigger_recovery(QDF_TX_DESC_LEAK);
+	}
+}
+
+static int inj_stats_get(char *buf, const struct kernel_param *kp)
+{
+	int n;
+
+	spin_lock_bh(&inj_lock);
+	n = scnprintf(buf, PAGE_SIZE,
+		"state=%u accepted=%llu submitted=%llu completed=%llu failed=%llu dropped=%llu backpressure=%llu stale=%llu retries=%llu timeouts=%llu drained=%llu queued=%u inflight=%u used=%u peak=%u max_completion_ms=%u pool_allocs=%llu pool_frees=%llu retained=%u reset_reclaims=%llu stopping=%u\n",
+		inj.state, inj.accepted, inj.submitted, inj.completed, inj.failed,
+		inj.dropped, inj.backpressure, inj.stale, inj.retries,
+		inj.timeouts, inj.drained, inj.q.queued, inj.q.inflight,
+		inj.q.used, inj.peak_used, inj.max_completion_ms,
+		inj.pool_allocs, inj.pool_frees, inj.pool_retired, inj.reset_reclaims,
+		inj.mode_stop);
+	spin_unlock_bh(&inj_lock);
+	return n;
+}
+static const struct kernel_param_ops inj_stats_ops = { .get = inj_stats_get };
+module_param_cb(inject_stats, &inj_stats_ops, NULL, 0400);
+
+/* Raw firmware completion status only. Host send failures, forced drains
+ * and stale callbacks must not look like firmware success or NO_ACK. */
+static int inj_tx_status_get(char *buf, const struct kernel_param *kp)
+{
+	int n;
+
+	spin_lock_bh(&inj_lock);
+	n = scnprintf(buf, PAGE_SIZE,
+		"completed=%llu failed=%llu ok=%llu discard=%llu inspect=%llu no_ack=%llu unknown=%llu last_status=%u last_error=%u\n",
+		inj.completed, inj.failed,
+		inj.tx_status[WMI_MGMT_TX_COMP_TYPE_COMPLETE_OK],
+		inj.tx_status[WMI_MGMT_TX_COMP_TYPE_DISCARD],
+		inj.tx_status[WMI_MGMT_TX_COMP_TYPE_INSPECT],
+		inj.tx_status[WMI_MGMT_TX_COMP_TYPE_COMPLETE_NO_ACK],
+		inj.tx_status_unknown, inj.last_tx_status, inj.last_tx_error);
+	spin_unlock_bh(&inj_lock);
+	return n;
+}
+static const struct kernel_param_ops inj_tx_status_ops = {
+	.get = inj_tx_status_get,
+};
+module_param_cb(inject_tx_status, &inj_tx_status_ops, NULL, 0400);
+MODULE_PARM_DESC(inject_tx_status, "Injection firmware completion status counters");
+
+/* The response callbacks also consume unsolicited/late replies for a reserved
+ * helper. A timed-out helper ID is never recycled before WLAN reset. */
+static bool inj_control_response(uint8_t id, enum inj_response kind,
+				 const uint8_t *addr, uint32_t status)
+{
+	bool handled;
+
+	spin_lock_bh(&inj_lock);
+	handled = inj.reserved && inj.helper_id == id;
+	if (handled && inj.response == kind &&
+	    (!addr || ether_addr_equal(inj.response_addr, addr))) {
+		inj.response_status = status;
+		inj.response_received = kind;
+		inj.response = INJ_RSP_NONE;
+		complete_all(&inj_response_done);
+	}
+	spin_unlock_bh(&inj_lock);
+	return handled;
+}
+
+static bool inj_start_response(struct wlan_objmgr_psoc *psoc,
+			       struct vdev_start_response *rsp)
+{
+	bool handled;
+
+	if (!rsp)
+		return false;
+	spin_lock_bh(&inj_lock);
+	handled = inj.reserved && inj.helper_id == rsp->vdev_id;
+	if (handled && inj.response == INJ_RSP_START &&
+	    (!rsp->requestor_id || rsp->requestor_id == inj.request_id) &&
+	    rsp->resp_type == inj.response_type) {
+		inj.response_status = rsp->status;
+		inj.response_received = INJ_RSP_START;
+		inj.response = INJ_RSP_NONE;
+		complete_all(&inj_response_done);
+	}
+	spin_unlock_bh(&inj_lock);
+	return handled;
+}
+
+static bool inj_stop_response(struct wlan_objmgr_psoc *psoc,
+			      struct vdev_stop_response *rsp)
+{
+	return rsp && inj_control_response(rsp->vdev_id, INJ_RSP_STOP, NULL, 0);
+}
+
+static bool inj_delete_response(struct wlan_objmgr_psoc *psoc,
+				struct vdev_delete_response *rsp)
+{
+	return rsp && inj_control_response(rsp->vdev_id, INJ_RSP_DELETE, NULL, 0);
+}
+
+bool wma_inject_peer_create_confirm(uint8_t id, const uint8_t *addr,
+				    uint32_t status)
+{
+	enum inj_response kind;
+
+	spin_lock_bh(&inj_lock);
+	kind = inj.response == INJ_RSP_SELF ? INJ_RSP_SELF : INJ_RSP_PEER;
+	spin_unlock_bh(&inj_lock);
+	return addr && inj_control_response(id, kind, addr, status);
+}
+
+bool wma_inject_peer_delete_confirm(uint8_t id, const uint8_t *addr)
+{
+	return addr && inj_control_response(id, INJ_RSP_PEER_DELETE, addr, 0);
+}
+
+static void inj_expect(enum inj_response kind, const uint8_t *addr)
+{
+	spin_lock_bh(&inj_lock);
+	reinit_completion(&inj_response_done);
+	inj.response = kind;
+	inj.response_received = INJ_RSP_NONE;
+	inj.response_status = ~0U;
+	if (addr)
+		ether_addr_copy(inj.response_addr, addr);
+	spin_unlock_bh(&inj_lock);
+}
+
+static QDF_STATUS inj_wait(tp_wma_handle wma, QDF_STATUS status,
+			   enum inj_response kind)
+{
+	unsigned long done = 0;
+	uint32_t fw_status;
+
+	if (QDF_IS_STATUS_SUCCESS(status))
+		done = wait_for_completion_timeout(&inj_response_done,
+						 msecs_to_jiffies(INJ_CONFIRM_MS));
+	spin_lock_bh(&inj_lock);
+	fw_status = inj.response_status;
+	if (!done || inj.response_received != kind ||
+	    (fw_status && !(kind == INJ_RSP_SELF && fw_status == WMI_PEER_EXISTS)) ||
+	    !inj_fw_ready(wma)) {
+		inj.state = INJ_RESET_REQUIRED;
+		if (QDF_IS_STATUS_SUCCESS(status))
+			status = QDF_STATUS_E_FAILURE;
+	}
+	inj.response = INJ_RSP_NONE;
+	inj.response_received = INJ_RSP_NONE;
+	spin_unlock_bh(&inj_lock);
+	if (QDF_IS_STATUS_ERROR(status))
+		wma_err("NETHUNTER-INJ: control failed kind=%u host=%u fw=%u", kind, status, fw_status);
+	return status;
+}
+
+static QDF_STATUS inj_peer_command(tp_wma_handle wma, const uint8_t *addr,
+				  bool create, bool self)
+{
+	struct peer_create_params c = {0};
+	struct peer_delete_cmd_params d = {0};
+	enum inj_response kind = create ? (self ? INJ_RSP_SELF : INJ_RSP_PEER) :
+		INJ_RSP_PEER_DELETE;
+	QDF_STATUS status;
+
+	if (!inj_fw_ready(wma))
+		return QDF_STATUS_E_AGAIN;
+	inj_expect(kind, addr);
+	if (create) {
+		c.vdev_id = inj.helper_id;
+		c.peer_addr = (uint8_t *)addr;
+		c.peer_type = WMI_PEER_TYPE_DEFAULT;
+		status = wmi_unified_peer_create_send(wma->wmi_handle, &c);
+	} else {
+		d.vdev_id = inj.helper_id;
+		status = wmi_unified_peer_delete_send(wma->wmi_handle,
+						      (uint8_t *)addr, &d);
+	}
+	return inj_wait(wma, status, kind);
+}
+
+static QDF_STATUS inj_start(tp_wma_handle wma, uint32_t freq, bool restart)
+{
+	struct vdev_start_params p = {0};
+	uint8_t power = wlan_reg_get_channel_reg_power_for_freq(wma->pdev, freq);
+
+	p.vdev_id = inj.helper_id;
+	p.channel.mhz = freq;
+	p.channel.cfreq1 = freq;
+	p.channel.phy_mode = (enum wlan_phymode)wmi_host_to_fw_phymode(
+		WLAN_REG_IS_24GHZ_CH_FREQ(freq) ? WLAN_PHYMODE_11G : WLAN_PHYMODE_11A);
+	p.channel.maxpower = power;
+	p.channel.maxregpower = power;
+	p.is_restart = restart;
+	spin_lock_bh(&inj_lock);
+	p.requestor_id = ++inj.request_id;
+	inj.response_type = restart ? WMI_HOST_VDEV_RESTART_RESP_EVENT :
+		WMI_HOST_VDEV_START_RESP_EVENT;
+	spin_unlock_bh(&inj_lock);
+	inj_expect(INJ_RSP_START, NULL);
+	return inj_wait(wma, wmi_unified_vdev_start_send(wma->wmi_handle, &p),
+			INJ_RSP_START);
+}
+
+static QDF_STATUS inj_stop(tp_wma_handle wma)
+{
+	struct vdev_stop_params p = {0};
+
+	p.vdev_id = inj.helper_id;
+	inj_expect(INJ_RSP_STOP, NULL);
+	return inj_wait(wma, wmi_unified_vdev_stop_send(wma->wmi_handle, &p),
+			INJ_RSP_STOP);
+}
+
+static QDF_STATUS inj_delete(tp_wma_handle wma)
+{
+	inj_expect(INJ_RSP_DELETE, NULL);
+	return inj_wait(wma,
+		wmi_unified_vdev_delete_send(wma->wmi_handle, inj.helper_id),
+		INJ_RSP_DELETE);
+}
+
+static void inj_native_complete(void *context, uint64_t token,
+		enum mgmt_txrx_external_reason reason, uint32_t status)
+{
+	struct wma_inj_slot *slot = context;
+	unsigned int i = slot - inj.q.slots;
+	unsigned int elapsed;
+
+	spin_lock_bh(&inj_lock);
+	if (!wma_inj_queue_complete(&inj.q, i, token,
+				   reason == MGMT_TXRX_EXTERNAL_DRAINED)) {
+		inj.stale++;
+		goto out;
+	}
+	if (reason == MGMT_TXRX_EXTERNAL_COMPLETE) {
+		inj.completed++;
+		if (inj.completed <= 8 || !(inj.completed % 256) ||
+		    status != inj.last_tx_status)
+			wma_info("NETHUNTER-INJ: [completion] #%llu status=%u inflight=%u",
+				 inj.completed, status, inj.q.inflight);
+		inj.last_tx_status = status;
+		if (status < ARRAY_SIZE(inj.tx_status))
+			inj.tx_status[status]++;
+		else
+			inj.tx_status_unknown++;
+		elapsed = jiffies_to_msecs(jiffies - inj.meta[i].submitted_at);
+		inj.max_completion_ms = max(inj.max_completion_ms, elapsed);
+		if (status) {
+			inj.failed++;
+			inj.last_tx_error = status;
+		}
+	} else if (reason == MGMT_TXRX_EXTERNAL_SEND_FAILED) {
+		inj.meta[i].send_status = status;
+	} else {
+		inj.drained++;
+		/* Host cancellation is NOT completion of device DMA. */
+		inj.state = INJ_RESET_REQUIRED;
+	}
+	inj_flow_update();
+	inj_kick(0);
+	wake_up_all(&inj_idle);
+out:
+	spin_unlock_bh(&inj_lock);
+}
+
+void wma_inject_handle_completion(void *handle, uint32_t desc_id, uint32_t status)
+{
+	unsigned int i = desc_id & INJ_SLOT_MASK;
+	struct wma_inj_slot *slot = &inj.q.slots[i];
+	struct wlan_objmgr_pdev *pdev = NULL;
+	uint64_t token = 0;
+	uint32_t native_desc = 0;
+
+	spin_lock_bh(&inj_lock);
+	if (!(desc_id & ~0xffffU) && slot->state == WMA_INJ_TX && !slot->done &&
+	    slot->gen == ((desc_id >> INJ_GEN_SHIFT) & WMA_INJ_GEN_MASK) && inj.owner) {
+		pdev = wlan_vdev_get_pdev(inj.owner);
+		if (QDF_IS_STATUS_ERROR(wlan_objmgr_pdev_try_get_ref(pdev,
+							 WLAN_LEGACY_WMA_ID)))
+			pdev = NULL;
+		token = slot->token;
+		native_desc = inj.meta[i].native_desc;
+	} else {
+		inj.stale++;
+	}
+	spin_unlock_bh(&inj_lock);
+	if (pdev) {
+		wlan_mgmt_txrx_external_complete(pdev, native_desc, token, status);
+		wlan_objmgr_pdev_release_ref(pdev, WLAN_LEGACY_WMA_ID);
+	}
+}
+
+static QDF_STATUS inj_native_send(struct wlan_objmgr_vdev *owner,
+				 uint32_t desc_id, void *context)
+{
+	tp_wma_handle wma = cds_get_context(QDF_MODULE_ID_WMA);
+	struct wma_inj_slot *slot = context;
+	unsigned int i = slot - inj.q.slots;
+	struct wmi_mgmt_params p = {0};
+	uint8_t *frame;
+	QDF_STATUS status;
+
+	spin_lock_bh(&inj_lock);
+	if (inj.state != INJ_RUNNING || !inj_fw_ready(wma)) {
+		spin_unlock_bh(&inj_lock);
+		return QDF_STATUS_E_AGAIN;
+	}
+	inj.meta[i].native_desc = desc_id;
+	inj.meta[i].submitted_at = jiffies;
+	p.frm_len = inj.meta[i].len;
+	p.vdev_id = inj.helper_id;
+	p.chanfreq = inj.freq;
+	p.desc_id = 0x8000 | (slot->gen << INJ_GEN_SHIFT) | i;
+	frame = (uint8_t *)inj.pool + i * INJ_FRAME_SIZE;
+	p.pdata = frame;
+	p.dma_pre_mapped = true;
+	p.dma_address = inj.dma + i * INJ_FRAME_SIZE;
+	p.tx_flags = (frame[0] == 0xc0 || frame[0] == 0xa0 ||
+		      READ_ONCE(mon_tx_wrong_key)) ? MGMT_TX_USE_INCORRECT_KEY : 0;
+	spin_unlock_bh(&inj_lock);
+	/* The lifecycle joins this worker before touching helper/pool/owner.
+	 * Do not hold a queue spinlock over native accounting or WMI submission. */
+	status = wmi_mgmt_unified_cmd_send(wma->wmi_handle, &p);
+	spin_lock_bh(&inj_lock);
+	if (QDF_IS_STATUS_SUCCESS(status)) {
+		inj.submitted++;
+		if (inj.submitted <= 8 || !(inj.submitted % 256))
+			wma_info("NETHUNTER-INJ: [submit] #%llu owner=%u helper=%u desc=%u chan=%u len=%u fc=0x%02x flags=%u",
+				 inj.submitted, inj.monitor_id, p.vdev_id,
+				 p.desc_id, p.chanfreq, p.frm_len, frame[0], p.tx_flags);
+	}
+	spin_unlock_bh(&inj_lock);
+	return status;
+}
+
+static bool inj_expired(void)
+{
+	unsigned int i;
+
+	for (i = 0; i < WMA_INJ_SLOTS; i++)
+		if (inj.q.slots[i].state == WMA_INJ_TX && !inj.q.slots[i].done &&
+		    time_after_eq(jiffies, inj.meta[i].submitted_at +
+				  msecs_to_jiffies(INJ_TX_TIMEOUT_MS)))
+			return true;
+	return false;
+}
+
+static void inj_worker(struct work_struct *work)
+{
+	tp_wma_handle wma = cds_get_context(QDF_MODULE_ID_WMA);
+	uint8_t target[QDF_MAC_ADDR_SIZE];
+	struct wma_inj_slot *slot;
+	QDF_STATUS status;
+	unsigned int budget = WMA_INJ_MAX_INFLIGHT;
+	int i;
+	bool unicast, change, retry;
+
+	while (budget--) {
+		spin_lock_bh(&inj_lock);
+		if (inj.state != INJ_RUNNING) {
+			spin_unlock_bh(&inj_lock);
+			return;
+		}
+		if (!inj_fw_ready(wma)) {
+			spin_unlock_bh(&inj_lock);
+			inj_fault("firmware unavailable");
+			return;
+		}
+		if (inj_expired()) {
+			inj.timeouts++;
+			spin_unlock_bh(&inj_lock);
+			inj_fault("TX completion timeout");
+			return;
+		}
+		/* Administrative down is a host pause, not a DMA fence. Discard
+		 * only unsent frames and keep the in-flight watchdog running.
+		 */
+		if (inj.netdev && !netif_running(inj.netdev))
+			inj.dropped += wma_inj_queue_drop_pending(&inj.q);
+		if (!inj.q.queued || inj.q.inflight >= WMA_INJ_MAX_INFLIGHT) {
+			if (inj.q.inflight)
+				inj_kick(INJ_WATCHDOG_MS);
+			spin_unlock_bh(&inj_lock);
+			return;
+		}
+		i = inj.q.fifo[inj.q.head];
+		if (time_after_eq(jiffies, inj.meta[i].queued_at +
+				  msecs_to_jiffies(INJ_QUEUE_TIMEOUT_MS))) {
+			wma_inj_queue_drop_head(&inj.q);
+			inj.dropped++;
+			inj_flow_update();
+			spin_unlock_bh(&inj_lock);
+			continue;
+		}
+		ether_addr_copy(target, (uint8_t *)inj.pool + i * INJ_FRAME_SIZE + 4);
+		unicast = !is_multicast_ether_addr(target);
+		change = unicast && (!inj.unicast_peer ||
+					!ether_addr_equal(inj.target, target));
+		/* FIFO prevents broadcast/hot traffic from bypassing a peer change.
+		 * No old-peer submissions can start once it reaches the queue head. */
+		if (change && inj.q.inflight) {
+			inj_kick(INJ_WATCHDOG_MS);
+			spin_unlock_bh(&inj_lock);
+			return;
+		}
+		spin_unlock_bh(&inj_lock);
+		if (change) {
+			if (inj.unicast_peer) {
+				status = inj_peer_command(wma, inj.target, false, false);
+				if (QDF_IS_STATUS_ERROR(status))
+					goto control_failed;
+				inj.unicast_peer = false;
+			}
+			status = inj_peer_command(wma, target, true, false);
+			if (QDF_IS_STATUS_ERROR(status))
+				goto control_failed;
+			ether_addr_copy(inj.target, target);
+			inj.unicast_peer = true;
+		}
+		spin_lock_bh(&inj_lock);
+		if (inj.state != INJ_RUNNING) {
+			spin_unlock_bh(&inj_lock);
+			return;
+		}
+		if (inj.netdev && !netif_running(inj.netdev)) {
+			inj.dropped += wma_inj_queue_drop_pending(&inj.q);
+			if (inj.q.inflight)
+				inj_kick(INJ_WATCHDOG_MS);
+			spin_unlock_bh(&inj_lock);
+			return;
+		}
+		i = wma_inj_queue_begin(&inj.q);
+		if (i < 0) {
+			spin_unlock_bh(&inj_lock);
+			return;
+		}
+		slot = &inj.q.slots[i];
+		inj.meta[i].send_status = QDF_STATUS_SUCCESS;
+		inj.meta[i].submitted_at = jiffies;
+		spin_unlock_bh(&inj_lock);
+		if (READ_ONCE(inject_peer_setup_only)) {
+			status = QDF_STATUS_E_CANCELED;
+		} else {
+			status = wlan_mgmt_txrx_external_tx(inj.peer, slot->token,
+					slot, inj_native_send, inj_native_complete);
+		}
+		spin_lock_bh(&inj_lock);
+		if (QDF_IS_STATUS_ERROR(status)) {
+			/* Native reservation failed: no callback and no device DMA. */
+			wma_inj_queue_complete(&inj.q, i, slot->token, false);
+			inj.meta[i].send_status = status;
+		}
+		retry = QDF_IS_STATUS_ERROR(inj.meta[i].send_status) &&
+			!READ_ONCE(inject_peer_setup_only) && inj.state == INJ_RUNNING &&
+			time_before(jiffies, inj.meta[i].queued_at +
+				    msecs_to_jiffies(INJ_QUEUE_TIMEOUT_MS));
+		if (retry) {
+			inj.retries++;
+			inj.meta[i].retries++;
+		} else if (QDF_IS_STATUS_ERROR(inj.meta[i].send_status)) {
+			inj.dropped++;
+		}
+		wma_inj_queue_finish_send(&inj.q, i, retry);
+		inj_flow_update();
+		if (retry) {
+			inj_kick(INJ_RETRY_MS);
+			spin_unlock_bh(&inj_lock);
+			return;
+		}
+		spin_unlock_bh(&inj_lock);
+	}
+	spin_lock_bh(&inj_lock);
+	if (inj.q.queued || inj.q.inflight)
+		inj_kick(inj.q.queued ? 0 : INJ_WATCHDOG_MS);
+	spin_unlock_bh(&inj_lock);
+	return;
+control_failed:
+	inj_fault("peer transition failed");
+}
+
+QDF_STATUS wma_inject_mon_frame(uint8_t vdev_id, struct net_device *dev,
+				const uint8_t *frame, uint32_t len)
+{
+	int i;
+
+	if (!frame || !dev || !netif_running(dev) || len < 24 ||
+	    len > INJ_FRAME_SIZE || (frame[0] & 0x0f) ||
+	    cds_get_conparam() != QDF_GLOBAL_MONITOR_MODE)
+		return QDF_STATUS_E_INVAL;
+	spin_lock_bh(&inj_lock);
+	if (inj.state != INJ_RUNNING || inj.monitor_id != vdev_id || !inj.pool ||
+	    (inj.netdev && inj.netdev != dev)) {
+		spin_unlock_bh(&inj_lock);
+		return QDF_STATUS_E_AGAIN;
+	}
+	if (!inj.netdev) {
+		dev_hold(dev);
+		inj.netdev = dev;
+	}
+	i = wma_inj_queue_claim(&inj.q);
+	if (i < 0) {
+		inj.backpressure++;
+		inj_flow_update();
+		spin_unlock_bh(&inj_lock);
+		return QDF_STATUS_E_BUSY;
+	}
+	/* This is the only payload copy. FREE -> QUEUED transfers CPU ownership;
+	 * a TX or quarantined buffer is never overwritten. */
+	memcpy((uint8_t *)inj.pool + i * INJ_FRAME_SIZE, frame, len);
+	inj.meta[i].len = len;
+	inj.meta[i].queued_at = jiffies;
+	inj.meta[i].retries = 0;
+	inj.accepted++;
+	inj.peak_used = max(inj.peak_used, inj.q.used);
+	inj_flow_update();
+	inj_kick(0);
+	spin_unlock_bh(&inj_lock);
+	return QDF_STATUS_SUCCESS;
+}
+
+static bool inj_wait_tx(void)
+{
+	bool idle;
+
+	wait_event_timeout(inj_idle, !READ_ONCE(inj.q.inflight),
+			   msecs_to_jiffies(INJ_TX_TIMEOUT_MS));
+	spin_lock_bh(&inj_lock);
+	idle = !inj.q.inflight;
+	spin_unlock_bh(&inj_lock);
+	return idle;
+}
+
+/* lifecycle mutex held; stop admission before joining the only sender. */
+static void inj_quiesce(void)
+{
+	spin_lock_bh(&inj_lock);
+	if (inj.state != INJ_RESET_REQUIRED)
+		inj.state = INJ_QUIESCING;
+	inj_flow_update();
+	spin_unlock_bh(&inj_lock);
+	if (inj.wq)
+		cancel_delayed_work_sync(&inj.work);
+	spin_lock_bh(&inj_lock);
+	inj.dropped += wma_inj_queue_drop_pending(&inj.q);
+	spin_unlock_bh(&inj_lock);
+}
+
+static void inj_release_owner(void)
+{
+	struct wlan_objmgr_vdev *owner;
+	struct wlan_objmgr_peer *peer;
+	struct net_device *dev;
+
+	if (inj.owner)
+		wlan_mgmt_txrx_external_drain(wlan_vdev_get_pdev(inj.owner),
+					    inj.monitor_id);
+	spin_lock_bh(&inj_lock);
+	owner = inj.owner;
+	peer = inj.peer;
+	dev = inj.netdev;
+	inj.owner = NULL;
+	inj.peer = NULL;
+	inj.netdev = NULL;
+	inj.queue_stopped = false;
+	spin_unlock_bh(&inj_lock);
+	if (peer)
+		wlan_objmgr_peer_release_ref(peer, WLAN_LEGACY_WMA_ID);
+	if (owner)
+		wlan_objmgr_vdev_release_ref(owner, WLAN_LEGACY_WMA_ID);
+	if (dev)
+		dev_put(dev);
+}
+
+static void inj_destroy_locked(void)
+{
+	tp_wma_handle wma = cds_get_context(QDF_MODULE_ID_WMA);
+	bool clean = inj.state != INJ_RESET_REQUIRED;
+
+	inj_quiesce();
+	if (!inj.reserved)
+		goto release;
+	if (inj.state == INJ_RESET_REQUIRED || !inj_fw_ready(wma)) {
+		clean = false;
+		goto release;
+	}
+	if (!inj_wait_tx()) {
+		spin_lock_bh(&inj_lock);
+		inj.timeouts++;
+		spin_unlock_bh(&inj_lock);
+		clean = false;
+		goto release;
+	}
+	if (inj.unicast_peer) {
+		if (QDF_IS_STATUS_ERROR(inj_peer_command(wma, inj.target, false, false))) {
+			clean = false;
+			goto release;
+		}
+		inj.unicast_peer = false;
+	}
+	if (inj.self_peer) {
+		if (QDF_IS_STATUS_ERROR(inj_peer_command(wma, inj.mac, false, true))) {
+			clean = false;
+			goto release;
+		}
+		inj.self_peer = false;
+	}
+	if (inj.started && QDF_IS_STATUS_ERROR(inj_stop(wma))) {
+		clean = false;
+		goto release;
+	}
+	inj.started = false;
+	if (QDF_IS_STATUS_ERROR(inj_delete(wma))) {
+		clean = false;
+		goto release;
+	}
+	spin_lock_bh(&inj_lock);
+	inj.reserved = false;
+	spin_unlock_bh(&inj_lock);
+release:
+	/* A forced native drain only releases host references; ambiguous slots
+	 * remain QUARANTINED in the module-owned pool after WMA disappears. */
+	inj_release_owner();
+	spin_lock_bh(&inj_lock);
+	inj.state = clean ? INJ_STOPPED : INJ_RESET_REQUIRED;
+	spin_unlock_bh(&inj_lock);
+	if (!clean && inj_fw_ready(wma))
+		inj_fault("quiesce could not confirm firmware ownership release");
+}
+
+QDF_STATUS wma_inject_destroy_tx_vdev(void)
+{
+	QDF_STATUS status;
+
+	mutex_lock(&inj_lifecycle);
+	inj_destroy_locked();
+	status = inj.state == INJ_STOPPED ? QDF_STATUS_SUCCESS :
+		 QDF_STATUS_E_AGAIN;
+	mutex_unlock(&inj_lifecycle);
+	return status;
+}
+
+QDF_STATUS wma_inject_prepare_mode_stop(void)
+{
+	tp_wma_handle wma = cds_get_context(QDF_MODULE_ID_WMA);
+	QDF_STATUS status;
+
+	/* Caller owns a psoc transaction, outside RTNL and before queuing a
+	 * driver transaction. SSR can queue behind us and run after we return
+	 * an error; it must not be rejected by a parent driver transaction. */
+	mutex_lock(&inj_lifecycle);
+	spin_lock_bh(&inj_lock);
+	inj.mode_stop = true;
+	spin_unlock_bh(&inj_lock);
+	inj_destroy_locked();
+	status = inj.state == INJ_STOPPED && inj_fw_ready(wma) ?
+		 QDF_STATUS_SUCCESS : QDF_STATUS_E_AGAIN;
+	mutex_unlock(&inj_lifecycle);
+
+	return status;
+}
+
+static QDF_STATUS inj_acquire_owner(tp_wma_handle wma, uint8_t id)
+{
+	struct wlan_objmgr_vdev *vdev = wma->interfaces[id].vdev;
+	struct wlan_objmgr_peer *peer;
+
+	if (!vdev || QDF_IS_STATUS_ERROR(wlan_objmgr_vdev_try_get_ref(vdev,
+							 WLAN_LEGACY_WMA_ID)))
+		return QDF_STATUS_E_INVAL;
+	peer = wlan_vdev_get_selfpeer(vdev);
+	if (!peer || QDF_IS_STATUS_ERROR(wlan_objmgr_peer_try_get_ref(peer,
+							 WLAN_LEGACY_WMA_ID))) {
+		wlan_objmgr_vdev_release_ref(vdev, WLAN_LEGACY_WMA_ID);
+		wma_err("NETHUNTER-INJ: monitor self-peer unavailable");
+		return QDF_STATUS_E_INVAL;
+	}
+	spin_lock_bh(&inj_lock);
+	inj.owner = vdev;
+	inj.peer = peer;
+	inj.monitor_id = id;
+	spin_unlock_bh(&inj_lock);
+	return QDF_STATUS_SUCCESS;
+}
+
+static QDF_STATUS inj_ensure_locked(uint8_t id, uint32_t freq)
+{
+	tp_wma_handle wma = cds_get_context(QDF_MODULE_ID_WMA);
+	struct wlan_lmac_if_mlme_rx_ops *rx;
+	struct vdev_create_params p = {0};
+	struct wlan_channel *channel;
+	target_resource_config *res;
+	QDF_STATUS status;
+	int i, attempt, max_id;
+	bool collision;
+
+	if (!inj_fw_ready(wma) || !wma->qdf_dev || !freq || id >= wma->max_bssid)
+		return QDF_STATUS_E_AGAIN;
+	if (!wmi_service_enabled(wma->wmi_handle, wmi_service_mgmt_tx_wmi) ||
+	    !wmi_service_enabled(wma->wmi_handle, wmi_service_peer_create_conf) ||
+	    !wmi_service_enabled(wma->wmi_handle, wmi_service_sync_delete_cmds))
+		return QDF_STATUS_E_NOSUPPORT;
+	/* Validate again for SSR callers, using the confirmed monitor owner.
+	 * Unsupported RX widths/bands must never produce a mismatched helper.
+	 */
+	if (cds_get_conparam() != QDF_GLOBAL_MONITOR_MODE ||
+	    !wma->interfaces[id].vdev ||
+	    wma->interfaces[id].type != WMI_VDEV_TYPE_MONITOR ||
+	    !wma->interfaces[id].vdev_active)
+		return QDF_STATUS_E_INVAL;
+	channel = wlan_vdev_mlme_get_des_chan(wma->interfaces[id].vdev);
+	if (!channel || channel->ch_width != CH_WIDTH_20MHZ ||
+	    channel->ch_freq != freq ||
+	    freq == 2484 ||
+	    (!WLAN_REG_IS_24GHZ_CH_FREQ(freq) && !WLAN_REG_IS_5GHZ_CH_FREQ(freq)) ||
+	    wlan_reg_get_channel_state_for_pwrmode(wma->pdev, freq,
+						 REG_CURRENT_PWR_MODE) != CHANNEL_STATE_ENABLE ||
+	    wlan_reg_is_passive_for_freq(wma->pdev, freq))
+		return QDF_STATUS_E_NOSUPPORT;
+	if (inj.mode_stop || inj.state == INJ_RESET_REQUIRED)
+		return QDF_STATUS_E_AGAIN;
+	if (inj.state == INJ_RUNNING && inj.monitor_id == id && inj.freq == freq)
+		return QDF_STATUS_SUCCESS;
+	if (inj.reserved) {
+		/* Retune through a confirmed stop/delete/recreate. This also keeps
+		 * queued frames from the old channel off the new channel. */
+		inj_destroy_locked();
+		if (inj.state == INJ_RESET_REQUIRED)
+			return QDF_STATUS_E_AGAIN;
+	}
+	if (!inj.wq) {
+		inj.wq = alloc_ordered_workqueue("wlan_inject", WQ_MEM_RECLAIM);
+		if (!inj.wq)
+			return QDF_STATUS_E_NOMEM;
+		INIT_DELAYED_WORK(&inj.work, inj_worker);
+	}
+	status = inj_pool_alloc(wma->qdf_dev->dev);
+	if (QDF_IS_STATUS_ERROR(status))
+		return status;
+	status = inj_acquire_owner(wma, id);
+	if (QDF_IS_STATUS_ERROR(status))
+		return status;
+	rx = target_if_vdev_mgr_get_rx_ops(wma->psoc);
+	if (!rx) {
+		status = QDF_STATUS_E_INVAL;
+		goto fail;
+	}
+	WRITE_ONCE(rx->vdev_mgr_start_response_override, inj_start_response);
+	WRITE_ONCE(rx->vdev_mgr_stop_response_override, inj_stop_response);
+	WRITE_ONCE(rx->vdev_mgr_delete_response_override, inj_delete_response);
+	res = lmac_get_tgt_res_cfg(wma->psoc);
+	max_id = min_t(int, res && res->num_vdevs ? res->num_vdevs : CFG_TGT_NUM_VDEV,
+			 wma->max_bssid) - 1;
+	for (i = max_id; i >= 0; i--)
+		if (i != id && !wma->interfaces[i].vdev)
+			break;
+	if (i < 0) {
+		status = QDF_STATUS_E_RESOURCES;
+		goto fail;
+	}
+	inj.helper_id = i;
+	for (attempt = 0; attempt <= wma->max_bssid; attempt++) {
+		eth_random_addr(inj.mac);
+		collision = false;
+		for (i = 0; i < wma->max_bssid; i++)
+			if (wma->interfaces[i].vdev &&
+			    ether_addr_equal(inj.mac, wlan_vdev_mlme_get_macaddr(wma->interfaces[i].vdev))) {
+				collision = true;
+				break;
+			}
+		if (!collision)
+			break;
+	}
+	if (collision) {
+		status = QDF_STATUS_E_RESOURCES;
+		goto fail;
+	}
+	spin_lock_bh(&inj_lock);
+	inj.state = INJ_STARTING;
+	inj.freq = freq;
+	spin_unlock_bh(&inj_lock);
+	p.vdev_id = inj.helper_id;
+	p.type = WMI_VDEV_TYPE_STA;
+	p.nss_2g = p.nss_5g = 1;
+	status = wmi_unified_vdev_create_send(wma->wmi_handle, inj.mac, &p);
+	if (QDF_IS_STATUS_ERROR(status))
+		goto fail;
+	spin_lock_bh(&inj_lock);
+	inj.reserved = true;
+	spin_unlock_bh(&inj_lock);
+	/* Create has no response. WMI ordering plus the confirmed start below
+	 * establishes that the helper exists before it can transmit. */
+	status = inj_start(wma, freq, false);
+	if (QDF_IS_STATUS_ERROR(status))
+		goto fail;
+	inj.started = true;
+	status = inj_peer_command(wma, inj.mac, true, true);
+	if (QDF_IS_STATUS_ERROR(status))
+		goto fail;
+	inj.self_peer = true;
+	spin_lock_bh(&inj_lock);
+	inj.state = INJ_RUNNING;
+	inj_flow_update();
+	spin_unlock_bh(&inj_lock);
+	wma_info("NETHUNTER-INJ: scheduler ready owner=%u helper=%u freq=%u slots=%u credits=%u pool=%pad",
+		 id, inj.helper_id, freq, WMA_INJ_SLOTS, WMA_INJ_MAX_INFLIGHT, &inj.dma);
+	return QDF_STATUS_SUCCESS;
+fail:
+	inj_destroy_locked();
+	return status;
+}
+
+QDF_STATUS wma_inject_ensure_tx_vdev(uint8_t id, uint32_t freq)
+{
+	QDF_STATUS status;
+
+	mutex_lock(&inj_lifecycle);
+	status = inj_ensure_locked(id, freq);
+	mutex_unlock(&inj_lifecycle);
+	return status;
+}
+
+void wma_inject_deinit(void)
+{
+	tp_wma_handle wma = cds_get_context(QDF_MODULE_ID_WMA);
+	struct wlan_lmac_if_mlme_rx_ops *rx;
+
+	mutex_lock(&inj_lifecycle);
+	inj_destroy_locked();
+	if (wma && wma->psoc) {
+		rx = target_if_vdev_mgr_get_rx_ops(wma->psoc);
+		if (rx) {
+			WRITE_ONCE(rx->vdev_mgr_start_response_override, NULL);
+			WRITE_ONCE(rx->vdev_mgr_stop_response_override, NULL);
+			WRITE_ONCE(rx->vdev_mgr_delete_response_override, NULL);
+		}
+	}
+	if (inj.wq) {
+		destroy_workqueue(inj.wq);
+		inj.wq = NULL;
+	}
+	/* WMA close follows WMI RX-work flush. Native callbacks are joined.
+	 * Unknown DMA ownership pins this module and its sole coherent pool. */
+	spin_lock_bh(&inj_lock);
+	inj.reserved = inj.started = inj.self_peer = inj.unicast_peer = false;
+	inj.response = INJ_RSP_NONE;
+	inj.state = INJ_STOPPED;
+	inj.recovery_requested = false;
+	/* SSR must preserve an accepted exit request: recovery may restore the
+	 * monitor RX vdev, but must not restart TX while userspace retries stop.
+	 * The subsequent normal mode teardown clears the latch for the next
+	 * monitor session. Module reload also starts with a fresh instance.
+	 */
+	if (!cds_is_driver_recovering() && !cds_is_fw_down())
+		inj.mode_stop = false;
+	spin_unlock_bh(&inj_lock);
+	inj_pool_retire(false);
+	mutex_unlock(&inj_lifecycle);
+}
