+/* WEXT holds RTNL while nl80211 holds wiphy. Neither serializes the other
+ * path, and psoc operations may run concurrently. Never wait here while
+ * holding either outer lock: a competing channel request must retry.
+ */
+static DEFINE_MUTEX(hdd_mon_channel_lock);
+
+/* The networking core resets both queued and already-dequeued/requeued skbs
+ * in dev_deactivate(). Keep its noop qdisc installed throughout retuning:
+ * incoming packets cannot survive to the new channel, including when the old
+ * channel was RX-only and had no WMA netdev reference. Carrier-off prevents
+ * linkwatch from reactivating it early. RTNL is never held over firmware work.
+ * nl80211 holds wiphy, so trylock instead of reversing the RTNL/wiphy order.
+ */
+static int hdd_mon_tx_transition_begin(struct hdd_adapter *adapter)
+{
+	if (!rtnl_trylock())
+		return -EBUSY;
+	wma_inject_set_host_blocked(true);
+	netif_carrier_off(adapter->dev);
+	netif_tx_disable(adapter->dev);
+	dev_deactivate(adapter->dev);
+	rtnl_unlock();
+	return 0;
+}
+
+static void hdd_mon_tx_transition_end(struct hdd_adapter *adapter)
+{
+	wma_inject_set_host_blocked(false);
+	/* Carrier-on lets linkwatch reactivate the empty qdisc under RTNL.
+	 * Until then the noop qdisc drops new traffic. In RX-only/failure states
+	 * the live qdisc drains to ndo_start_xmit, which rejects it immediately.
+	 */
+	wma_inject_resume(adapter->dev);
