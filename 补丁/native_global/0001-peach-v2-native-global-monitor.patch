+static void wma_inject_handle_completion(tp_wma_handle wma, uint32_t desc_id,
+					 uint32_t status)
+{
+	uint32_t slot = desc_id % WMA_INJ_SLOTS;
+
+	spin_lock_bh(&wma_inj_lock);
+	if (g_wma_inj.owner != wma || g_wma_inj.retired ||
+	    !g_wma_inj.slots[slot].nbuf ||
+	    g_wma_inj.slots[slot].desc_id != desc_id ||
+	    g_wma_inj.slots[slot].done) {
+		g_wma_inj.stale++;
+		spin_unlock_bh(&wma_inj_lock);
+		return;
+	}
+	g_wma_inj.slots[slot].done = true;
+	g_wma_inj.slots[slot].status = status;
+	/* WMI can complete before its send call returns. Do not free the
