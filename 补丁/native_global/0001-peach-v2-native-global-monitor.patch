+typedef int QDF_STATUS;
+enum {QDF_STATUS_SUCCESS,QDF_STATUS_E_INVAL,QDF_STATUS_E_AGAIN,QDF_STATUS_E_BUSY};
+enum {INJ_STOPPED,INJ_STARTING,INJ_RUNNING,INJ_QUIESCING,INJ_RESET_REQUIRED};
+#define QDF_GLOBAL_MONITOR_MODE 4
+#define INJ_FRAME_SIZE 2048
+#define INJ_STOP_FREE 2
+#define INJ_WAKE_FREE 8
+#define max(a,b) ((a)>(b)?(a):(b))
+struct net_device {bool running,stopped,carrier,qdisc_live;unsigned backlog,runner,refs;};
+struct hdd_adapter {struct net_device *dev;};
+static struct {
+ int state;bool host_blocked,mode_stop,queue_stopped;
+ struct wma_inj_queue q;
+ struct {unsigned len,queued_at,retries;} meta[WMA_INJ_SLOTS];
+ struct net_device *netdev;
+ uint8_t monitor_id;unsigned freq;void *pool;
+ unsigned accepted,backpressure,peak_used;
+} inj;
+static int inj_lock;
+static bool rtnl_held,rtnl_busy;
+static unsigned jiffies,deactivations,host_drops;
+static uint8_t payload[WMA_INJ_SLOTS*INJ_FRAME_SIZE],frame[30];
+static void spin_lock_bh(int *l){assert(!*l);*l=1;}
+static void spin_unlock_bh(int *l){assert(*l);*l=0;}
+static bool netif_running(struct net_device *d){return d->running;}
+static void netif_tx_stop_all_queues(struct net_device *d){d->stopped=true;}
+static void netif_tx_wake_all_queues(struct net_device *d){d->stopped=false;}
+static void netif_carrier_on(struct net_device *d){d->carrier=true;}
+static void dev_hold(struct net_device *d){d->refs++;}
+static int cds_get_conparam(void){return 4;}
+static void inj_kick(unsigned ms){assert(inj_lock);}
+static int rtnl_trylock(void){if(rtnl_busy)return 0;assert(!rtnl_held);rtnl_held=true;return 1;}
+static void rtnl_unlock(void){assert(rtnl_held);rtnl_held=false;}
+static void netif_carrier_off(struct net_device *d){assert(rtnl_held);d->carrier=false;}
+static void netif_tx_disable(struct net_device *d){assert(!inj_lock && rtnl_held);d->stopped=true;}
