+tests = r'''
+int main(void) {
+ struct net_device dev={0,false,true};uint8_t frame[24]={0x40};
+ wma_inject_open();
+ assert(wma_inject_mon_frame(0,&dev,frame,24)==0);
+ unsigned old=last_desc;
+ assert(allocated==1 && refs==1 && dev.refs==1 && !memcmp(frame,captured,24));
+ wma_inject_handle_completion(&wma,last_desc,0);
+ assert(!allocated && !refs && !dev.refs && unmaps==1);
+
+ wma_inject_handle_completion(&wma,old,0);assert(g_wma_inj.stale==1 && !allocated);
+ /* Deauth/disassoc keep their required flag without changing probe flags.
+  * Inject immediate send failures to test flags without shifting counters. */
+ mon_tx_wrong_key=false;expected_flags=MGMT_TX_USE_INCORRECT_KEY;fail=true;
+ frame[0]=0xc0;assert(wma_inject_mon_frame(0,&dev,frame,24)==QDF_STATUS_E_FAILURE);
+ frame[0]=0xa0;assert(wma_inject_mon_frame(0,&dev,frame,24)==QDF_STATUS_E_FAILURE);
+ frame[0]=0x40;expected_flags=0;fail=false;unmaps-=2;
+ /* A completion can run synchronously inside WMI send. */
+ mon_tx_wrong_key=true;expected_flags=MGMT_TX_USE_INCORRECT_KEY;
+ early=true;assert(wma_inject_mon_frame(0,&dev,frame,24)==0);early=false;
+ assert(!allocated && !refs && !g_wma_inj.used && g_wma_inj.submitted==2 && g_wma_inj.completed==2);
+ /* Send failure has already unmapped; freeing must not unmap twice. */
+ fail=true;assert(wma_inject_mon_frame(0,&dev,frame,24)==QDF_STATUS_E_FAILURE);fail=false;
+ assert(!allocated && !refs && !g_wma_inj.used && !dev.refs && unmaps==3);
+ alloc_fail=true;assert(wma_inject_mon_frame(0,&dev,frame,24)==QDF_STATUS_E_NOMEM);alloc_fail=false;
+ int before=sends;frame[0]=0x08;assert(wma_inject_mon_frame(0,&dev,frame,24)==QDF_STATUS_E_INVAL);
+ frame[0]=0xd4;assert(wma_inject_mon_frame(0,&dev,frame,24)==QDF_STATUS_E_INVAL);frame[0]=0x40;
+ assert(wma_inject_mon_frame(0,&dev,frame,23)==QDF_STATUS_E_INVAL);
+ assert(wma_inject_mon_frame(1,&dev,frame,24)==QDF_STATUS_E_INVAL);
+ wma.interfaces[0].type=1;assert(wma_inject_mon_frame(0,&dev,frame,24)==QDF_STATUS_E_AGAIN);
+ wma.interfaces[0].type=WMI_VDEV_TYPE_MONITOR;wma.interfaces[0].ch_freq=0;
+ assert(wma_inject_mon_frame(0,&dev,frame,24)==QDF_STATUS_E_INVAL);wma.interfaces[0].ch_freq=5765;
+ mode=0;assert(wma_inject_mon_frame(0,&dev,frame,24)==QDF_STATUS_E_INVAL);mode=4;assert(sends==before);
+ /* Full ring stops TX; a free hole wakes and is usable immediately. */
+ unsigned ids[WMA_INJ_SLOTS];
+ for(unsigned i=0;i<WMA_INJ_SLOTS;i++){assert(wma_inject_mon_frame(0,&dev,frame,24)==0);ids[i]=last_desc;}
+ assert(dev.stopped && allocated==WMA_INJ_SLOTS && dev.refs==WMA_INJ_SLOTS);
+ wma_inject_resume(&dev);assert(dev.stopped);
+ assert(wma_inject_mon_frame(0,&dev,frame,24)==QDF_STATUS_E_BUSY);
+ assert(allocated==WMA_INJ_SLOTS && refs==WMA_INJ_SLOTS);
+ unsigned hole=13;
+ wma_inject_handle_completion(&wma,ids[hole],1);assert(!dev.stopped);
+ assert(wma_inject_mon_frame(0,&dev,frame,24)==0);assert(dev.stopped && last_desc!=ids[hole]);
+ unsigned stale=g_wma_inj.stale;
+ wma_inject_handle_completion(&wma,ids[hole],0);assert(g_wma_inj.stale==stale+1 && allocated==WMA_INJ_SLOTS);
+ ids[hole]=last_desc;
+ for(unsigned i=0;i<WMA_INJ_SLOTS;i++)wma_inject_handle_completion(&wma,ids[i],0);
+ assert(!allocated && !refs && !dev.refs && !dev.stopped);
+ dev.stopped=true;wma_inject_resume(&dev);assert(!dev.stopped);
+ wma_inject_close();wma_inject_open();assert(g_wma_inj.owner==&wma);
+ /* Down netdev must not be awakened by a completion. */
+ assert(wma_inject_mon_frame(0,&dev,frame,24)==0);dev.running=false;dev.stopped=true;
+ wma_inject_handle_completion(&wma,last_desc,0);assert(dev.stopped);dev.running=true;
+ /* Close with missing completion quarantines DMA, drops netdev references,
+    pins module, and rejects both new submits and late events after reopen. */
+ assert(wma_inject_mon_frame(0,&dev,frame,24)==0);old=last_desc;
+ wma_inject_close();assert(allocated==1 && refs==1 && !dev.refs && g_wma_inj.retired);
+ wma_inject_open();assert(wma_inject_mon_frame(0,&dev,frame,24)==QDF_STATUS_E_AGAIN);
+ wma_inject_handle_completion(&wma,old,0);assert(allocated==1 && refs==1);
+ wma_inject_close();assert(!dev.refs);
