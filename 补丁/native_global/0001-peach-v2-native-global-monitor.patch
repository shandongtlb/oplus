+typedef void (*mgmt_txrx_external_cb)(void *context, uint64_t cookie,
+				    enum mgmt_txrx_external_reason reason,
+				    uint32_t status);
+typedef QDF_STATUS (*mgmt_txrx_external_send)(struct wlan_objmgr_vdev *vdev,
+					    uint32_t desc_id, void *context);
