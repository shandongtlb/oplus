+enum mgmt_txrx_external_reason {
+	MGMT_TXRX_EXTERNAL_COMPLETE,
+	MGMT_TXRX_EXTERNAL_SEND_FAILED,
+	MGMT_TXRX_EXTERNAL_DRAINED,
+};
