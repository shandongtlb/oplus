+	}
+
+	nbuf = qdf_nbuf_alloc(NULL, frame_len, 0, 4, false);
+	if (!nbuf)
+		return QDF_STATUS_E_NOMEM;
+	data = qdf_nbuf_put_tail(nbuf, frame_len);
+	if (!data) {
+		qdf_nbuf_free(nbuf);
+		return QDF_STATUS_E_NOMEM;
+	}
+	qdf_mem_copy(data, frame, frame_len);
+
+	spin_lock_bh(&wma_inj_lock);
+	if (g_wma_inj.owner != wma || g_wma_inj.retired) {
+		spin_unlock_bh(&wma_inj_lock);
+		qdf_nbuf_free(nbuf);
+		return QDF_STATUS_E_AGAIN;
+	}
+	for (offset = 0; offset < WMA_INJ_SLOTS; offset++) {
+		slot = (g_wma_inj.next + offset) % WMA_INJ_SLOTS;
+		if (!g_wma_inj.slots[slot].nbuf)
+			break;
+	}
