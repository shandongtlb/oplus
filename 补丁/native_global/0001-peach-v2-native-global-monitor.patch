+static void hdd_restore_monitor_injection(struct hdd_context *hdd_ctx)
+{
+#ifdef FEATURE_MONITOR_MODE_SUPPORT
+	struct hdd_adapter *adapter;
+	struct wlan_hdd_link_info *link;
+	struct hdd_monitor_ctx *mon_ctx;
+	struct wlan_channel *chan;
+	QDF_STATUS status;
+	unsigned int attempt;
+
+	/* The caller still owns the SSR psoc transaction, but has cleared the
+	 * recovery flag after restoring adapters. WMA must not be used earlier.
+	 * Only restore a live global monitor on its confirmed saved channel.
+	 */
+	if (hdd_get_conparam() != QDF_GLOBAL_MONITOR_MODE)
+		return;
+	adapter = hdd_get_adapter(hdd_ctx, QDF_MONITOR_MODE);
+	if (!adapter || !hdd_is_interface_up(adapter) ||
+	    !adapter->monitor_ssr_ready ||
+	    adapter->monitor_mode_vdev_up_in_progress)
+		return;
+	link = adapter->deflink;
+	if (!link || !link->vdev ||
+	    QDF_IS_STATUS_ERROR(wlan_vdev_is_up_active_state(link->vdev)))
+		return;
+	mon_ctx = WLAN_HDD_GET_MONITOR_CTX_PTR(link);
+	chan = wlan_vdev_mlme_get_des_chan(link->vdev);
+	if (!mon_ctx->freq || !chan || chan->ch_freq != mon_ctx->freq ||
+	    chan->ch_width != mon_ctx->bandwidth ||
+	    (mon_ctx->center_freq1 && mon_ctx->center_freq1 !=
+	     (mon_ctx->bandwidth == CH_WIDTH_160MHZ ?
+	      chan->ch_cfreq2 : chan->ch_cfreq1)))
+		return;
+	/* Wide capture remains RX-only. Resume its host drop path so packets
+	 * cannot accumulate in a stopped qdisc and leak into a later channel.
+	 * An administratively paused interface must remain paused.
+	 */
+	if (mon_ctx->bandwidth != CH_WIDTH_20MHZ) {
+		if (netif_running(adapter->dev)) {
+			wlan_hdd_netif_queue_control(adapter,
+					WLAN_START_ALL_NETIF_QUEUE_N_CARRIER,
+					WLAN_CONTROL_PATH);
+			wma_inject_resume(adapter->dev);
+		}
+		return;
+	}
+
+	/* ensure also checks FW readiness and the mode-stop latch under its
+	 * lifecycle lock. An exit handed to SSR must not recreate injection.
+	 */
+	for (attempt = 1; ; attempt++) {
+		status = wma_inject_ensure_tx_vdev(link->vdev_id, mon_ctx->freq);
+		if (QDF_IS_STATUS_SUCCESS(status))
+			break;
+		/* Keep retries inside the existing SSR transaction: adapter/channel
+		 * lifetime is protected, and no detached work can rebuild an old
+		 * monitor session. ensure rechecks FW readiness and mode_stop on
+		 * every attempt. E_AGAIN may mean stopping or unknown DMA; never
+		 * retry it here or turn a firmware failure into a retry loop.
+		 */
+		if ((status != QDF_STATUS_E_NOMEM &&
+		     status != QDF_STATUS_E_RESOURCES) ||
+		    attempt == HDD_MON_INJ_RESTORE_ATTEMPTS) {
+			hdd_info("NETHUNTER-INJ: SSR TX restore stopped after %u attempt(s): %u",
+				 attempt, status);
+			return;
+		}
+		hdd_info("NETHUNTER-INJ: SSR TX restore retry after resource failure: attempt=%u status=%u",
+			 attempt, status);
+		msleep(HDD_MON_INJ_RESTORE_RETRY_MS);
+	}
+	if (netif_running(adapter->dev)) {
+		wlan_hdd_netif_queue_control(adapter,
+					    WLAN_START_ALL_NETIF_QUEUE_N_CARRIER,
+					    WLAN_CONTROL_PATH);
+		wma_inject_resume(adapter->dev);
+	}
+	hdd_info("NETHUNTER-INJ: TX restored after SSR on %u MHz",
+		 mon_ctx->freq);
+#endif
+}
