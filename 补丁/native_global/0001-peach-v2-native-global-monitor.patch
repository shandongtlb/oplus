+  hdd_restore_monitor_injection(&ctx);assert(!ensure_count && !queue_starts);
+ }
+ reset(); ensure_error=QDF_STATUS_E_NOMEM; fail_attempts=2;
+ hdd_restore_monitor_injection(&ctx); assert(ensure_count==3 && queue_starts==1 && sleeps==2);
+ reset(); ensure_error=QDF_STATUS_E_RESOURCES; fail_attempts=9;
+ hdd_restore_monitor_injection(&ctx); assert(ensure_count==10 && queue_starts==1 && sleeps==9);
+ reset(); ensure_error=QDF_STATUS_E_NOMEM; fail_attempts=100;
+ hdd_restore_monitor_injection(&ctx); assert(ensure_count==10 && !queue_starts && sleeps==9);
+ reset(); ensure_error=QDF_STATUS_E_NOSUPPORT; fail_attempts=100;
+ hdd_restore_monitor_injection(&ctx); assert(ensure_count==1 && !queue_starts && !sleeps);
+ reset(); ensure_error=QDF_STATUS_E_AGAIN; fail_attempts=100;
+ hdd_restore_monitor_injection(&ctx); assert(ensure_count==1 && !queue_starts && !sleeps);
+ reset(); ensure_error=QDF_STATUS_E_NOMEM; fail_attempts=2; stop_during_retry=true;
+ hdd_restore_monitor_injection(&ctx); assert(ensure_count==2 && !queue_starts && sleeps==1);
+ reset(); ensure_error=QDF_STATUS_E_NOMEM; fail_attempts=2; down_during_retry=true;
+ hdd_restore_monitor_injection(&ctx); assert(ensure_count==2 && !queue_starts && sleeps==1);
+ reset(); inj.mode_stop=true; recovering=true;
+ wma_inject_deinit(); assert(inj.mode_stop && retired==1 && destroyed==1 && !inj.wq);
+ recovering=false; hdd_restore_monitor_injection(&ctx); assert(ensure_count==1 && !queue_starts);
+ wma_inject_deinit(); assert(!inj.mode_stop && retired==2 && destroyed==1);
+ hdd_restore_monitor_injection(&ctx); assert(queue_starts==1);
+ reset(); inj.mode_stop=true; fw_down=true; wma_inject_deinit(); assert(inj.mode_stop);
+ reset(); recovering=true; wma_inject_deinit(); assert(!inj.mode_stop);
+ recovering=false; hdd_restore_monitor_injection(&ctx); assert(queue_starts==1);
+ puts("SSR monitor restore eligibility, failure handling and stop latch cases passed");
+}
+'''
+with tempfile.TemporaryDirectory() as temp:
+    c = Path(temp) / 'test.c'
