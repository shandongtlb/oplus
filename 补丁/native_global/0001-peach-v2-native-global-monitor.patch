+ ensure_count++;
+ if (inj.mode_stop || recovering || fw_down) return QDF_STATUS_E_AGAIN;
+ return ensure_count <= fail_attempts ? ensure_error : 0;
+}
+static void msleep(unsigned ms) {
+ assert(ms==200); sleeps++;
+ if (stop_during_retry) inj.mode_stop=true;
+ if (down_during_retry) fw_down=true;
+}
+static void wlan_hdd_netif_queue_control(struct hdd_adapter *a, int action, int reason) {
+ assert(a==&adapter && action==1 && reason==2 && !inj.mode_stop && !fw_down); queue_starts++;
+}
+static tp_wma_handle cds_get_context(int id) { assert(id==1); return &wma_ctx; }
+static bool cds_is_driver_recovering(void) { return recovering; }
+static bool cds_is_fw_down(void) { return fw_down; }
+static void mutex_lock(int *p) { assert(p==&inj_lifecycle && !locked); locked=1; }
+static void mutex_unlock(int *p) { assert(p==&inj_lifecycle && locked); locked=0; }
+static void spin_lock_bh(int *p) { assert(p==&inj_lock && !spinlocked); spinlocked=1; }
+static void spin_unlock_bh(int *p) { assert(p==&inj_lock && spinlocked); spinlocked=0; }
+static void inj_destroy_locked(void) { assert(locked); }
+static struct wlan_lmac_if_mlme_rx_ops *target_if_vdev_mgr_get_rx_ops(void *p) { assert(p==&ctx); return &rx; }
+static void destroy_workqueue(void *p) { assert(locked && p==&ctx); destroyed++; }
+static void inj_pool_retire(bool fresh_fw) { assert(locked && !fresh_fw); retired++; }
+static void reset(void) {
+ memset(&inj,0,sizeof(inj)); memset(&adapter,0,sizeof(adapter));
+ mode=4; present=channel_present=true; recovering=fw_down=false;
+ adapter.up=true; adapter.deflink=&link; link.vdev=&vdev; link.vdev_id=7;
+ vdev.active=true; link.monitor.freq=channel.ch_freq=2417;
+ link.monitor.bandwidth=channel.ch_width=20;
+ ensure_count=ensure_error=queue_starts=retired=destroyed=0;
+ fail_attempts=sleeps=0; stop_during_retry=down_during_retry=false;
+ wma_ctx.psoc=&ctx; inj.wq=&ctx;
+}
