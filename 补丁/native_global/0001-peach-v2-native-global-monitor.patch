+#!/usr/bin/env python3
+"""Exercise production admission/completion/close with a fault-injected WMI."""
+from pathlib import Path
+import subprocess
+import tempfile
+
+root = Path(__file__).resolve().parents[1]
+s = (root / 'core/wma/src/wma_mgmt.c').read_text()
+body = s[s.index('/* Native monitor management TX.'):s.index('/**\n * wma_process_mgmt_tx_completion()')]
+shim = r'''
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#define module_param_named(...)
+#define MODULE_PARM_DESC(...)
+#define READ_ONCE(x) (x)
+#define DEFINE_SPINLOCK(n) int n
+static void spin_lock_bh(int *p) {assert(!*p);*p=1;}
+static void spin_unlock_bh(int *p) {assert(*p);*p=0;}
+typedef int QDF_STATUS;
+enum {QDF_STATUS_SUCCESS, QDF_STATUS_E_INVAL, QDF_STATUS_E_AGAIN,
+      QDF_STATUS_E_NOMEM, QDF_STATUS_E_BUSY, QDF_STATUS_E_FAILURE};
+enum {QDF_MODULE_ID_WMA, QDF_MODULE_ID_QDF_DEVICE, QDF_GLOBAL_MONITOR_MODE=4,
+      WMI_VDEV_TYPE_MONITOR=3, QDF_DMA_TO_DEVICE, MGMT_TX_USE_INCORRECT_KEY=1};
+#define QDF_IS_STATUS_ERROR(s) ((s)!=0)
+struct net_device {int refs;bool stopped,running;};
+struct wma_txrx_node {void *vdev;bool vdev_active;int type;unsigned ch_freq;};
+struct wma_handle {unsigned max_bssid;struct wma_txrx_node interfaces[1];void *qdf_dev,*wmi_handle;};
+typedef struct wma_handle *tp_wma_handle;
+struct nbuf {uint8_t *data;unsigned len;bool mapped;};
+typedef struct nbuf *qdf_nbuf_t;
+struct wmi_mgmt_params {qdf_nbuf_t tx_frame;unsigned frm_len,vdev_id,chanfreq,desc_id,tx_flags;void *pdata,*qdf_ctx;};
+static struct wma_handle wma={1,{{(void *)1,true,WMI_VDEV_TYPE_MONITOR,5765}},(void *)1,(void *)1};
+static int mode=QDF_GLOBAL_MONITOR_MODE,refs,allocated,unmaps,sends;
+static bool early,fail,alloc_fail;
+static unsigned last_desc,expected_flags;
+static uint8_t captured[2048];
+static void *cds_get_context(int id) {return id==QDF_MODULE_ID_WMA?&wma:(void *)1;}
+static int cds_get_conparam(void) {return mode;}
+static int wma_validate_handle(tp_wma_handle p) {return !p;}
+#define THIS_MODULE NULL
+static bool try_module_get(void *m) {refs++;return true;}
+static void module_put(void *m) {assert(refs>0);refs--;}
+static void dev_hold(struct net_device *d) {d->refs++;}
+static void dev_put(struct net_device *d) {assert(d->refs>0);d->refs--;}
+static void netif_carrier_on(struct net_device *d) {}
+static bool netif_running(struct net_device *d) {return d->running;}
+static void netif_tx_stop_all_queues(struct net_device *d) {d->stopped=true;}
+static void netif_tx_wake_all_queues(struct net_device *d) {d->stopped=false;}
+static qdf_nbuf_t qdf_nbuf_alloc(void *p,unsigned n,int a,int b,bool c) {
+ if(alloc_fail)return NULL;
+ qdf_nbuf_t buf=calloc(1,sizeof(*buf));buf->data=malloc(n);buf->len=n;allocated++;return buf;
+}
+static uint8_t *qdf_nbuf_put_tail(qdf_nbuf_t p,unsigned n) {return p->data;}
+#define qdf_mem_copy memcpy
+static void qdf_nbuf_free(qdf_nbuf_t p) {assert(!p->mapped);allocated--;free(p->data);free(p);}
+static void qdf_nbuf_unmap_single(void *ctx,qdf_nbuf_t p,int dir) {assert(p->mapped);p->mapped=false;unmaps++;}
+static const char *wma_get_status_str(unsigned n) {return "status";}
+static void log_stub(const char *f,...) {}
+#define wma_err log_stub
+#define wma_info log_stub
+#define wma_err_rl log_stub
+static void wma_inject_handle_completion(tp_wma_handle,unsigned,unsigned);
+static QDF_STATUS wmi_mgmt_unified_cmd_send(void *w,struct wmi_mgmt_params *p) {
