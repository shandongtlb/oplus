+static DEFINE_SPINLOCK(wma_inj_lock);
+static struct wma_inject_ctx {
+	tp_wma_handle owner;
+	struct {
+		qdf_nbuf_t nbuf;
+		struct net_device *dev;
+		uint16_t desc_id;
+		bool submitting;
+		bool done;
+		uint32_t status;
+	} slots[WMA_INJ_SLOTS];
+	uint32_t next;
+	uint32_t used;
+	uint32_t submitted;
+	uint32_t completed;
+	uint32_t busy;
+	uint32_t stale;
+	bool retired;
+	uint32_t last_status;
+} g_wma_inj;
+
+#define wma_inj_should_log(n) ((n) <= 8 || ((n) % 256) == 0)
+
+static inline bool wma_inject_is_inj_desc(uint32_t desc_id)
+{
+	return desc_id >= WMA_INJ_DESC_BASE && desc_id <= 0xffff;
+}
+
+void wma_inject_open(void)
+{
+	spin_lock_bh(&wma_inj_lock);
+	if (!g_wma_inj.retired && !g_wma_inj.used)
+		g_wma_inj.owner = cds_get_context(QDF_MODULE_ID_WMA);
+	spin_unlock_bh(&wma_inj_lock);
+}
+
+/* Channel restart may stop the stock queues. Resume only when our ring
+ * still has credit; serialize this with completion and full-ring stop.
+ */
+void wma_inject_resume(struct net_device *dev)
+{
+	spin_lock_bh(&wma_inj_lock);
+	if (g_wma_inj.owner && !g_wma_inj.retired &&
+	    g_wma_inj.used < WMA_INJ_SLOTS && netif_running(dev) &&
+	    cds_get_conparam() == QDF_GLOBAL_MONITOR_MODE) {
+		netif_carrier_on(dev);
+		netif_tx_wake_all_queues(dev);
+	}
+	spin_unlock_bh(&wma_inj_lock);
+}
+
+/* WMA close follows WMI RX-work flush; HDD has joined its TX operations.
+ * An uncompleted DMA buffer cannot be reclaimed based on host shutdown
+ * alone. Retain its module reference and buffer, and refuse new TX after
+ * reopen. This bounded quarantine requires a reboot to recover. Releasing
+ * it after a confirmed fresh firmware boot is deliberately not guessed here.
+ */
+void wma_inject_close(void)
+{
+	uint32_t i;
+
+	spin_lock_bh(&wma_inj_lock);
+	g_wma_inj.owner = NULL;
+	if (g_wma_inj.used) {
+		g_wma_inj.retired = true;
+		wma_err("NETHUNTER-INJ: retaining %u uncompleted DMA buffers; TX disabled until reboot",
+			g_wma_inj.used);
+	}
+	for (i = 0; i < WMA_INJ_SLOTS; i++) {
+		if (g_wma_inj.slots[i].dev) {
+			netif_tx_stop_all_queues(g_wma_inj.slots[i].dev);
+			dev_put(g_wma_inj.slots[i].dev);
+			g_wma_inj.slots[i].dev = NULL;
+		}
+	}
+	spin_unlock_bh(&wma_inj_lock);
+}
+
+/* Called under wma_inj_lock after send has returned. */
+static void wma_inject_release(tp_wma_handle wma, uint32_t slot,
+			       bool completed, uint32_t status)
+{
+	qdf_nbuf_t nbuf = g_wma_inj.slots[slot].nbuf;
+	struct net_device *dev = g_wma_inj.slots[slot].dev;
+	uint16_t desc_id = g_wma_inj.slots[slot].desc_id;
+
+	if (completed) {
+#ifndef CONFIG_HL_SUPPORT
+		qdf_nbuf_unmap_single(wma->qdf_dev, nbuf, QDF_DMA_TO_DEVICE);
+#endif
+		g_wma_inj.completed++;
+		/* NO_ACK is distinct from DISCARD; neither proves no RF TX.
+		 * COMPLETE_OK is a firmware report, not an independent RF capture. */
+		if (wma_inj_should_log(g_wma_inj.completed) ||
+		    status != g_wma_inj.last_status)
+			wma_info("NETHUNTER-INJ: [completion] desc=%u status=%u(%s) submitted=%u completed=%u inflight=%u busy=%u stale=%u",
+				 desc_id, status, wma_get_status_str(status),
+				 g_wma_inj.submitted, g_wma_inj.completed,
+				 g_wma_inj.used - 1, g_wma_inj.busy, g_wma_inj.stale);
+		g_wma_inj.last_status = status;
+	}
+	qdf_nbuf_free(nbuf);
+	g_wma_inj.slots[slot].nbuf = NULL;
+	g_wma_inj.slots[slot].dev = NULL;
+	g_wma_inj.used--;
+	if (dev) {
+		if (g_wma_inj.owner == wma && !g_wma_inj.retired &&
+		    netif_running(dev) &&
+		    cds_get_conparam() == QDF_GLOBAL_MONITOR_MODE)
+			netif_tx_wake_all_queues(dev);
+		dev_put(dev);
+	}
+	module_put(THIS_MODULE);
+}
