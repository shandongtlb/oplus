+#!/usr/bin/env python3
+"""Exercise the production callback/getter with the real queue and FW enum."""
+from pathlib import Path
+import re
+import subprocess
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[1]
+source = (ROOT / 'core/wma/src/wma_inject.c').read_text()
+fw = (ROOT.parent / 'fw-api/fw/wmi_unified.h').read_text()
+fw_enum = re.search(r'typedef enum \{\s*WMI_MGMT_TX_COMP_TYPE_COMPLETE_OK.*?\} WMI_MGMT_TX_COMP_STATUS_TYPE;', fw, re.S).group()
+
+
+def function(signature):
+    start = source.index(signature)
+    end = source.index('{', start) + 1
+    depth = 1
+    while depth:
+        depth += (source[end] == '{') - (source[end] == '}')
+        end += 1
+    return source[start:end]
+
+
+prelude = r'''
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include "wma_inject_queue.h"
+#define ARRAY_SIZE(a) (sizeof(a) / sizeof((a)[0]))
+#define PAGE_SIZE 4096
+#define wma_info(...) ((void)0)
+#define scnprintf snprintf
+#define jiffies_to_msecs(x) ((unsigned int)(x))
+#define max(a, b) ((a) > (b) ? (a) : (b))
+struct kernel_param { int unused; };
+enum mgmt_txrx_external_reason {
+ MGMT_TXRX_EXTERNAL_COMPLETE, MGMT_TXRX_EXTERNAL_SEND_FAILED,
+ MGMT_TXRX_EXTERNAL_DRAINED
+};
+enum { INJ_RESET_REQUIRED = 4 };
+static unsigned long jiffies = 100;
+static int inj_lock, inj_idle;
+static struct {
+ struct wma_inj_queue q;
+ struct { unsigned long submitted_at; uint32_t send_status; } meta[WMA_INJ_SLOTS];
+ unsigned long long completed, failed, stale, drained;
+ unsigned long long tx_status[WMI_MGMT_TX_COMP_TYPE_MAX], tx_status_unknown;
+ uint32_t last_tx_status, last_tx_error, max_completion_ms, state;
+} inj;
+static void spin_lock_bh(int *p) { assert(!*p); *p = 1; }
+static void spin_unlock_bh(int *p) { assert(*p); *p = 0; }
+static void inj_flow_update(void) { assert(inj_lock); }
+static void inj_kick(int delay) { assert(inj_lock && !delay); }
+static void wake_up_all(int *p) { assert(inj_lock && p == &inj_idle); }
+'''
+body = r'''
+static void check(const char *expected) {
+ char buf[PAGE_SIZE];
+ int n = inj_tx_status_get(buf, NULL);
+ assert(!inj_lock && n == (int)strlen(buf));
+ assert(!strcmp(buf, expected));
+}
+static int begin(bool inline_completion) {
+ int i = wma_inj_queue_claim(&inj.q);
+ assert(i >= 0 && wma_inj_queue_begin(&inj.q) == i);
+ if (!inline_completion) wma_inj_queue_finish_send(&inj.q, i, false);
+ return i;
+}
+static void complete(uint32_t status, bool inline_completion) {
+ int i = begin(inline_completion);
+ inj_native_complete(&inj.q.slots[i], inj.q.slots[i].token,
+                     MGMT_TXRX_EXTERNAL_COMPLETE, status);
+ if (inline_completion) wma_inj_queue_finish_send(&inj.q, i, false);
+ assert(!inj.q.used && !inj.q.inflight);
+}
+int main(void) {
+ check("completed=0 failed=0 ok=0 discard=0 inspect=0 no_ack=0 unknown=0 last_status=0 last_error=0\n");
+ complete(0, false); complete(1, true); complete(2, false); complete(3, true);
+ check("completed=4 failed=3 ok=1 discard=1 inspect=1 no_ack=1 unknown=0 last_status=3 last_error=3\n");
+ /* MAX is a sentinel, not a valid firmware status or an array index. */
+ complete(WMI_MGMT_TX_COMP_TYPE_MAX, false); complete(UINT32_MAX, true);
+ check("completed=6 failed=5 ok=1 discard=1 inspect=1 no_ack=1 unknown=2 last_status=4294967295 last_error=4294967295\n");
+ complete(0, true);
+ check("completed=7 failed=5 ok=2 discard=1 inspect=1 no_ack=1 unknown=2 last_status=0 last_error=4294967295\n");
+ int i = begin(false);
+ uint64_t token = inj.q.slots[i].token;
+ /* A host failure with numeric value 3 must not count as firmware NO_ACK. */
+ inj_native_complete(&inj.q.slots[i], token, MGMT_TXRX_EXTERNAL_SEND_FAILED, 3);
+ assert(inj.meta[i].send_status == 3 && !inj.q.used);
+ inj_native_complete(&inj.q.slots[i], token, MGMT_TXRX_EXTERNAL_COMPLETE, 3);
+ assert(inj.stale == 1);
+ i = begin(false); token = inj.q.slots[i].token;
+ inj_native_complete(&inj.q.slots[i], token + 1, MGMT_TXRX_EXTERNAL_COMPLETE, 1);
+ assert(inj.stale == 2 && inj.q.inflight == 1);
+ /* Forced host drain uses zero but is not firmware OK or DMA completion. */
+ inj_native_complete(&inj.q.slots[i], token, MGMT_TXRX_EXTERNAL_DRAINED, 0);
+ assert(inj.drained == 1 && inj.state == INJ_RESET_REQUIRED);
+ assert(inj.q.used == 1 && !inj.q.inflight);
+ assert(inj.q.slots[i].state == WMA_INJ_QUARANTINED);
+ check("completed=7 failed=5 ok=2 discard=1 inspect=1 no_ack=1 unknown=2 last_status=0 last_error=4294967295\n");
+ /* Exercise the same getter and callback across the 32-bit counter boundary. */
+ memset(&inj, 0, sizeof(inj));
+ inj.completed = inj.failed = inj.tx_status[3] = 0xffffffffULL;
+ complete(3, false);
+ check("completed=4294967296 failed=4294967296 ok=0 discard=0 inspect=0 no_ack=4294967296 unknown=0 last_status=3 last_error=3\n");
+ puts("TX status callback/getter: categories, unknowns, inline completion, host failures, stale tokens, drain and 64-bit counters passed");
+}
+'''
+with tempfile.TemporaryDirectory() as directory:
+    path = Path(directory)
+    c = path / 'test.c'
+    c.write_text(fw_enum + prelude + function('static int inj_tx_status_get(')
+                 + function('static void inj_native_complete(') + body)
+    exe = path / 'test'
+    subprocess.run(['cc', '-std=c11', '-Wall', '-Wextra', '-Werror',
+                    '-Wno-unused-parameter', '-fsanitize=address,undefined',
+                    '-I', str(ROOT / 'core/wma/inc'), str(c), '-o', str(exe)], check=True)
+    subprocess.run([str(exe)], check=True)
