+#!/usr/bin/env python3
+"""Run the production SSR restore hook and WMA stop-latch teardown with stubs."""
+from pathlib import Path
+import subprocess
+import tempfile
+import re
+
+ROOT = Path(__file__).resolve().parents[1]
+hdd = (ROOT / 'core/hdd/src/wlan_hdd_driver_ops.c').read_text()
+wma = (ROOT / 'core/wma/src/wma_inject.c').read_text()
+
+def function(source, signature):
+    start = source.index(signature)
+    end = source.index('{', start) + 1
+    depth = 1
+    while depth:
+        depth += (source[end] == '{') - (source[end] == '}')
+        end += 1
+    return source[start:end]
+
+# Check the actual caller order; the executable tests exercise the hook itself.
+caller = function(hdd, 'static int __hdd_soc_recovery_reinit(')
+assert caller.index('hdd_wlan_re_init();') < caller.index('if (!qdf_is_fw_down())')
+assert caller.index('cds_set_recovery_in_progress(false);') < caller.index('hdd_restore_monitor_injection(hdd_ctx);') < caller.index('hdd_handle_cached_commands();')
+outer = function(hdd, 'static int hdd_soc_recovery_reinit(')
+assert outer.index('osif_psoc_sync_trans_resume(') < outer.index('__hdd_soc_recovery_reinit(') < outer.index('osif_psoc_sync_trans_stop(')
+assert 'if (inj.mode_stop || inj.state == INJ_RESET_REQUIRED)' in function(wma, 'static QDF_STATUS inj_ensure_locked(')
+
+pre = r'''
