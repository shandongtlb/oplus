+#!/usr/bin/env python3
+"""Run production admission/transition code against a host qdisc lifecycle model.
+
+The networking primitives model deactivate's documented drain/reset boundary;
+real kernel lock scheduling and linkwatch still require device validation.
+"""
+from pathlib import Path
+import subprocess
+import tempfile
+ROOT = Path(__file__).resolve().parents[1]
+wma = (ROOT / 'core/wma/src/wma_inject.c').read_text()
+hdd = (ROOT / 'core/hdd/src/wlan_hdd_cfg80211.c').read_text()
+
+def function(src, sig):
+    start = src.index(sig)
+    end = src.index('{', start) + 1
+    depth = 1
+    while depth:
+        depth += (src[end] == '{') - (src[end] == '}')
+        end += 1
+    return src[start:end]
