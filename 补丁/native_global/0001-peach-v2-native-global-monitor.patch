+		qdf_nbuf_free(nbuf);
+		return QDF_STATUS_E_AGAIN;
+	}
+	/* The echoed 16-bit ID includes generation bits above the slot index. */
+	g_wma_inj.next += offset;
+	desc_id = WMA_INJ_DESC_BASE | (g_wma_inj.next++ & 0x7fff);
+	dev_hold(dev);
+	g_wma_inj.slots[slot].nbuf = nbuf;
+	g_wma_inj.slots[slot].dev = dev;
+	g_wma_inj.slots[slot].desc_id = desc_id;
+	g_wma_inj.slots[slot].submitting = true;
+	g_wma_inj.slots[slot].done = false;
+	g_wma_inj.used++;
+	if (g_wma_inj.used == WMA_INJ_SLOTS)
+		netif_tx_stop_all_queues(dev);
+	spin_unlock_bh(&wma_inj_lock);
+
+	mgmt_params.tx_frame = nbuf;
+	mgmt_params.frm_len = frame_len;
+	mgmt_params.vdev_id = vdev_id;
+	mgmt_params.chanfreq = chanfreq;
+	mgmt_params.desc_id = desc_id;
+	mgmt_params.pdata = data;
+	mgmt_params.qdf_ctx = qdf_ctx;
+	/* This toggle only changes WMI flags, never the native monitor vdev. */
+	mgmt_params.tx_flags = (frame[0] == 0xc0 || frame[0] == 0xa0 ||
+				READ_ONCE(mon_tx_wrong_key)) ?
+		MGMT_TX_USE_INCORRECT_KEY : 0;
+
+	status = wmi_mgmt_unified_cmd_send(wma->wmi_handle, &mgmt_params);
+	spin_lock_bh(&wma_inj_lock);
+	g_wma_inj.slots[slot].submitting = false;
+	if (QDF_IS_STATUS_ERROR(status)) {
+		/* WMI rolls back its DMA mapping when send fails. */
+		wma_inject_release(wma, slot, false, 0);
+	} else {
+		g_wma_inj.submitted++;
+		if (wma_inj_should_log(g_wma_inj.submitted))
+			wma_info("NETHUNTER-INJ: [submit] #%u vdev=%u desc=%u chan=%u len=%u fc=0x%02x flags=%u",
+				 g_wma_inj.submitted, vdev_id, desc_id, chanfreq,
+				 frame_len, frame[0], mgmt_params.tx_flags);
+		if (g_wma_inj.slots[slot].done)
+			wma_inject_release(wma, slot, true,
