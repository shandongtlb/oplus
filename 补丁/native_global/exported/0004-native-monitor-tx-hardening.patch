+ puts("4096 malformed-header bounds probes passed");
+ memset(p,0,200);p[2]=8;p[8]=0x40;
+ linearize_error=-ENOMEM;check(p,32,0,-1);linearize_error=0;
+ sync_error=-EAGAIN;check(p,32,0,-1);sync_error=0;
+ test_adapter.deflink=NULL;check(p,32,0,-1);test_adapter.deflink=&link;
+ assert(sync_starts==sync_stops);
