+ memset(p,0,200);p[2]=25;fields=BIT(30)|BIT(31);memcpy(p+4,&fields,4);
+ fields=BIT(29)|BIT(31);memcpy(p+8,&fields,4);fields=BIT(1);memcpy(p+12,&fields,4);
+ p[16]=1;p[17]=2;p[18]=3;p[20]=2;p[22]=0xaa;p[23]=0xbb;
+ p[24]=0x10;p[25]=0x40;check(p,53,25,24);
