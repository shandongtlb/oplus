+struct ieee80211_radiotap_header {uint8_t it_version,it_pad;__le16 it_len;__le32 it_present;__le32 it_optional[];} __attribute__((packed));
+static uint16_t ieee80211_get_radiotap_len(const char *p) {return get_unaligned_le16(p+2);}
