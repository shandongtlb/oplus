+#!/usr/bin/env python3
+"""Exercise production admission/completion/close with a fault-injected WMI."""
+from pathlib import Path
+import subprocess
+import tempfile
+
+root = Path(__file__).resolve().parents[1]
+s = (root / 'core/wma/src/wma_mgmt.c').read_text()
+body = s[s.index('/* Native monitor management TX.'):s.index('/**\n * wma_process_mgmt_tx_completion()')]
+shim = r'''
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#define DEFINE_SPINLOCK(n) int n
+static void spin_lock_bh(int *p) {assert(!*p);*p=1;}
+static void spin_unlock_bh(int *p) {assert(*p);*p=0;}
+typedef int QDF_STATUS;
+enum {QDF_STATUS_SUCCESS, QDF_STATUS_E_INVAL, QDF_STATUS_E_AGAIN,
+      QDF_STATUS_E_NOMEM, QDF_STATUS_E_BUSY, QDF_STATUS_E_FAILURE};
+enum {QDF_MODULE_ID_WMA, QDF_MODULE_ID_QDF_DEVICE, QDF_GLOBAL_MONITOR_MODE=4,
+      WMI_VDEV_TYPE_MONITOR=3, QDF_DMA_TO_DEVICE, MGMT_TX_USE_INCORRECT_KEY=1};
+#define QDF_IS_STATUS_ERROR(s) ((s)!=0)
+struct net_device {int refs;bool stopped,running;};
+struct wma_txrx_node {void *vdev;bool vdev_active;int type;unsigned ch_freq;};
+struct wma_handle {unsigned max_bssid;struct wma_txrx_node interfaces[1];void *qdf_dev,*wmi_handle;};
+typedef struct wma_handle *tp_wma_handle;
+struct nbuf {uint8_t *data;unsigned len;bool mapped;};
+typedef struct nbuf *qdf_nbuf_t;
+struct wmi_mgmt_params {qdf_nbuf_t tx_frame;unsigned frm_len,vdev_id,chanfreq,desc_id,tx_flags;void *pdata,*qdf_ctx;};
+static struct wma_handle wma={1,{{(void *)1,true,WMI_VDEV_TYPE_MONITOR,5765}},(void *)1,(void *)1};
+static int mode=QDF_GLOBAL_MONITOR_MODE,refs,allocated,unmaps,sends;
+static bool early,fail,alloc_fail;
+static unsigned last_desc;
+static uint8_t captured[2048];
+static void *cds_get_context(int id) {return id==QDF_MODULE_ID_WMA?&wma:(void *)1;}
+static int cds_get_conparam(void) {return mode;}
+static int wma_validate_handle(tp_wma_handle p) {return !p;}
+#define THIS_MODULE NULL
+static bool try_module_get(void *m) {refs++;return true;}
+static void module_put(void *m) {assert(refs>0);refs--;}
+static void dev_hold(struct net_device *d) {d->refs++;}
+static void dev_put(struct net_device *d) {assert(d->refs>0);d->refs--;}
+static void netif_carrier_on(struct net_device *d) {}
+static bool netif_running(struct net_device *d) {return d->running;}
+static void netif_tx_stop_all_queues(struct net_device *d) {d->stopped=true;}
+static void netif_tx_wake_all_queues(struct net_device *d) {d->stopped=false;}
+static qdf_nbuf_t qdf_nbuf_alloc(void *p,unsigned n,int a,int b,bool c) {
+ if(alloc_fail)return NULL;
+ qdf_nbuf_t buf=calloc(1,sizeof(*buf));buf->data=malloc(n);buf->len=n;allocated++;return buf;
+}
+static uint8_t *qdf_nbuf_put_tail(qdf_nbuf_t p,unsigned n) {return p->data;}
+#define qdf_mem_copy memcpy
+static void qdf_nbuf_free(qdf_nbuf_t p) {assert(!p->mapped);allocated--;free(p->data);free(p);}
+static void qdf_nbuf_unmap_single(void *ctx,qdf_nbuf_t p,int dir) {assert(p->mapped);p->mapped=false;unmaps++;}
+static const char *wma_get_status_str(unsigned n) {return "status";}
+static void log_stub(const char *f,...) {}
+#define wma_err log_stub
+#define wma_info log_stub
+#define wma_err_rl log_stub
+static void wma_inject_handle_completion(tp_wma_handle,unsigned,unsigned);
+static QDF_STATUS wmi_mgmt_unified_cmd_send(void *w,struct wmi_mgmt_params *p) {
+ sends++;last_desc=p->desc_id;memcpy(captured,p->pdata,p->frm_len);
+ assert(p->tx_flags==MGMT_TX_USE_INCORRECT_KEY && p->chanfreq==5765 && p->vdev_id==0);
+ p->tx_frame->mapped=true;
+ if(early) {
+  int before=allocated;
+  wma_inject_handle_completion(&wma,p->desc_id,0);
+  assert(allocated==before && p->tx_frame->mapped); /* send still owns its view */
+ }
+ if(fail) {
+  assert(!early);qdf_nbuf_unmap_single(p->qdf_ctx,p->tx_frame,QDF_DMA_TO_DEVICE);
+  return QDF_STATUS_E_FAILURE;
+ }
+ return QDF_STATUS_SUCCESS;
+}
+'''
+tests = r'''
+int main(void) {
+ struct net_device dev={0,false,true};uint8_t frame[24]={0x40};
+ wma_inject_open();
+ assert(wma_inject_mon_frame(0,&dev,frame,24)==0);
+ unsigned old=last_desc;
+ assert(allocated==1 && refs==1 && dev.refs==1 && !memcmp(frame,captured,24));
+ wma_inject_handle_completion(&wma,last_desc,0);
+ assert(!allocated && !refs && !dev.refs && unmaps==1);
+ wma_inject_handle_completion(&wma,old,0);assert(g_wma_inj.stale==1 && !allocated);
+ /* A completion can run synchronously inside WMI send. */
+ early=true;assert(wma_inject_mon_frame(0,&dev,frame,24)==0);early=false;
+ assert(!allocated && !refs && !g_wma_inj.used && g_wma_inj.submitted==2 && g_wma_inj.completed==2);
+ /* Send failure has already unmapped; freeing must not unmap twice. */
+ fail=true;assert(wma_inject_mon_frame(0,&dev,frame,24)==QDF_STATUS_E_FAILURE);fail=false;
+ assert(!allocated && !refs && !g_wma_inj.used && !dev.refs && unmaps==3);
+ alloc_fail=true;assert(wma_inject_mon_frame(0,&dev,frame,24)==QDF_STATUS_E_NOMEM);alloc_fail=false;
+ int before=sends;frame[0]=0x08;assert(wma_inject_mon_frame(0,&dev,frame,24)==QDF_STATUS_E_INVAL);
+ frame[0]=0xd4;assert(wma_inject_mon_frame(0,&dev,frame,24)==QDF_STATUS_E_INVAL);frame[0]=0x40;
+ assert(wma_inject_mon_frame(0,&dev,frame,23)==QDF_STATUS_E_INVAL);
+ assert(wma_inject_mon_frame(1,&dev,frame,24)==QDF_STATUS_E_INVAL);
+ wma.interfaces[0].type=1;assert(wma_inject_mon_frame(0,&dev,frame,24)==QDF_STATUS_E_AGAIN);
+ wma.interfaces[0].type=WMI_VDEV_TYPE_MONITOR;wma.interfaces[0].ch_freq=0;
+ assert(wma_inject_mon_frame(0,&dev,frame,24)==QDF_STATUS_E_INVAL);wma.interfaces[0].ch_freq=5765;
+ mode=0;assert(wma_inject_mon_frame(0,&dev,frame,24)==QDF_STATUS_E_INVAL);mode=4;assert(sends==before);
+ /* Full ring stops TX; a free hole wakes and is usable immediately. */
+ unsigned ids[WMA_INJ_SLOTS];
+ for(unsigned i=0;i<WMA_INJ_SLOTS;i++){assert(wma_inject_mon_frame(0,&dev,frame,24)==0);ids[i]=last_desc;}
+ assert(dev.stopped && allocated==WMA_INJ_SLOTS && dev.refs==WMA_INJ_SLOTS);
+ wma_inject_resume(&dev);assert(dev.stopped);
+ assert(wma_inject_mon_frame(0,&dev,frame,24)==QDF_STATUS_E_BUSY);
+ assert(allocated==WMA_INJ_SLOTS && refs==WMA_INJ_SLOTS);
+ unsigned hole=13;
+ wma_inject_handle_completion(&wma,ids[hole],1);assert(!dev.stopped);
+ assert(wma_inject_mon_frame(0,&dev,frame,24)==0);assert(dev.stopped && last_desc!=ids[hole]);
+ unsigned stale=g_wma_inj.stale;
+ wma_inject_handle_completion(&wma,ids[hole],0);assert(g_wma_inj.stale==stale+1 && allocated==WMA_INJ_SLOTS);
+ ids[hole]=last_desc;
+ for(unsigned i=0;i<WMA_INJ_SLOTS;i++)wma_inject_handle_completion(&wma,ids[i],0);
+ assert(!allocated && !refs && !dev.refs && !dev.stopped);
+ dev.stopped=true;wma_inject_resume(&dev);assert(!dev.stopped);
+ wma_inject_close();wma_inject_open();assert(g_wma_inj.owner==&wma);
+ /* Down netdev must not be awakened by a completion. */
+ assert(wma_inject_mon_frame(0,&dev,frame,24)==0);dev.running=false;dev.stopped=true;
+ wma_inject_handle_completion(&wma,last_desc,0);assert(dev.stopped);dev.running=true;
+ /* Close with missing completion quarantines DMA, drops netdev references,
+    pins module, and rejects both new submits and late events after reopen. */
+ assert(wma_inject_mon_frame(0,&dev,frame,24)==0);old=last_desc;
+ wma_inject_close();assert(allocated==1 && refs==1 && !dev.refs && g_wma_inj.retired);
+ wma_inject_open();assert(wma_inject_mon_frame(0,&dev,frame,24)==QDF_STATUS_E_AGAIN);
+ wma_inject_handle_completion(&wma,old,0);assert(allocated==1 && refs==1);
+ wma_inject_close();assert(!dev.refs);
+ /* Test-only simulated power-off releases quarantine so LSan can check it. */
+ qdf_nbuf_t p=g_wma_inj.slots[old%WMA_INJ_SLOTS].nbuf;
+ qdf_nbuf_unmap_single(wma.qdf_dev,p,QDF_DMA_TO_DEVICE);qdf_nbuf_free(p);module_put(THIS_MODULE);
+ puts("Native TX admission, early/duplicate completion, DMA ownership, full-ring stop/wake and close quarantine passed");
+ return 0;
+}
+'''
