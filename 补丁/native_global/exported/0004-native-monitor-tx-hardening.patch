@@ -7319,86 +7319,82 @@ static const struct net_device_ops wlan_drv_ops = {
 };
 
 #ifdef FEATURE_MONITOR_MODE_SUPPORT
-/**
- * hdd_mon_hard_start_xmit() - TX entry for the global monitor interface (wlan0)
- * @skb: socket buffer from userspace (radiotap header + 802.11 frame)
- * @dev: monitor net_device
- *
- * NETHUNTER Phase 2 packet injection. Tools like aireplay-ng/airodump-ng send
- * radiotap-prefixed 802.11 frames out the global monitor netdev. We strip the
- * radiotap header and hand the raw 802.11 frame to the firmware via the WMI
- * mgmt-TX path on the monitor vdev (wma_inject_mon_frame()).
- *
- * Return: NETDEV_TX_OK when consumed; NETDEV_TX_BUSY when the private ring is full.
+/* ARPHRD_IEEE80211_RADIOTAP requires an explicit Radiotap header.
+ * Preserve packet bytes so a NETDEV_TX_BUSY retry parses the same frame.
  */
-static netdev_tx_t hdd_mon_hard_start_xmit(struct sk_buff *skb,
-					   struct net_device *dev)
+static bool hdd_mon_tx_frame(struct sk_buff *skb, uint8_t **frame,
+			     uint32_t *frame_len)
 {
-	struct hdd_adapter *adapter = WLAN_HDD_GET_PRIV_PTR(dev);
+	struct ieee80211_radiotap_iterator iter;
 	struct ieee80211_radiotap_header *rthdr;
-	static bool xmit_banner;
-	uint8_t *frame;
-	uint32_t frame_len;
-	uint16_t rtap_len = 0;
-	bool has_rtap = false;
-	QDF_STATUS status;
+	uint16_t rtap_len;
+	uint8_t flags = 0;
+	int ret;
 
-	if (cds_get_conparam() != QDF_GLOBAL_MONITOR_MODE) {
-		hdd_err_rl("NETHUNTER-INJ: global monitor mode is required");
-		goto drop;
-	}
+	if (skb->len < sizeof(*rthdr))
+		return false;
 
-	if (!adapter || adapter->magic != WLAN_HDD_ADAPTER_MAGIC || !skb) {
-		hdd_err_rl("NETHUNTER-INJ: [xmit] drop - bad adapter/skb");
-		goto drop;
-	}
+	rthdr = (struct ieee80211_radiotap_header *)skb->data;
+	rtap_len = ieee80211_get_radiotap_len((const char *)skb->data);
+	if (rtap_len < sizeof(*rthdr) || rtap_len > skb->len)
+		return false;
 
-	/* Need at least a minimal radiotap header or a short 802.11 control frame. */
-	if (skb->len < 10) {
-		hdd_err_rl("NETHUNTER-INJ: [xmit] drop - skb too short %u",
-			   skb->len);
-		goto drop;
-	}
+	ret = ieee80211_radiotap_iterator_init(&iter, rthdr, skb->len, NULL);
+	if (ret)
+		return false;
 
-	/*
-	 * Monitor TX is normally radiotap + 802.11, but accept a raw 802.11
-	 * frame too (some tools omit radiotap).
-	 */
-	if (skb->len >= sizeof(*rthdr)) {
-		rthdr = (struct ieee80211_radiotap_header *)skb->data;
-		if (rthdr->it_version == 0) {
-			rtap_len = ieee80211_get_radiotap_len(
-					(const char *)skb->data);
-			if (rtap_len >= sizeof(*rthdr) && rtap_len < skb->len)
-				has_rtap = true;
-		}
+	while (!(ret = ieee80211_radiotap_iterator_next(&iter))) {
+		/* Optional TX/RX metadata must not block standard tools. Only FCS
+		 * and DATAPAD describe byte layout here; firmware owns TX settings.
+		 * Unknown fields retain the iterator's skip/stop behavior.
+		 */
+		if (iter.is_radiotap_ns &&
+		    iter.this_arg_index == IEEE80211_RADIOTAP_FLAGS)
+			flags |= *iter.this_arg;
 	}
+	if (ret != -ENOENT || (flags & IEEE80211_RADIOTAP_F_DATAPAD))
+		return false;
 
-	if (has_rtap) {
-		frame = skb->data + rtap_len;
-		frame_len = skb->len - rtap_len;
-	} else {
-		frame = skb->data;
-		frame_len = skb->len;
+	*frame = skb->data + rtap_len;
+	*frame_len = skb->len - rtap_len;
+	if (flags & IEEE80211_RADIOTAP_F_FCS) {
+		if (*frame_len < FCS_LEN)
+			return false;
+		*frame_len -= FCS_LEN;
 	}
 
-	/* One-shot: confirms ndo_start_xmit is wired and userspace TX arrives. */
-	if (!xmit_banner) {
-		hdd_info("NETHUNTER-INJ: [xmit] path active dev=%s vdev=%u skb_len=%u radiotap=%u rtap_len=%u frame_len=%u",
-			 dev->name, adapter->deflink->vdev_id, skb->len, has_rtap,
-			 rtap_len, frame_len);
-		xmit_banner = true;
+	return *frame_len >= 10;
+}
