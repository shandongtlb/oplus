 				hdd_map_monitor_interface_vdev(sta_adapter);
 				break;
 			}
-			ret = hdd_start_station_adapter(adapter);
-			if (!ret)
-				ret = hdd_set_mon_rx_cb(adapter->dev);
-			if (!ret)
-				ret = wlan_hdd_set_mon_chan(adapter);
+			ret = hdd_restart_monitor_adapter(adapter);
 			if (ret) {
 				hdd_err("[SSR] Failed to restart monitor adapter: %d", ret);
 				hdd_adapter_dev_put_debug(adapter, dbgid);
@@ -16700,7 +16779,11 @@ int hdd_start_station_adapter(struct hdd_adapter *adapter)
 
 	hdd_adapter_reset_station_ctx(adapter);
 
-	hdd_register_wext(adapter->dev);
+	/* A monitor netdev already owns Radiotap/WEXT setup. Re-registering
+	 * station handlers here would overwrite it during SSR (without ndo_open).
+	 */
+	if (adapter->device_mode != QDF_MONITOR_MODE)
+		hdd_register_wext(adapter->dev);
 	hdd_set_netdev_flags(adapter);
 
 	hdd_register_tx_flow_control(adapter,
