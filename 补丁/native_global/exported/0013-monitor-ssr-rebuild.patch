 	wma_inject_destroy_tx_vdev();
 	hdd_adapter_for_each_active_link_info(adapter, link_info) {
@@ -11766,6 +11778,77 @@ static void hdd_delete_sta(struct hdd_adapter *adapter)
 }
 #endif
 
+#ifdef FEATURE_MONITOR_MODE_SUPPORT
+static int hdd_restart_monitor_adapter(struct hdd_adapter *adapter)
+{
+	struct hdd_context *hdd_ctx = WLAN_HDD_GET_CTX(adapter);
+	struct bbm_params param = {0};
+	const char *stage = "vdev";
+	QDF_STATUS status;
+	int ret;
+
+	if (hdd_get_conparam() != QDF_GLOBAL_MONITOR_MODE) {
+		ret = hdd_start_station_adapter(adapter);
+		if (!ret)
+			ret = hdd_set_mon_rx_cb(adapter->dev);
+		if (!ret)
+			ret = wlan_hdd_set_mon_chan(adapter);
+		return ret;
+	}
+
+	/* The SSR psoc transaction owns adapter/channel lifetime. Rebuild RX
+	 * before the post-recovery hook is allowed to recreate the TX helper.
+	 * DEVICE_IFACE_OPENED retains ownership even while IFF_UP is clear.
+	 */
+	adapter->monitor_ssr_ready = false;
+	adapter->monitor_mode_vdev_up_in_progress = false;
+	ret = hdd_start_station_adapter(adapter);
+	if (ret)
+		goto fail;
+
+	stage = "idle-ps";
+	status = hdd_set_idle_ps_config(hdd_ctx, false);
+	ret = qdf_status_to_os_return(status);
+	if (ret)
+		goto fail;
+	hdd_mon_turn_off_ps_and_wow(hdd_ctx);
+
+	stage = "rx-callback";
+	ret = hdd_set_mon_rx_cb(adapter->dev);
+	if (ret)
+		goto fail;
+	stage = "rx-enable";
+	ret = hdd_enable_monitor_mode(adapter->dev);
+	if (ret)
+		goto fail;
+	stage = "channel";
+	ret = wlan_hdd_set_mon_chan(adapter);
+	if (ret)
+		goto fail;
+
+	param.policy = BBM_DRIVER_MODE_POLICY;
+	param.policy_info.driver_mode = QDF_GLOBAL_MONITOR_MODE;
+	ucfg_dp_bbm_apply_independent_policy(hdd_ctx->psoc, &param);
+	ucfg_dp_set_current_throughput_level(hdd_ctx->psoc,
+					     PLD_BUS_WIDTH_VERY_HIGH);
+	adapter->monitor_ssr_ready = true;
+	hdd_info("[SSR] monitor RX and saved channel restored");
+	return 0;
+
+fail:
+	/* Keep queues stopped and TX restore gated. Normal mode exit still
+	 * owns teardown of any partially recreated vdev/monitor resources.
+	 */
+	hdd_err("[SSR] monitor restart failed at %s: %d", stage, ret);
+	return ret;
+}
+#else
+static int hdd_restart_monitor_adapter(struct hdd_adapter *adapter)
+{
+	return -EOPNOTSUPP;
+}
+#endif
