+/* Monitor WEXT compatibility follows sam's native-monitor-injection patch. */
+#ifdef CONFIG_WIRELESS_EXT
+static int hdd_mon_wext_giwname(struct net_device *dev,
+				struct iw_request_info *info,
+				union iwreq_data *wrqu, char *extra)
+{
+	strlcpy(wrqu->name, "IEEE 802.11", IFNAMSIZ);
+	return 0;
+}
+
+static int hdd_mon_wext_giwmode(struct net_device *dev,
+				struct iw_request_info *info,
+				union iwreq_data *wrqu, char *extra)
+{
+	wrqu->mode = IW_MODE_MONITOR;
+	return 0;
+}
+
+/*
+ * Aircrack-ng probes SIOCSIWMODE even on an existing monitor interface.
+ * Accept that idempotent request. Leaving global monitor mode must use the
+ * normal HDD mode transition instead of bypassing the firmware lifecycle.
+ */
+static int hdd_mon_wext_siwmode(struct net_device *dev,
+				struct iw_request_info *info,
+				union iwreq_data *wrqu, char *extra)
+{
+	if (wrqu->mode == IW_MODE_MONITOR)
+		return 0;
+
+	return -EOPNOTSUPP;
+}
+
+static int hdd_mon_wext_giwfreq(struct net_device *dev,
+				struct iw_request_info *info,
+				union iwreq_data *wrqu, char *extra)
+{
+	struct iw_freq *freq = &wrqu->freq;
+	struct wireless_dev *wdev = dev->ieee80211_ptr;
+	int freq_mhz, ret;
+
+	if (!wdev || !wdev->wiphy)
+		return -EOPNOTSUPP;
+	ret = wlan_hdd_mon_wext_get_freq(wdev->wiphy, &freq_mhz);
+	if (ret)
+		return ret;
+	freq->m = freq_mhz;
+	freq->e = 6;
+	freq->i = 0;
+	freq->flags = 0;
+	return 0;
+}
+
+static int hdd_mon_wext_siwfreq(struct net_device *dev,
+				struct iw_request_info *info,
+				union iwreq_data *wrqu, char *extra)
+{
+	struct iw_freq *f = &wrqu->freq;
+	struct wireless_dev *wdev = dev->ieee80211_ptr;
+	int freq_mhz;
+
+	if (!wdev || !wdev->wiphy)
+		return -EOPNOTSUPP;
+	if (f->m <= 0 || f->e < 0 || f->e > 6)
+		return -EINVAL;
+	if (f->e == 0) {
+		if (f->m > 196)
+			return -EINVAL;
+		freq_mhz = ieee80211_channel_to_frequency(f->m,
+				(f->m > 14) ? NL80211_BAND_5GHZ :
+					      NL80211_BAND_2GHZ);
+	} else {
+		int i, div = 1000000;
+
+		for (i = 0; i < f->e; i++)
+			div /= 10;
+		if (f->m % div)
+			return -EINVAL;
+		freq_mhz = f->m / div;
+	}
+	if (freq_mhz <= 0)
+		return -EINVAL;
+
+	return wlan_hdd_mon_wext_set_freq(wdev->wiphy, freq_mhz);
+}
+
+static int hdd_mon_wext_giwrange(struct net_device *dev,
+				 struct iw_request_info *info,
+				 union iwreq_data *wrqu, char *extra)
+{
+	struct iw_point *data = &wrqu->data;
+	struct wireless_dev *wdev = dev->ieee80211_ptr;
+	struct iw_range *range = (struct iw_range *)extra;
+	enum nl80211_band band;
+	int i, c = 0;
+
+	if (!wdev || !wdev->wiphy)
+		return -EOPNOTSUPP;
+	data->length = sizeof(struct iw_range);
+	memset(range, 0, sizeof(struct iw_range));
+	range->we_version_compiled = WIRELESS_EXT;
+	range->we_version_source = 21;
+	range->max_qual.level = (u8)-110;
+	range->max_qual.qual = 70;
+	range->max_qual.updated = IW_QUAL_DBM | IW_QUAL_QUAL_UPDATED |
+				  IW_QUAL_LEVEL_UPDATED;
+	range->avg_qual.level = range->max_qual.level / 2;
+	range->avg_qual.qual = 35;
+	range->avg_qual.updated = range->max_qual.updated;
+	for (band = 0; band < NUM_NL80211_BANDS; band++) {
+		struct ieee80211_supported_band *sband = wdev->wiphy->bands[band];
+
+		if (!sband)
+			continue;
+		for (i = 0; i < sband->n_channels &&
+		     c < IW_MAX_FREQUENCIES; i++) {
+			struct ieee80211_channel *chan = &sband->channels[i];
+
+			if (chan->flags & IEEE80211_CHAN_DISABLED)
+				continue;
+			range->freq[c].i =
+				ieee80211_frequency_to_channel(chan->center_freq);
+			range->freq[c].m = chan->center_freq;
+			range->freq[c].e = 6;
+			c++;
+		}
+	}
+	range->num_channels = c;
+	range->num_frequency = c;
+	return 0;
+}
+
+static const iw_handler hdd_mon_wext_std[] = {
+	IW_HANDLER(SIOCGIWNAME,  hdd_mon_wext_giwname),
+	IW_HANDLER(SIOCSIWMODE,  hdd_mon_wext_siwmode),
+	IW_HANDLER(SIOCSIWFREQ,  hdd_mon_wext_siwfreq),
+	IW_HANDLER(SIOCGIWFREQ,  hdd_mon_wext_giwfreq),
+	IW_HANDLER(SIOCGIWMODE,  hdd_mon_wext_giwmode),
+	IW_HANDLER(SIOCGIWRANGE, hdd_mon_wext_giwrange),
+};
+
+static const struct iw_handler_def hdd_mon_wext_handler_def = {
+	.standard = hdd_mon_wext_std,
+	.num_standard = ARRAY_SIZE(hdd_mon_wext_std),
+};
+#endif
+
 /**
  * hdd_mon_mode_ether_setup() - Update monitor mode struct net_device.
  * @dev: Handle to struct net_device to be updated.
@@ -3433,6 +3581,10 @@ static void hdd_mon_mode_ether_setup(struct net_device *dev)
 	dev->flags              = IFF_BROADCAST|IFF_MULTICAST;
 	dev->priv_flags        |= IFF_TX_SKB_SHARING;
 
+#ifdef CONFIG_WIRELESS_EXT
+	dev->wireless_handlers = &hdd_mon_wext_handler_def;
+#endif
+
 	memset(dev->broadcast, 0xFF, ETH_ALEN);
 }
 
@@ -3528,17 +3680,15 @@ static int __hdd_mon_open(struct net_device *dev)
 		ucfg_dp_set_current_throughput_level(hdd_ctx->psoc,
 						     PLD_BUS_WIDTH_VERY_HIGH);
 
-		/*
-		 * NETHUNTER injection: a monitor adapter never starts its netdev
-		 * Tx queues (only the STA/SAP connect paths call this), so frames
-		 * pushed via ndo_start_xmit (aireplay/raw socket) stay stuck in
-		 * the qdisc and never reach hdd_mon_hard_start_xmit. Turn carrier
-		 * on and start the Tx queues so the injection path can dispatch.
+		/* RX-only sockets must reach the drop path instead of building a
+		 * qdisc backlog. A concurrent channel transition keeps this gated.
 		 */
-		wlan_hdd_netif_queue_control(adapter,
-					    WLAN_START_ALL_NETIF_QUEUE_N_CARRIER,
-					    WLAN_CONTROL_PATH);
-		hdd_info("NETHUNTER-INJ: monitor Tx queues started for injection");
+		if (con_mode == QDF_GLOBAL_MONITOR_MODE)
+			wma_inject_resume(dev);
+		else
+			wlan_hdd_netif_queue_control(adapter,
+				WLAN_START_ALL_NETIF_QUEUE_N_CARRIER,
+				WLAN_CONTROL_PATH);
 	}
 
 	return ret;
