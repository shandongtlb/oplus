@@ -31598,6 +31647,74 @@ stop:
 }
 #endif
 
+int wlan_hdd_mon_wext_get_freq(struct wiphy *wiphy, int *freq_mhz)
+{
+#ifdef FEATURE_MONITOR_MODE_SUPPORT
+	struct osif_psoc_sync *psoc_sync;
+	struct hdd_adapter *adapter;
+	struct cfg80211_chan_def chandef = {0};
+	int ret;
+
+	/* Reuse peach's confirmed-channel getter under the same serialization
+	 * as sam's WEXT confirmation. Do not expose saved state mid-retune.
+	 */
+	ret = osif_psoc_sync_op_start(wiphy_dev(wiphy), &psoc_sync);
+	if (ret)
+		return ret;
+	if (!mutex_trylock(&hdd_mon_channel_lock)) {
+		ret = -EBUSY;
+		goto stop;
+	}
+	adapter = hdd_get_adapter(wiphy_priv(wiphy), QDF_MONITOR_MODE);
+	ret = adapter ? hdd_mon_get_chandef(wiphy, adapter, &chandef) : -ENODATA;
+	if (!ret)
+		*freq_mhz = chandef.chan->center_freq;
+	mutex_unlock(&hdd_mon_channel_lock);
+stop:
+	osif_psoc_sync_op_stop(psoc_sync);
+	return ret;
+#else
+	return -EOPNOTSUPP;
+#endif
+}
+
+int wlan_hdd_mon_wext_set_freq(struct wiphy *wiphy, int freq_mhz)
+{
+#ifdef FEATURE_MONITOR_MODE_SUPPORT
+	struct osif_psoc_sync *psoc_sync;
+	struct hdd_adapter *adapter;
+	struct hdd_monitor_ctx *mon_ctx;
+	int ret;
+
+	/* WEXT handlers run under RTNL, which must not cover firmware waits.
+	 * Preserve idempotent confirmation for legacy tools. Retuning must use
+	 * nl80211 (iw), whose set_monitor_channel path does not hold RTNL.
+	 */
+	ret = osif_psoc_sync_op_start(wiphy_dev(wiphy), &psoc_sync);
+	if (ret)
+		return ret;
+	if (!mutex_trylock(&hdd_mon_channel_lock)) {
+		ret = -EBUSY;
+		goto stop;
+	}
+	adapter = hdd_get_adapter(wiphy_priv(wiphy), QDF_MONITOR_MODE);
+	ret = -EOPNOTSUPP;
+	if (adapter && adapter->deflink &&
+	    !adapter->monitor_mode_vdev_up_in_progress &&
+	    adapter->deflink->vdev &&
+	    QDF_IS_STATUS_SUCCESS(wlan_vdev_is_up_active_state(adapter->deflink->vdev))) {
+		mon_ctx = WLAN_HDD_GET_MONITOR_CTX_PTR(adapter->deflink);
+		if (mon_ctx->freq == freq_mhz && mon_ctx->bandwidth == CH_WIDTH_20MHZ)
+			ret = 0;
+	}
+	mutex_unlock(&hdd_mon_channel_lock);
+stop:
+	osif_psoc_sync_op_stop(psoc_sync);
+	return ret;
+#else
+	return -EOPNOTSUPP;
+#endif
+}
 
 #define CNT_DIFF(cur, prev) \
 	((cur >= prev) ? (cur - prev) : (cur + (MAX_COUNT - (prev) + 1)))
