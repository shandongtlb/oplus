+++ b/vendor/qcom/opensource/wlan/qcacld-3.0/core/hdd/src/wlan_hdd_cfg80211.c
@@ -31,11 +31,13 @@
 #include <linux/init.h>
 #include <linux/etherdevice.h>
 #include <linux/wireless.h>
+#include <linux/rtnetlink.h>
 #include "osif_sync.h"
 #include <wlan_hdd_includes.h>
 #include <net/arp.h>
 #include <net/cfg80211.h>
 #include <net/mac80211.h>
+#include <net/sch_generic.h>
 #include <wlan_hdd_wowl.h>
 #include <ani_global.h>
 #include "sir_params.h"
@@ -31309,6 +31311,35 @@ int wlan_hdd_change_hw_mode_for_given_chnl(struct hdd_adapter *adapter,
  */
 static DEFINE_MUTEX(hdd_mon_channel_lock);
 
+/* The networking core resets both queued and already-dequeued/requeued skbs
+ * in dev_deactivate(). Keep its noop qdisc installed throughout retuning:
+ * incoming packets cannot survive to the new channel, including when the old
+ * channel was RX-only and had no WMA netdev reference. Carrier-off prevents
+ * linkwatch from reactivating it early. RTNL is never held over firmware work.
+ * nl80211 holds wiphy, so trylock instead of reversing the RTNL/wiphy order.
+ */
+static int hdd_mon_tx_transition_begin(struct hdd_adapter *adapter)
+{
+	if (!rtnl_trylock())
+		return -EBUSY;
+	wma_inject_set_host_blocked(true);
+	netif_carrier_off(adapter->dev);
+	netif_tx_disable(adapter->dev);
+	dev_deactivate(adapter->dev);
+	rtnl_unlock();
+	return 0;
+}
+
+static void hdd_mon_tx_transition_end(struct hdd_adapter *adapter)
+{
+	wma_inject_set_host_blocked(false);
+	/* Carrier-on lets linkwatch reactivate the empty qdisc under RTNL.
+	 * Until then the noop qdisc drops new traffic. In RX-only/failure states
+	 * the live qdisc drains to ndo_start_xmit, which rejects it immediately.
+	 */
+	wma_inject_resume(adapter->dev);
+}
+
 /**
  * __wlan_hdd_cfg80211_set_mon_ch() - Set monitor mode capture channel
  * @wiphy: Handle to struct wiphy to get handle to module context.
@@ -31454,24 +31485,37 @@ static int __wlan_hdd_cfg80211_set_mon_ch(struct wiphy *wiphy,
 		return -EBUSY;
 	}
 
-	/* Keep idempotent tuning; retry optional helper setup if it failed. */
+	/* Same-channel confirmation preserves an already-running helper/queue.
+	 * A failed helper setup retry still needs a fresh host queue boundary.
+	 */
 	if (!hdd_mon_get_chandef(wiphy, adapter, &current_chandef) &&
 	    hdd_mon_same_channel(&current_chandef, chandef)) {
-		if (ch_width == CH_WIDTH_20MHZ) {
-			status = wma_inject_ensure_tx_vdev(adapter->deflink->vdev_id,
-							 chandef->chan->center_freq);
-			if (QDF_IS_STATUS_ERROR(status))
-				return qdf_status_to_os_return(status);
+		if (ch_width != CH_WIDTH_20MHZ ||
+		    wma_inject_tx_ready(adapter->deflink->vdev_id,
+					chandef->chan->center_freq)) {
 			wma_inject_resume(adapter->dev);
+			return 0;
 		}
-		return 0;
+		ret = hdd_mon_tx_transition_begin(adapter);
+		if (ret)
+			return ret;
+		status = wma_inject_ensure_tx_vdev(adapter->deflink->vdev_id,
+						 chandef->chan->center_freq);
+		ret = qdf_status_to_os_return(status);
+		goto resume_tx;
 	}
 
+	ret = hdd_mon_tx_transition_begin(adapter);
+	if (ret)
+		return ret;
+
 	/* Quiesce injection on the old channel before changing hardware mode
 	 * or the monitor channel. The next ensure creates a confirmed helper. */
 	status = wma_inject_destroy_tx_vdev();
-	if (QDF_IS_STATUS_ERROR(status))
-		return qdf_status_to_os_return(status);
+	if (QDF_IS_STATUS_ERROR(status)) {
+		ret = qdf_status_to_os_return(status);
+		goto resume_tx;
+	}
 	if (policy_mgr_is_hw_mode_change_required_for_channel_switch(
 		hdd_ctx->psoc, adapter->deflink->vdev_id,
 		chandef->chan->center_freq,
@@ -31480,21 +31524,24 @@ static int __wlan_hdd_cfg80211_set_mon_ch(struct wiphy *wiphy,
 						   chandef->chan->center_freq,
 						   POLICY_MGR_UPDATE_REASON_SET_OPER_CHAN)) {
 			hdd_err("Failed to change hw mode");
-			return -EINVAL;
+			ret = -EINVAL;
+			goto resume_tx;
 		}
 	}
 
 	status = qdf_event_reset(&adapter->qdf_monitor_mode_vdev_up_event);
 	if (QDF_IS_STATUS_ERROR(status)) {
 		hdd_err_rl("failed to reinit monitor mode vdev up event");
-		return qdf_status_to_os_return(status);
+		ret = qdf_status_to_os_return(status);
+		goto resume_tx;
 	}
 	adapter->monitor_mode_vdev_up_in_progress = true;
 
 	req = qdf_mem_malloc(sizeof(struct channel_change_req));
 	if (!req) {
 		adapter->monitor_mode_vdev_up_in_progress = false;
-		return -ENOMEM;
+		ret = -ENOMEM;
+		goto resume_tx;
 	}
 
 	req->vdev_id = adapter->deflink->vdev_id;
@@ -31514,7 +31561,7 @@ static int __wlan_hdd_cfg80211_set_mon_ch(struct wiphy *wiphy,
 			   status);
 		adapter->monitor_mode_vdev_up_in_progress = false;
 		ret = qdf_status_to_os_return(status);
-		return ret;
+		goto resume_tx;
 	}
 
 	/* block on a completion variable until vdev up success*/
@@ -31537,7 +31584,8 @@ static int __wlan_hdd_cfg80211_set_mon_ch(struct wiphy *wiphy,
 				  status);
 
 		adapter->monitor_mode_vdev_up_in_progress = false;
-		return qdf_status_to_os_return(status);
+		ret = qdf_status_to_os_return(status);
+		goto resume_tx;
 	}
 
 	/* Save confirmed RX state even if the optional TX setup later fails. */
@@ -31548,19 +31596,20 @@ static int __wlan_hdd_cfg80211_set_mon_ch(struct wiphy *wiphy,
 		if (QDF_IS_STATUS_ERROR(status)) {
 			hdd_err("NETHUNTER-INJ: scheduler setup failed: %u", status);
 			adapter->monitor_mode_vdev_up_in_progress = false;
-			return qdf_status_to_os_return(status);
+			ret = qdf_status_to_os_return(status);
+			goto resume_tx;
 		}
 	} else {
 		hdd_info("NETHUNTER-INJ: %u MHz monitor channel is RX-only; TX helper remains disabled",
 			 wlan_reg_get_bw_value(ch_width));
 	}
 
-	wma_inject_resume(adapter->dev);
 	hdd_info("NETHUNTER-INJ: monitor channel ready; TX enabled only at 20 MHz");
-
+	ret = 0;
+resume_tx:
+	hdd_mon_tx_transition_end(adapter);
 	hdd_exit();
-
-	return 0;
+	return ret;
 }
 
