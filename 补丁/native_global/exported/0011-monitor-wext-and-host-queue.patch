+
+def function(signature):
+    start = src.index(signature)
+    end = src.index('{', start) + 1
+    depth = 1
+    while depth:
+        depth += (src[end] == '{') - (src[end] == '}')
+        end += 1
+    return src[start:end]
+
+shim = r'''
+#include <linux/wireless.h>
+#include <assert.h>
+#include <errno.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+typedef uint8_t u8;
+struct iw_request_info {int unused;};
+enum nl80211_band {NL80211_BAND_2GHZ,NL80211_BAND_5GHZ,NUM_NL80211_BANDS};
+#define IEEE80211_CHAN_DISABLED 1
+struct ieee80211_channel {int center_freq,flags;};
+struct ieee80211_supported_band {int n_channels;struct ieee80211_channel *channels;};
+struct wiphy {struct ieee80211_supported_band *bands[NUM_NL80211_BANDS];};
+struct wireless_dev {struct wiphy *wiphy;};
+struct net_device {struct wireless_dev *ieee80211_ptr;};
+static int confirmed_freq=2412,read_status,set_status,set_calls,last_freq;
+#define strlcpy(dst,src,n) snprintf(dst,n,"%s",src)
+static int ieee80211_channel_to_frequency(int c,int b) {
+ return b==NL80211_BAND_5GHZ ? 5000+5*c : (c==14 ? 2484 : 2407+5*c);
+}
+static int ieee80211_frequency_to_channel(int f) {
+ return f==2484 ? 14 : (f<3000 ? (f-2407)/5 : (f-5000)/5);
+}
+static int wlan_hdd_mon_wext_set_freq(struct wiphy *w,int f) {
+ last_freq=f;set_calls++;return set_status;
+}
+static int wlan_hdd_mon_wext_get_freq(struct wiphy *w,int *f) {
+ if(read_status)return read_status;*f=confirmed_freq;return 0;
+}
+'''
+tests = r'''
+int main(void) {
+ struct wiphy w={0};struct wireless_dev wd={&w};struct net_device dev={&wd};
+ union iwreq_data r={0};
+ assert(!hdd_mon_wext_giwname(&dev,NULL,&r,NULL));assert(!strcmp(r.name,"IEEE 802.11"));
+ assert(!hdd_mon_wext_giwmode(&dev,NULL,&r,NULL) && r.mode==IW_MODE_MONITOR);
+ assert(!hdd_mon_wext_siwmode(&dev,NULL,&r,NULL));r.mode=IW_MODE_INFRA;
+ assert(hdd_mon_wext_siwmode(&dev,NULL,&r,NULL)==-EOPNOTSUPP);
+ const int channels[]={1,6,11,36,149,161},freqs[]={2412,2437,2462,5180,5745,5805};
+ for(unsigned i=0;i<sizeof(channels)/sizeof(channels[0]);i++) {
+  r.freq.m=channels[i];r.freq.e=0;
+  assert(!hdd_mon_wext_siwfreq(&dev,NULL,&r,NULL) && last_freq==freqs[i]);
+  r.freq.m=freqs[i]*100000;r.freq.e=1;
+  assert(!hdd_mon_wext_siwfreq(&dev,NULL,&r,NULL) && last_freq==freqs[i]);
+  confirmed_freq=freqs[i];assert(!hdd_mon_wext_giwfreq(&dev,NULL,&r,NULL));
+  assert(r.freq.m==freqs[i] && r.freq.e==6);
+ }
+ int calls=set_calls;
+ const struct iw_freq invalid[]={{-1,0,0,0},{0,0,0,0},{INT32_MAX,0,0,0},
+  {2412,-1,0,0},{2412,7,0,0},{2412,32767,0,0},{241200001,1,0,0}};
+ for(unsigned i=0;i<sizeof(invalid)/sizeof(invalid[0]);i++) {
+  r.freq=invalid[i];assert(hdd_mon_wext_siwfreq(&dev,NULL,&r,NULL)==-EINVAL);
+ }
+ assert(calls==set_calls);
+ r.freq.m=2412;r.freq.e=6;set_status=-EBUSY;
+ assert(hdd_mon_wext_siwfreq(&dev,NULL,&r,NULL)==-EBUSY);
+ read_status=-EBUSY;assert(hdd_mon_wext_giwfreq(&dev,NULL,&r,NULL)==-EBUSY);
+ read_status=-ENODATA;assert(hdd_mon_wext_giwfreq(&dev,NULL,&r,NULL)==-ENODATA);
+ struct ieee80211_channel ch[40];for(int i=0;i<40;i++)ch[i]=(struct ieee80211_channel){5000+5*(i+32),0};
+ ch[0].flags=IEEE80211_CHAN_DISABLED;
+ struct ieee80211_supported_band band={40,ch};w.bands[NL80211_BAND_5GHZ]=&band;
+ struct {struct iw_range range;unsigned sentinel;} output={.sentinel=0x12345678};
+ assert(!hdd_mon_wext_giwrange(&dev,NULL,&r,(char *)&output.range));
+ assert(r.data.length==sizeof(output.range) && output.range.num_frequency==IW_MAX_FREQUENCIES);
+ assert(output.range.freq[0].m==5165 && output.range.freq[0].i==33 && output.sentinel==0x12345678);
+ dev.ieee80211_ptr=NULL;assert(hdd_mon_wext_giwfreq(&dev,NULL,&r,NULL)==-EOPNOTSUPP);
+ assert(hdd_mon_wext_siwfreq(&dev,NULL,&r,NULL)==-EOPNOTSUPP);
+ assert(hdd_mon_wext_giwrange(&dev,NULL,&r,(char *)&output.range)==-EOPNOTSUPP);
+ puts("WEXT mode/name, MHz/channel conversion, errors and bounded frequency range passed");
+}
+'''
+names = ['giwname', 'giwmode', 'siwmode', 'giwfreq', 'siwfreq', 'giwrange']
+source = shim + '\n'.join(function('static int hdd_mon_wext_' + name + '(') for name in names) + tests
+# Verify that the runtime setup actually publishes the tested handlers.
+assert 'dev->wireless_handlers = &hdd_mon_wext_handler_def;' in function('static void hdd_mon_mode_ether_setup(')
+with tempfile.TemporaryDirectory(prefix='monitor-wext-') as tmp:
+    c = Path(tmp) / 'test.c'
+    exe = Path(tmp) / 'test'
+    c.write_text(source)
+    subprocess.run(['cc', '-std=c11', '-Wall', '-Wextra', '-Werror',
+                    '-Wno-unused-parameter', '-Wno-misleading-indentation',
+                    '-fsanitize=address,undefined', str(c), '-o', str(exe)], check=True)
+    subprocess.run([str(exe)], check=True)
