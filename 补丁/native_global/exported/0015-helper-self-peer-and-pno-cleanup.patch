@@ -466,6 +467,25 @@ static QDF_STATUS inj_peer_command(tp_wma_handle wma, const uint8_t *addr,
 	return inj_wait(wma, status, kind);
 }
 
+static QDF_STATUS inj_create_self_peer(tp_wma_handle wma)
+{
+	QDF_STATUS status = inj_peer_command(wma, inj.mac, true, true);
+
+	if (QDF_IS_STATUS_ERROR(status))
+		return status;
+
+	/* A STA vdev may already have a firmware-owned self-peer. EXISTS
+	 * permits TX setup, but does not transfer ownership to the host.
+	 * Leave that peer to firmware vdev teardown, as the native STA path
+	 * does; only delete a self-peer whose creation we actually confirmed.
+	 * The lifecycle mutex excludes another control command here.
+	 */
+	spin_lock_bh(&inj_lock);
+	inj.self_peer = inj.response_status == 0;
+	spin_unlock_bh(&inj_lock);
+	return QDF_STATUS_SUCCESS;
+}
+
 static QDF_STATUS inj_start(tp_wma_handle wma, uint32_t freq, bool restart)
 {
 	struct vdev_start_params p = {0};
@@ -1082,10 +1102,9 @@ static QDF_STATUS inj_ensure_locked(uint8_t id, uint32_t freq)
 	if (QDF_IS_STATUS_ERROR(status))
 		goto fail;
 	inj.started = true;
-	status = inj_peer_command(wma, inj.mac, true, true);
+	status = inj_create_self_peer(wma);
 	if (QDF_IS_STATUS_ERROR(status))
 		goto fail;
-	inj.self_peer = true;
 	spin_lock_bh(&inj_lock);
 	inj.state = INJ_RUNNING;
 	inj_flow_update();
