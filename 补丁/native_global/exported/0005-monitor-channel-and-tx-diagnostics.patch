  * Return: 0 success or error code on failure.
  */
+static int hdd_mon_get_chandef(struct wiphy *wiphy,
+			       struct hdd_adapter *adapter,
+			       struct cfg80211_chan_def *chandef);
+
+/* 20 MHz legacy/HT requests share the same monitor tuning. */
+static bool hdd_mon_same_channel(const struct cfg80211_chan_def *a,
+				const struct cfg80211_chan_def *b)
+{
+	return a->chan == b->chan &&
+		hdd_map_nl_chan_width(a->width) == hdd_map_nl_chan_width(b->width) &&
+		a->center_freq1 == b->center_freq1 &&
+		a->center_freq2 == b->center_freq2;
+}
+
 static int __wlan_hdd_cfg80211_set_mon_ch(struct wiphy *wiphy,
 				       struct cfg80211_chan_def *chandef)
 {
@@ -31321,6 +31335,7 @@ static int __wlan_hdd_cfg80211_set_mon_ch(struct wiphy *wiphy,
 	struct qdf_mac_addr bssid;
 	struct channel_change_req *req;
 	struct ch_params ch_params = {0};
+	struct cfg80211_chan_def current = {0};
 	int ret;
 	enum channel_state chan_freq_state;
 	uint8_t max_fw_bw;
@@ -31374,6 +31389,18 @@ static int __wlan_hdd_cfg80211_set_mon_ch(struct wiphy *wiphy,
 		return -EINVAL;
 	}
 
+	if (adapter->monitor_mode_vdev_up_in_progress)
+		return -EBUSY;
+
+	/* Repeating a fixed channel must not restart the vdev and wait for
+	 * an UP event that firmware need not emit for a no-op restart.
+	 */
+	if (!hdd_mon_get_chandef(wiphy, adapter, &current) &&
+	    hdd_mon_same_channel(&current, chandef)) {
+		wma_inject_resume(adapter->dev);
+		return 0;
+	}
+
