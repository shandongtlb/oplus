-	mgmt_params.tx_flags = MGMT_TX_USE_INCORRECT_KEY;
+	/* This toggle only changes WMI flags, never the native monitor vdev. */
+	mgmt_params.tx_flags = READ_ONCE(mon_tx_wrong_key) ?
+		MGMT_TX_USE_INCORRECT_KEY : 0;
 
 	status = wmi_mgmt_unified_cmd_send(wma->wmi_handle, &mgmt_params);
 	spin_lock_bh(&wma_inj_lock);
@@ -3388,9 +3399,9 @@ QDF_STATUS wma_inject_mon_frame(uint8_t vdev_id, struct net_device *dev,
 	} else {
 		g_wma_inj.submitted++;
 		if (wma_inj_should_log(g_wma_inj.submitted))
-			wma_info("NETHUNTER-INJ: [submit] #%u vdev=%u desc=%u chan=%u len=%u fc=0x%02x",
+			wma_info("NETHUNTER-INJ: [submit] #%u vdev=%u desc=%u chan=%u len=%u fc=0x%02x flags=%u",
 				 g_wma_inj.submitted, vdev_id, desc_id, chanfreq,
-				 frame_len, frame[0]);
+				 frame_len, frame[0], mgmt_params.tx_flags);
 		if (g_wma_inj.slots[slot].done)
 			wma_inject_release(wma, slot, true,
 					   g_wma_inj.slots[slot].status);
diff --git a/vendor/qcom/opensource/wlan/qcacld-3.0/docs/peach-native-injection.md b/vendor/qcom/opensource/wlan/qcacld-3.0/docs/peach-native-injection.md
index 410cd700..3e278852 100644
--- a/vendor/qcom/opensource/wlan/qcacld-3.0/docs/peach-native-injection.md
+++ b/vendor/qcom/opensource/wlan/qcacld-3.0/docs/peach-native-injection.md
@@ -41,3 +41,16 @@ The first uses this kernel's real Radiotap iterator with ASan/UBSan. The second
 runs the production TX/complete/close code against a WMI stub with injected
 allocation/send failures, early/duplicate completions and missing completions.
 They validate host ownership and input handling, not RF or firmware behavior.
+
+Device investigation (2026-09-16): the installed v4 payload initially differed
+from the loaded qcacld Build ID. After explicit reload the v4 Build ID matched.
+The Kali chroot had no /sys mount: aircrack-ng 1.7 therefore missed the phy80211
+sysfs check and sent raw frames, which this Radiotap interface rejects. With
+/sys visible, broadcast probes reached WMI and the logged completions were
+DISCARD, not successful RF injection. The 5 GHz directed test also returned
+zero replies. Local outgoing tcpdump capture is not an independent RF capture.
+
+Monitor get_channel now reports the active vdev's channel, and repeating an
+identical tuning avoids the no-op restart that previously waited for an UP
+notification and timed out. The callback publishes its state before waking
+waiters. Run tests/test_monitor_channel.py for the channel reporting checks.
diff --git a/vendor/qcom/opensource/wlan/qcacld-3.0/tests/test_monitor_channel.py b/vendor/qcom/opensource/wlan/qcacld-3.0/tests/test_monitor_channel.py
new file mode 100644
index 00000000..bedd78c7
--- /dev/null
+++ b/vendor/qcom/opensource/wlan/qcacld-3.0/tests/test_monitor_channel.py
@@ -0,0 +1,59 @@
+#!/usr/bin/env python3
+"""Check live monitor channel reporting and repeated 20 MHz tuning."""
+from pathlib import Path
+import subprocess, tempfile
+r=Path(__file__).resolve().parents[1]
+s=(r/'core/hdd/src/wlan_hdd_cfg80211.c').read_text()
+def function(marker):
+    start=s.rindex(marker); end=s.index('\n}',start)+2
+    return s[start:end]
+shim=r'''
+#include <assert.h>
+#include <stdbool.h>
+#include <errno.h>
+#include <stdio.h>
+#define WLAN_OSIF_ID 1
+#define QDF_IS_STATUS_SUCCESS(x) ((x)==0)
+struct wiphy {int unused;};
+struct channel {unsigned freq;};
+struct cfg80211_chan_def {struct channel *chan; unsigned width,center_freq1,center_freq2;};
+struct wlan_objmgr_vdev {int unused;};
+struct wlan_channel {unsigned ch_freq,ch_cfreq1,ch_cfreq2,ch_width;};
+struct hdd_adapter {void *deflink; bool monitor_mode_vdev_up_in_progress;};
+static struct wlan_objmgr_vdev vdev;
+static struct wlan_channel desired={5765,5765,0,20};
+static struct channel chan={5765};
+static int refs; static bool absent,down,missing;
+static unsigned hdd_map_nl_chan_width(unsigned w) {return w==21?20:w;}
+static struct wlan_objmgr_vdev *hdd_objmgr_get_vdev_by_user(void *p,int id) {if(absent)return NULL;refs++;return &vdev;}
+static void hdd_objmgr_put_vdev_by_user(void *p,int id) {assert(refs==1);refs--;}
+static int wlan_vdev_is_up_active_state(void *p) {return down;}
+static struct wlan_channel *wlan_vdev_mlme_get_des_chan(void *p) {return missing?NULL:&desired;}
+static struct channel *ieee80211_get_channel(void *p,unsigned f) {return f==5765?&chan:NULL;}
+static void wlan_hdd_update_chandef(struct cfg80211_chan_def *c,unsigned w,unsigned f,bool legacy) {c->width=w;c->center_freq2=f;}
+static bool cfg80211_chandef_valid(struct cfg80211_chan_def *c) {return c->chan && c->center_freq1!=0;}
+'''
+test=r'''
+int main(void) {
+ struct wiphy w={0};struct hdd_adapter a={(void *)1,false};struct cfg80211_chan_def c={0};
+ assert(!hdd_mon_get_chandef(&w,&a,&c) && !refs && c.chan==&chan && c.width==20 && c.center_freq1==5765);
+ struct cfg80211_chan_def req=c;assert(hdd_mon_same_channel(&req,&c));
+ req.width=21;assert(hdd_mon_same_channel(&req,&c));
+ req.width=40;assert(!hdd_mon_same_channel(&req,&c));
+ req=c;req.center_freq1+=10;assert(!hdd_mon_same_channel(&req,&c));
+ req=c;req.center_freq2=5530;assert(!hdd_mon_same_channel(&req,&c));
+ req=c;req.chan=NULL;assert(!hdd_mon_same_channel(&req,&c));
+ a.monitor_mode_vdev_up_in_progress=true;assert(hdd_mon_get_chandef(&w,&a,&c)==-ENODATA && !refs);a.monitor_mode_vdev_up_in_progress=false;
+ down=true;assert(hdd_mon_get_chandef(&w,&a,&c)==-ENODATA && !refs);down=false;
+ missing=true;assert(hdd_mon_get_chandef(&w,&a,&c)==-ENODATA && !refs);missing=false;
+ absent=true;assert(hdd_mon_get_chandef(&w,&a,&c)==-ENODATA && !refs);absent=false;
+ desired.ch_freq=0;assert(hdd_mon_get_chandef(&w,&a,&c)==-ENODATA && !refs);
+ desired.ch_freq=1000;assert(hdd_mon_get_chandef(&w,&a,&c)==-ENODATA && !refs);
+ desired.ch_freq=5765;desired.ch_cfreq1=0;assert(hdd_mon_get_chandef(&w,&a,&c)==-ENODATA && !refs);
+ puts("Monitor channel reporting, inactive/missing vdev, reference release and retune comparisons passed");
+}
+'''
+with tempfile.TemporaryDirectory() as tmp:
+    p=Path(tmp);(p/'test.c').write_text(shim+function('static bool hdd_mon_same_channel(')+function('static int hdd_mon_get_chandef(')+test)
+    subprocess.run(['cc','-Wall','-Wextra','-Werror','-Wno-unused-parameter','-fsanitize=address,undefined',str(p/'test.c'),'-o',str(p/'test')],check=True)
+    subprocess.run([str(p/'test')],check=True)
diff --git a/vendor/qcom/opensource/wlan/qcacld-3.0/tests/test_native_injection.py b/vendor/qcom/opensource/wlan/qcacld-3.0/tests/test_native_injection.py
