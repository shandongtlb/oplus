 	if (WLAN_REG_IS_24GHZ_CH_FREQ(chandef->chan->center_freq) &&
@@ -32881,6 +32908,39 @@ wlan_hdd_cfg80211_get_channel_sta(struct wiphy *wiphy,
 	return ret;
 }
 
+#ifdef FEATURE_MONITOR_MODE_SUPPORT
+static int hdd_mon_get_chandef(struct wiphy *wiphy,
+			       struct hdd_adapter *adapter,
+			       struct cfg80211_chan_def *chandef)
+{
+	struct wlan_objmgr_vdev *vdev;
+	struct wlan_channel *channel;
+	int ret = -ENODATA;
+
+	if (!adapter->deflink || adapter->monitor_mode_vdev_up_in_progress)
+		return -ENODATA;
+	vdev = hdd_objmgr_get_vdev_by_user(adapter->deflink, WLAN_OSIF_ID);
+	if (!vdev)
+		return -ENODATA;
+	if (!QDF_IS_STATUS_SUCCESS(wlan_vdev_is_up_active_state(vdev)))
+		goto out;
+	channel = wlan_vdev_mlme_get_des_chan(vdev);
+	if (!channel || !channel->ch_freq)
+		goto out;
+	chandef->chan = ieee80211_get_channel(wiphy, channel->ch_freq);
+	if (!chandef->chan)
+		goto out;
+	chandef->center_freq1 = channel->ch_cfreq1;
+	chandef->center_freq2 = 0;
+	wlan_hdd_update_chandef(chandef, channel->ch_width,
+				channel->ch_cfreq2, false);
+	ret = cfg80211_chandef_valid(chandef) ? 0 : -ENODATA;
+out:
+	hdd_objmgr_put_vdev_by_user(vdev, WLAN_OSIF_ID);
+	return ret;
+}
+#endif
+
 static int __wlan_hdd_cfg80211_get_channel(struct wiphy *wiphy,
 					   struct wireless_dev *wdev,
 					   struct cfg80211_chan_def *chandef,
@@ -32904,6 +32964,10 @@ static int __wlan_hdd_cfg80211_get_channel(struct wiphy *wiphy,
 	hdd_reg_wait_for_country_change(hdd_ctx);
 
 	switch (adapter->device_mode) {
+#ifdef FEATURE_MONITOR_MODE_SUPPORT
+	case QDF_MONITOR_MODE:
+		return hdd_mon_get_chandef(wiphy, adapter, chandef);
+#endif
 	case QDF_SAP_MODE:
 	case QDF_P2P_GO_MODE:
 		ret = wlan_hdd_cfg80211_get_channel_sap(wiphy, chandef,
