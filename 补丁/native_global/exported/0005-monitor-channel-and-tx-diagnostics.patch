@@ -33,7 +36,7 @@ struct wmi_mgmt_params {qdf_nbuf_t tx_frame;unsigned frm_len,vdev_id,chanfreq,de
 static struct wma_handle wma={1,{{(void *)1,true,WMI_VDEV_TYPE_MONITOR,5765}},(void *)1,(void *)1};
 static int mode=QDF_GLOBAL_MONITOR_MODE,refs,allocated,unmaps,sends;
 static bool early,fail,alloc_fail;
-static unsigned last_desc;
+static unsigned last_desc,expected_flags;
 static uint8_t captured[2048];
 static void *cds_get_context(int id) {return id==QDF_MODULE_ID_WMA?&wma:(void *)1;}
 static int cds_get_conparam(void) {return mode;}
@@ -63,7 +66,7 @@ static void log_stub(const char *f,...) {}
 static void wma_inject_handle_completion(tp_wma_handle,unsigned,unsigned);
 static QDF_STATUS wmi_mgmt_unified_cmd_send(void *w,struct wmi_mgmt_params *p) {
  sends++;last_desc=p->desc_id;memcpy(captured,p->pdata,p->frm_len);
- assert(p->tx_flags==MGMT_TX_USE_INCORRECT_KEY && p->chanfreq==5765 && p->vdev_id==0);
+ assert(p->tx_flags==expected_flags && p->chanfreq==5765 && p->vdev_id==0);
  p->tx_frame->mapped=true;
  if(early) {
   int before=allocated;
@@ -86,8 +89,10 @@ int main(void) {
  assert(allocated==1 && refs==1 && dev.refs==1 && !memcmp(frame,captured,24));
  wma_inject_handle_completion(&wma,last_desc,0);
  assert(!allocated && !refs && !dev.refs && unmaps==1);
+
  wma_inject_handle_completion(&wma,old,0);assert(g_wma_inj.stale==1 && !allocated);
  /* A completion can run synchronously inside WMI send. */
+ mon_tx_wrong_key=true;expected_flags=MGMT_TX_USE_INCORRECT_KEY;
  early=true;assert(wma_inject_mon_frame(0,&dev,frame,24)==0);early=false;
  assert(!allocated && !refs && !g_wma_inj.used && g_wma_inj.submitted==2 && g_wma_inj.completed==2);
  /* Send failure has already unmapped; freeing must not unmap twice. */
