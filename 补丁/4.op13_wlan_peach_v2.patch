--- a/kernel_platform/build/kernel/android/prepare_vendor.sh
+++ b/kernel_platform/build/kernel/android/prepare_vendor.sh
@@ -582,6 +582,82 @@
 
   ################################################################################
   echo
+  echo "  Building WLAN platform modules"
+  echo "kpl-time-check Building WLAN platform start $(date +%H:%M:%S)"
+  (
+    cd ${ROOT_DIR}
+    set -x
+    OUT_DIR=${ANDROID_EXT_MODULES_OUT} \
+    KERNEL_KIT=${ANDROID_KERNEL_OUT} \
+    TARGET_BOARD_PLATFORM=${KERNEL_TARGET} \
+    ENABLE_DDK_BUILD=true \
+    EXT_MODULES="${KP_TO_ANDROID}/vendor/qcom/opensource/wlan/platform" \
+    ./build/build_module.sh modules
+    set +x
+  )
+  echo "kpl-time-check Building WLAN platform end $(date +%H:%M:%S)"
+
+  ################################################################################
+  echo
+  echo "  Building WLAN qcacld modules"
+  echo "kpl-time-check Building WLAN qcacld start $(date +%H:%M:%S)"
+  (
+    cd ${ROOT_DIR}
+    set -x
+    OUT_DIR=${ANDROID_EXT_MODULES_OUT} \
+    KERNEL_KIT=${ANDROID_KERNEL_OUT} \
+    KBUILD_EXTRA_SYMBOLS=${ANDROID_EXT_MODULES_COMMON_OUT}/vendor/qcom/opensource/wlan/platform/Module.symvers \
+    TARGET_BOARD_PLATFORM=${KERNEL_TARGET} \
+    ENABLE_DDK_BUILD=true \
+    SUBTARGET_REGEX=all_modules \
+    EXT_MODULES="${KP_TO_ANDROID}/vendor/qcom/opensource/wlan/qcacld-3.0" \
+    ./build/build_module.sh modules
+    set +x
+  )
+  echo "kpl-time-check Building WLAN qcacld end $(date +%H:%M:%S)"
+
+  ################################################################################
+  echo
+  echo "  Installing WLAN modules into vendor_dlkm"
+  echo "kpl-time-check Installing WLAN modules start $(date +%H:%M:%S)"
+  mkdir -p ${ANDROID_KERNEL_OUT}/vendor_dlkm
+
+  WLAN_PLATFORM_KOS="cnss2.ko icnss2.ko cnss_nl.ko cnss_plat_ipc_qmi_svc.ko cnss_prealloc.ko cnss_utils.ko wlan_firmware_service.ko"
+  WLAN_QCACLD_KOS="qca_cld3_peach_v2.ko"
+
+  find ${ANDROID_KP_OUT_DIR}/dist -maxdepth 1 -type f -name 'qca_cld3_*.ko' -delete
+  find ${ANDROID_KERNEL_OUT}/vendor_dlkm -maxdepth 1 -type f -name 'qca_cld3_*.ko' -delete
+
+  for ko in ${WLAN_PLATFORM_KOS}; do
+    src=${ANDROID_EXT_MODULES_COMMON_OUT}/vendor/qcom/opensource/wlan/platform/${ko}
+    if [ -f "${src}" ]; then
+      cp "${src}" ${ANDROID_KP_OUT_DIR}/dist/
+      cp "${src}" ${ANDROID_KERNEL_OUT}/vendor_dlkm/
+    fi
+  done
+
+  for ko in ${WLAN_QCACLD_KOS}; do
+    src=${ANDROID_EXT_MODULES_COMMON_OUT}/vendor/qcom/opensource/wlan/qcacld-3.0/${ko}
+    if [ -f "${src}" ]; then
+      cp "${src}" ${ANDROID_KP_OUT_DIR}/dist/
+      cp "${src}" ${ANDROID_KERNEL_OUT}/vendor_dlkm/
+    fi
+  done
+
+  if [ -f ${ANDROID_KP_OUT_DIR}/dist/vendor_dlkm.modules.load ]; then
+    grep -v 'vendor/qcom/opensource/wlan/qcacld-3.0/qca_cld3_' \
+      ${ANDROID_KP_OUT_DIR}/dist/vendor_dlkm.modules.load > \
+      ${ANDROID_KP_OUT_DIR}/dist/vendor_dlkm.modules.load.tmp
+    mv ${ANDROID_KP_OUT_DIR}/dist/vendor_dlkm.modules.load.tmp \
+      ${ANDROID_KP_OUT_DIR}/dist/vendor_dlkm.modules.load
+  fi
+
+  cat >> ${ANDROID_KP_OUT_DIR}/dist/vendor_dlkm.modules.load <<'EOF'
+vendor/qcom/opensource/wlan/platform/cnss2.ko
+vendor/qcom/opensource/wlan/platform/icnss2.ko
+vendor/qcom/opensource/wlan/platform/cnss_nl.ko
+vendor/qcom/opensource/wlan/platform/cnss_plat_ipc_qmi_svc.ko
+vendor/qcom/opensource/wlan/platform/cnss_prealloc.ko
+vendor/qcom/opensource/wlan/platform/cnss_utils.ko
+vendor/qcom/opensource/wlan/platform/wlan_firmware_service.ko
+vendor/qcom/opensource/wlan/qcacld-3.0/qca_cld3_peach_v2.ko
+EOF
+  sort -u ${ANDROID_KP_OUT_DIR}/dist/vendor_dlkm.modules.load -o ${ANDROID_KP_OUT_DIR}/dist/vendor_dlkm.modules.load
+  cp ${ANDROID_KP_OUT_DIR}/dist/vendor_dlkm.modules.load ${ANDROID_KERNEL_OUT}/vendor_dlkm/modules.load
+
+  echo "kpl-time-check Installing WLAN modules end $(date +%H:%M:%S)"
+
+  ################################################################################
+  echo
   if [ "${RECOMPILE_TECHPACK_DTBO}" != "0" ]; then
     echo "  Compiling vendor devicetree overlays"
     echo "kpl-time-check Compiling vendor devicetree start $(date +%H:%M:%S)"
