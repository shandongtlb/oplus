#!/system/bin/sh
# monstart [freq_MHz]   e.g. monstart 5745  (ch149)
# Enter monitor mode. Injection TX helper vdev is auto-created by the driver
# when the channel is set (grep dmesg for NETHUNTER-INJ).
#
# PREREQ: no active Wi-Fi Direct / P2P. The phone->tablet "network sharing" /
# cross-device interconnect / screen-cast hold a P2P group that the driver
# policy blocks monitor mode against. Turn those OFF first.

PHY=$(cat /sys/class/net/wlan0/phy80211/name 2>/dev/null)
[ -z "$PHY" ] && PHY=phy$(iw dev wlan0 info 2>/dev/null | awk '/wiphy/{print $2}')
[ -z "$PHY" ] && { echo "[monstart] cannot find wlan0 phy (driver loaded?)"; exit 1; }
echo "[monstart] using $PHY"

# drop any stale monitor iface
iw dev wlan0mon del 2>/dev/null

svc wifi disable
sleep 2
# stop framework PNO scans that would reap wlan0mon while idle
settings put global wifi_scan_always_enabled 0
cmd wifi set-scan-always-available disabled >/dev/null 2>&1 || true
ip link set wlan0 down 2>/dev/null || true

ADDOUT=$(iw "$PHY" interface add wlan0mon type monitor 2>&1)
if [ $? -ne 0 ] || ! iw dev wlan0mon info >/dev/null 2>&1; then
  echo "[monstart] FAILED to add monitor interface: $ADDOUT"
  if dmesg 2>/dev/null | tail -60 | grep -q "P2P CLIENT concurrency"; then
    echo "[monstart] >>> 原因: 有活跃的 P2P / Wi-Fi Direct 占用, 驱动策略禁止开监听."
    echo "[monstart] >>> 请关闭 [手机->平板 网络共享 / 跨设备互联 / 投屏], 再重试 monstart."
  fi
  # restore normal wifi so the phone is not left in a half state
  settings put global wifi_scan_always_enabled 1
  cmd wifi set-scan-always-available enabled >/dev/null 2>&1 || true
  svc wifi enable
  exit 1
fi

ip link set wlan0mon up
if [ -n "$1" ]; then
  iw dev wlan0mon set freq "$1" || echo "[monstart] warn: set freq $1 failed"
fi
echo "---- wlan0mon ----"
iw dev wlan0mon info | grep -E "Interface|type|channel|addr" || true
echo "[monstart] OK"
echo "  capture : airodump-ng wlan0mon   /   tcpdump -i wlan0mon"
echo "  inject  : helper TX vdev auto-created on this channel (dmesg | grep NETHUNTER-INJ)"
